#. TRANSLATORS: (Mars); From albedo feature at 30N, 200W.
#: data/nomenclature.fab:5596
msgctxt "catena"
msgid "Stygis Catena"
msgstr "スティギス連鎖クレーター"

#: data/nomenclature.fab:5596
msgctxt "origin"
msgid "From albedo feature at 30N, 200W."
msgstr "北緯30度、西経200度にあるアルベド地形による。"

#. TRANSLATORS: (Mars); Classical albedo feature name.
#: data/nomenclature.fab:5598
msgctxt "catena"
msgid "Tractus Catena"
msgstr "トラクトス連鎖クレーター"

