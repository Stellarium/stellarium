#. TRANSLATORS: (Mars); Albedo feature name.
#: data/nomenclature.fab:5606
msgctxt "catena"
msgid "Elysium Catena"
msgstr "エリシウム連鎖クレーター"

#. TRANSLATORS: (Mars); Named for classical albedo feature at 54N, 137W.
#: data/nomenclature.fab:5608
msgctxt "catena"
