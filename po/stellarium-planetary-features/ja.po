#. TRANSLATORS: (Amalthea); Greek; goat-god, son of Amalthea and Hermes in
#. some legends, also Zeus' foster brother.
#: data/nomenclature.fab:18
msgctxt "crater"
msgid "Pan"
msgstr "パン"

#: data/nomenclature.fab:18
msgctxt "origin"
msgid ""
"Greek; goat-god, son of Amalthea and Hermes in some legends, also Zeus' "
"foster brother."
msgstr "ギリシャ神話; ヤギの神、いくつかの伝説ではアマルテアとヘルメスの息子、またゼウスの養兄弟。"

#. TRANSLATORS: (Amalthea); Greek mother earth goddess who brought Zeus to
#. Crete.
#: data/nomenclature.fab:20
msgctxt "crater"
msgid "Gaea"
msgstr "ガイア"

#: data/nomenclature.fab:20
msgctxt "origin"
msgid "Greek mother earth goddess who brought Zeus to Crete."
msgstr "ゼウスをクレタ島に連れてきたギリシャの母なる大地の女神。"

#. TRANSLATORS: (Amalthea); Greek; mountain where Zeus played as a child.
#: data/nomenclature.fab:22
msgctxt "facula"
msgid "Ida Facula"
msgstr "イダ白斑"

#: data/nomenclature.fab:22
msgctxt "origin"
msgid "Greek; mountain where Zeus played as a child."
msgstr "ギリシャ神話; ゼウスが子供の頃に遊んだ山。"

#. TRANSLATORS: (Amalthea); Greek; area in Crete where Zeus was raised.
#: data/nomenclature.fab:24
msgctxt "facula"
msgid "Lyctos Facula"
msgstr "リュクトス白斑"

#: data/nomenclature.fab:24
msgctxt "origin"
msgid "Greek; area in Crete where Zeus was raised."
msgstr "ギリシャ神話; ゼウスが育てられたクレタ島の地域。"

#. TRANSLATORS: (Ariel); Spirit in Spenser's "Fairy Queene."
#: data/nomenclature.fab:26
msgctxt "crater"
msgid "Agape"
msgstr "アガペー"

#: data/nomenclature.fab:26
msgctxt "origin"
msgid "Spirit in Spenser's “Fairy Queene.”"
msgstr "スペンサーの「妖精の女王」に登場する精霊。"

#. TRANSLATORS: (Ariel); Good spirit in Maeterlinck's "The Bluebird."
#: data/nomenclature.fab:28
msgctxt "crater"
msgid "Berylune"
msgstr "ベリルネ"

#: data/nomenclature.fab:28
msgctxt "origin"
msgid "Good spirit in Maeterlinck's “The Bluebird.”"
msgstr "メーテルリンクの「青い鳥」に登場する良い妖精。"

#. TRANSLATORS: (Ariel); Spirit of the iron mines.
#: data/nomenclature.fab:30
msgctxt "crater"
msgid "Abans"
msgstr "アバンス"

#: data/nomenclature.fab:30
msgctxt "origin"
msgid "Spirit of the iron mines."
msgstr "鉄鉱石の精霊。"

#. TRANSLATORS: (Ariel); Eskimo benevolent spirit.
#: data/nomenclature.fab:32
msgctxt "crater"
msgid "Ataksak"
msgstr "アタクサク"

#: data/nomenclature.fab:32
msgctxt "origin"
msgid "Eskimo benevolent spirit."
msgstr "エスキモーの慈悲深い精霊。"

#. TRANSLATORS: (Ariel); Spirit of beautiful maiden.
#: data/nomenclature.fab:34
msgctxt "crater"
msgid "Deive"
msgstr "ディーヴェ"

#: data/nomenclature.fab:34
msgctxt "origin"
msgid "Spirit of beautiful maiden."
msgstr "美しい乙女の精霊。"

#. TRANSLATORS: (Ariel); Czech ancestral benevolent spirit and household
#. guardian.
#: data/nomenclature.fab:36
msgctxt "crater"
msgid "Djadek"
msgstr "ドジャデク"

#: data/nomenclature.fab:36
msgctxt "origin"
msgid "Czech ancestral benevolent spirit and household guardian."
msgstr "チェコ人の祖先である慈悲深い精霊、家の守護者。"

#. TRANSLATORS: (Ariel); Slavic spirit protector of home.
#: data/nomenclature.fab:38
msgctxt "crater"
msgid "Domovoy"
msgstr "ドモヴォーイ"

#: data/nomenclature.fab:38
msgctxt "origin"
msgid "Slavic spirit protector of home."
msgstr "スラブ人の家を守る精霊。"

#. TRANSLATORS: (Ariel); Irish king of spirits; provided horses and wine to
#. men.
#: data/nomenclature.fab:40
msgctxt "crater"
msgid "Finvara"
msgstr "フィンヴァラ"

#: data/nomenclature.fab:40
msgctxt "origin"
msgid "Irish king of spirits; provided horses and wine to men."
msgstr "アイルランドの精霊王。男たちに馬とワインを提供した。"

#. TRANSLATORS: (Ariel); Replaced Oberon as King of Spirits when Oberon died.
#: data/nomenclature.fab:42
msgctxt "crater"
msgid "Huon"
msgstr "ユオン"

#: data/nomenclature.fab:42
msgctxt "origin"
msgid "Replaced Oberon as King of Spirits when Oberon died."
msgstr "オベロンの死後、オベロンに代わって精霊の王となった。"

#. TRANSLATORS: (Ariel); Irish god of battle; leads mens' souls to Annwn.
#: data/nomenclature.fab:44
msgctxt "crater"
msgid "Gwyn"
msgstr "グウィン"

#: data/nomenclature.fab:44
msgctxt "origin"
msgid "Irish god of battle; leads mens' souls to Annwn."
msgstr "アイルランドの戦いの神。人々の魂をアンヌンへと導く。"

#. TRANSLATORS: (Ariel); Inca good spirit.
#: data/nomenclature.fab:46
msgctxt "crater"
msgid "Laica"
msgstr "ライカ"

#: data/nomenclature.fab:46
msgctxt "origin"
msgid "Inca good spirit."
msgstr "インカの良い精霊。"

#. TRANSLATORS: (Ariel); Queen of Spirits, dethroned Titania.
#: data/nomenclature.fab:48
msgctxt "crater"
msgid "Mab"
msgstr "マブ"

#: data/nomenclature.fab:48
msgctxt "origin"
msgid "Queen of Spirits, dethroned Titania."
msgstr "精霊の女王、王位を奪われたチタニア。"

#. TRANSLATORS: (Ariel); Spirit heroine of medieval French story.
#: data/nomenclature.fab:50
msgctxt "crater"
msgid "Melusine"
msgstr "メリュジーヌ"

#: data/nomenclature.fab:50
msgctxt "origin"
msgid "Spirit heroine of medieval French story."
msgstr "中世フランス物語に登場する精霊のヒロイン。"

#. TRANSLATORS: (Ariel); Irish Queen of Fairies.
#: data/nomenclature.fab:52
msgctxt "crater"
msgid "Oonagh"
msgstr "オーナ"

#: data/nomenclature.fab:52
msgctxt "origin"
msgid "Irish Queen of Fairies."
msgstr "アイルランドの妖精の女王。"

#. TRANSLATORS: (Ariel); Spirit in Hudson's "Green Mansions."
#: data/nomenclature.fab:54
msgctxt "crater"
msgid "Rima"
msgstr "リーマ"

#: data/nomenclature.fab:54
msgctxt "origin"
msgid "Spirit in Hudson's “Green Mansions.”"
msgstr "ハドソンの「緑の館」に登場する精霊。"

#. TRANSLATORS: (Ariel); Spirit that brings day.
#: data/nomenclature.fab:56
msgctxt "crater"
msgid "Yangoor"
msgstr "ヤングール"

#: data/nomenclature.fab:56
msgctxt "origin"
msgid "Spirit that brings day."
msgstr "日をもたらす精霊。"

#. TRANSLATORS: (Ariel); Good spirit who fills Italian children's stockings
#. with toys on twelfth night.
#: data/nomenclature.fab:58
msgctxt "crater"
msgid "Befana"
msgstr "ベファーナ"

#: data/nomenclature.fab:58
msgctxt "origin"
msgid ""
"Good spirit who fills Italian children's stockings with toys on twelfth "
"night."
msgstr "12日目の夜、イタリアの子供の靴下におもちゃを詰める良い精霊。"

#. TRANSLATORS: (Ariel); German good spirits who live in woods.
#: data/nomenclature.fab:60
msgctxt "chasma"
msgid "Brownie Chasma"
msgstr "ブラウニー・カズマ地形"

#: data/nomenclature.fab:60
msgctxt "origin"
msgid "German good spirits who live in woods."
msgstr "森に住むドイツの良い精霊。"

#. TRANSLATORS: (Ariel); Pueblo (USA) good spirits who bring rain or other
#. blessings.
#: data/nomenclature.fab:62
msgctxt "chasma"
msgid "Kachina Chasmata"
msgstr "カチナ・カズマ地形"

#: data/nomenclature.fab:62
msgctxt "origin"
msgid "Pueblo (USA) good spirits who bring rain or other blessings."
msgstr "プエブロ族 (米国) に伝わる雨やその他の恵みをもたらす良い精霊。"

#. TRANSLATORS: (Ariel); Vital spirits (Gold Coast).
#: data/nomenclature.fab:64
msgctxt "chasma"
msgid "Kra Chasma"
msgstr "クラ・カズマ地形"

#: data/nomenclature.fab:64
msgctxt "origin"
msgid "Vital spirits (Gold Coast)."
msgstr "生命の精霊 (ゴールド・コースト地方)"

#. TRANSLATORS: (Ariel); British race of quaint spirit babies.
#: data/nomenclature.fab:66
msgctxt "chasma"
msgid "Kewpie Chasma"
msgstr "キューピー・カズマ地形"

#: data/nomenclature.fab:66
msgctxt "origin"
msgid "British race of quaint spirit babies."
msgstr "ブリトン族の奇妙な精霊の赤ちゃんの一種族。"

#. TRANSLATORS: (Ariel); French wind spirits who cure diseases.
#: data/nomenclature.fab:68
msgctxt "chasma"
msgid "Korrigan Chasma"
msgstr "コリガン・カズマ地形"

#: data/nomenclature.fab:68
msgctxt "origin"
msgid "French wind spirits who cure diseases."
msgstr "病気を治すフランスの風の精霊。"

#. TRANSLATORS: (Ariel); British air spirits who influence the temperaments
#. man.
#: data/nomenclature.fab:70
msgctxt "chasma"
msgid "Sylph Chasma"
msgstr "シルフ・カズマ地形"

#: data/nomenclature.fab:70
msgctxt "origin"
msgid "British air spirits who influence the temperaments man."
msgstr "ブリトン族の人間の気性に影響を与える空気の精霊。"

#. TRANSLATORS: (Ariel); British spirits that live in rocks.
#: data/nomenclature.fab:72
msgctxt "chasma"
msgid "Pixie Chasma"
msgstr "ピクシー・カズマ地形"

#: data/nomenclature.fab:72
msgctxt "origin"
msgid "British spirits that live in rocks."
msgstr "ブリトン族の岩に宿る精霊。"

#. TRANSLATORS: (Ariel); Earth spirits.
#: data/nomenclature.fab:74
msgctxt "vallis"
msgid "Sprite Vallis"
msgstr "スプライト峡谷"

#: data/nomenclature.fab:74
msgctxt "origin"
msgid "Earth spirits."
msgstr "大地の精霊。"

#. TRANSLATORS: (Ariel); Spirits or dwarfs.
#: data/nomenclature.fab:76
msgctxt "vallis"
msgid "Leprechaun Vallis"
msgstr "レプラコーン峡谷"

#: data/nomenclature.fab:76
msgctxt "origin"
msgid "Spirits or dwarfs."
msgstr "精霊とかドワーフ。"

#. TRANSLATORS: (Arrokoth); Word for 'sky' in the English language.
#: data/nomenclature.fab:78
msgctxt "crater"
msgid "Sky"
msgstr "スカイ"

#: data/nomenclature.fab:78
msgctxt "origin"
msgid "Word for 'sky' in the English language."
msgstr "英語で「空」を表す単語。"

#. TRANSLATORS: (Arrokoth); Word for 'sky' in Yucatec Maya.
#: data/nomenclature.fab:80
msgctxt "arcus"
msgid "Ka'an Arcus"
msgstr "カアン弧状地形"

#: data/nomenclature.fab:80
msgctxt "origin"
msgid "Word for 'sky' in Yucatec Maya."
msgstr "マヤ族ユカテコ語で「空」を表す単語。"

#. TRANSLATORS: (Arrokoth); Word for 'sky' in Bengali (Bangla) and related
#. languages.
#: data/nomenclature.fab:82
msgctxt "collum"
msgid "Akasa Collum"
msgstr ""

#: data/nomenclature.fab:82
msgctxt "origin"
msgid "Word for 'sky' in Bengali (Bangla) and related languages."
msgstr "ベンガル語 (Bengali or Bangla) および関連言語で「空」を表す単語。"

#. TRANSLATORS: (Arrokoth); Word for "sky" in the Mapuche language.
#: data/nomenclature.fab:84
msgctxt "lobus"
msgid "Wenu Lobus"
msgstr "ウェヌ葉状地形"

#: data/nomenclature.fab:84
msgctxt "origin"
msgid "Word for “sky” in the Mapuche language."
msgstr "マプチェ族の言葉で「空」を表す単語。"

#. TRANSLATORS: (Arrokoth); Word for 'sky' in the Pulaar language of western
#. Africa.
#: data/nomenclature.fab:86
msgctxt "lobus"
msgid "Weeyo Lobus"
msgstr "ウェーヨ葉状地形"

#: data/nomenclature.fab:86
msgctxt "origin"
msgid "Word for 'sky' in the Pulaar language of western Africa."
msgstr "西アフリカのプラール語で「空」を表す単語。"

#. TRANSLATORS: (Bennu); Massive bird that resides beyond the eastern horizon
#. since before time began and causes lunar eclipses in myths of Bagobo (Lumad
#. group at Mindanao Island, S. Philippines).
#: data/nomenclature.fab:88
msgctxt "crater"
msgid "Minokawa"
msgstr "ミノカワ"

#: data/nomenclature.fab:88
msgctxt "origin"
msgid ""
"Massive bird that resides beyond the eastern horizon since before time began"
" and causes lunar eclipses in myths of Bagobo (Lumad group at Mindanao "
"Island, S. Philippines)."
msgstr ""
"バゴボ族 (フィリピン南部、ミンダナオ島のルマド人の集団) の神話の中で、時間が始まる前から東の地平線の彼方に生息し、月食を引き起こす巨大な鳥。"

#. TRANSLATORS: (Bennu); Pawnee (Central USA) Thunderbird, a huge long-necked
#. bird with a forked, jagged tail. The beating of his wings causes thunder.
#: data/nomenclature.fab:90
msgctxt "crater"
msgid "Huhuk"
msgstr "フフク"

#: data/nomenclature.fab:90
msgctxt "origin"
msgid ""
"Pawnee (Central USA) Thunderbird, a huge long-necked bird with a forked, "
"jagged tail. The beating of his wings causes thunder."
msgstr "ポーニー族 (アメリカ中部) のサンダーバード (雷鳥) 、二股に分かれたギザギザの尾を持つ首の長い巨大な鳥。翼の羽ばたきで雷が起きる。"

#. TRANSLATORS: (Bennu); In Czech and Slovak folklore, glowing or burning bird
#. (firebird) with colorful red, gold and orange feathers.
#: data/nomenclature.fab:92
msgctxt "crater"
msgid "Ohnivak"
msgstr "オニヴァク"

#: data/nomenclature.fab:92
msgctxt "origin"
msgid ""
"In Czech and Slovak folklore, glowing or burning bird (firebird) with "
"colorful red, gold and orange feathers."
msgstr "チェコとスロバキアの民間伝承で赤、金、オレンジの色とりどりの羽を持って光ったり燃えたりする鳥 (火の鳥)。"

#. TRANSLATORS: (Bennu); In myths of Aboriginal Australian people of the
#. Murray River basin, a crane, who tossed an egg from the nest of emu Dinewan
#. into the sky where it became the sun.
#: data/nomenclature.fab:94
msgctxt "crater"
msgid "Bralgah"
msgstr "ブラルガ"

#: data/nomenclature.fab:94
msgctxt "origin"
msgid ""
"In myths of Aboriginal Australian people of the Murray River basin, a crane,"
" who tossed an egg from the nest of emu Dinewan into the sky where it became"
" the sun."
msgstr "マレー川流域のオーストラリア先住民アボリジニには、鶴がエミューのディネワンの巣から卵を空に投げ、それが太陽になったという神話がある。"

#. TRANSLATORS: (Bennu); Emu whose egg created the sun in the myths of
#. Aboriginal Australian people of the Murray River basin.
#: data/nomenclature.fab:96
msgctxt "crater"
msgid "Dinewan"
msgstr "ディネワン"

#: data/nomenclature.fab:96
msgctxt "origin"
msgid ""
"Emu whose egg created the sun in the myths of Aboriginal Australian people "
"of the Murray River basin."
msgstr "マレー川流域のオーストラリア先住民アボリジニの神話の中で、その卵が太陽を生み出したエミュー。"

#. TRANSLATORS: (Bennu); Chilean mythological nocturnal bird whose wings shine
#. at night with metallic colors so bright that cast no shadow. It lives in
#. small caves and eats metal ores, weight of which gives no possibility to
#. fly.
#: data/nomenclature.fab:98
msgctxt "crater"
msgid "Alicanto"
msgstr "アリカント"

#: data/nomenclature.fab:98
msgctxt "origin"
msgid ""
"Chilean mythological nocturnal bird whose wings shine at night with metallic"
" colors so bright that cast no shadow. It lives in small caves and eats "
"metal ores, weight of which gives no possibility to fly."
msgstr ""
"チリの神話に登場する夜行性の鳥で、夜になると翼が影を映さないほど明るい金属色で輝く。小さな洞窟に住んでいて金属鉱石を食べるが、その重さで飛べる可能性は無い。"

#. TRANSLATORS: (Bennu); Maori (New Zealand) mythical bird with enormously
#. long divided tail, which lives in heavens and never visits earth.
#: data/nomenclature.fab:100
msgctxt "crater"
msgid "Hokioi"
msgstr "ホキオイ"

#: data/nomenclature.fab:100
msgctxt "origin"
msgid ""
"Maori (New Zealand) mythical bird with enormously long divided tail, which "
"lives in heavens and never visits earth."
msgstr "マオリ族 (ニュージーランド) の伝説上の鳥。非常に長く分かれた尾があって天空に住み、決して地上には訪れない。"

#. TRANSLATORS: (Bennu); Mesopotamian/Sumerian nocturnal wind demon depicted
#. as woman with wings and birds' feet with talons.
#: data/nomenclature.fab:102
msgctxt "crater"
msgid "Lilitu"
msgstr "リリトゥ"

#: data/nomenclature.fab:102
msgctxt "origin"
msgid ""
"Mesopotamian/Sumerian nocturnal wind demon depicted as woman with wings and "
"birds' feet with talons."
msgstr "メソポタミアとシュメールに伝わる夜行性の風の悪魔。翼と鉤爪のある鳥の足のある女性として描かれる。"

#. TRANSLATORS: (Bennu); Abenaki (Algonquians of NE USA) giant bird, named
#. Windblower, who sits upon a rock at the edge of the sky far in the north
#. and produces winds by his wings.
#: data/nomenclature.fab:104
msgctxt "crater"
msgid "Wuchowsen"
msgstr "ウゥチョウセン"

#: data/nomenclature.fab:104
msgctxt "origin"
msgid ""
"Abenaki (Algonquians of NE USA) giant bird, named Windblower, who sits upon "
"a rock at the edge of the sky far in the north and produces winds by his "
"wings."
msgstr ""
"アベナキ族 (アメリカ北東に住むアルゴンキン人) "
"の巨大な鳥。ウィンドブロワーという名前が付けられている。遥か北の空の端にある岩の上に座り、翼で風を起こす。"

#. TRANSLATORS: (Bennu); Fon (Benin/Dahomey) mythical bird which reconciled
#. the two gods in their dispute and thus ended a great drought.
#: data/nomenclature.fab:106
msgctxt "crater"
msgid "Wututu"
msgstr "ウゥトゥトゥ"

#: data/nomenclature.fab:106
msgctxt "origin"
msgid ""
"Fon (Benin/Dahomey) mythical bird which reconciled the two gods in their "
"dispute and thus ended a great drought."
msgstr "フォン族 (ベナンやダホメ) の神話上の鳥。2人の神の争いを和解させ、大干ばつを終わらせた。"

#. TRANSLATORS: (Bennu); In Hindu mythology, a giant bird, vulture, whose
#. wings had been burnt by the blaze of the Sun when he had flown too close to
#. it in racing with his brother.
#: data/nomenclature.fab:108
msgctxt "crater"
msgid "Sampati"
msgstr "サムパティ"

#: data/nomenclature.fab:108
msgctxt "origin"
msgid ""
"In Hindu mythology, a giant bird, vulture, whose wings had been burnt by the"
" blaze of the Sun when he had flown too close to it in racing with his "
"brother."
msgstr "ヒンドゥーの神話で、兄弟と競争して太陽に近づきすぎた時に太陽の炎で翼を焼かれた巨大な鳥、ハゲワシ。"

#. TRANSLATORS: (Bennu); Winged horse in Greek mythology.
#: data/nomenclature.fab:110
msgctxt "crater"
msgid "Pegasus"
msgstr "ペガスス"

#: data/nomenclature.fab:110
msgctxt "origin"
msgid "Winged horse in Greek mythology."
msgstr "ギリシャ神話に登場する翼のある馬。"

#. TRANSLATORS: (Bennu); Cherokee (Southeast USA), giant birds who scattered
#. the Earth with pieces of serpent which turned into standing pillars of
#. rocks.
#: data/nomenclature.fab:112
msgctxt "regio"
msgid "Tlanuwa Regio"
msgstr "トラヌワ地域"

#: data/nomenclature.fab:112
msgctxt "origin"
msgid ""
"Cherokee (Southeast USA), giant birds who scattered the Earth with pieces of"
" serpent which turned into standing pillars of rocks."
msgstr "チェロキー族 (アメリカ南東部) の巨大な鳥。立っている岩の柱に変わった蛇の破片を大地にまき散らした。"

#. TRANSLATORS: (Bennu); French, dragon-like monster with wings, bird-like
#. neck, and the ability to breathe fire.
#: data/nomenclature.fab:114
msgctxt "saxum"
msgid "Gargoyle Saxum"
msgstr "ガーゴイル岩塊"

#: data/nomenclature.fab:114
msgctxt "origin"
msgid ""
"French, dragon-like monster with wings, bird-like neck, and the ability to "
"breathe fire."
msgstr "フランスの翼と鳥のような首を持ち、火を吐く能力を持つドラゴンのようなモンスター。"

#. TRANSLATORS: (Bennu); Enormous bird of prey in Arabic mythology of the
#. Middle East.
#: data/nomenclature.fab:116
msgctxt "saxum"
msgid "Roc Saxum"
msgstr "ロック岩塊"

#: data/nomenclature.fab:116
msgctxt "origin"
msgid "Enormous bird of prey in Arabic mythology of the Middle East."
msgstr "中東アラビア神話に登場する猛禽類の巨大な鳥。"

#. TRANSLATORS: (Bennu); Norse, one of the two ravens (together with Muninn)
#. accompanying the supreme god Odin.
#: data/nomenclature.fab:118
msgctxt "saxum"
msgid "Huginn Saxum"
msgstr "フギン岩塊"

#: data/nomenclature.fab:118
msgctxt "origin"
msgid ""
"Norse, one of the two ravens (together with Muninn) accompanying the supreme"
" god Odin."
msgstr "北欧神話で最高神オーディンに随伴する二羽のカラス (フギンとムニン) のうちの一羽。"

#. TRANSLATORS: (Bennu); Tagalog (Philippines) deity that is depicted as a
#. bird, the first creature to inhabit the universe.
#: data/nomenclature.fab:120
msgctxt "saxum"
msgid "Amihan Saxum"
msgstr "アミハン岩塊"

#: data/nomenclature.fab:120
msgctxt "origin"
msgid ""
"Tagalog (Philippines) deity that is depicted as a bird, the first creature "
"to inhabit the universe."
msgstr "タガログ (フィリピン) の神様。宇宙に生息した最初の生き物である鳥として描かれる。"

#. TRANSLATORS: (Bennu); Iranian benevolent bird who possesses all knowledge.
#: data/nomenclature.fab:122
msgctxt "saxum"
msgid "Simurgh Saxum"
msgstr "シムルグ岩塊"

#: data/nomenclature.fab:122
msgctxt "origin"
msgid "Iranian benevolent bird who possesses all knowledge."
msgstr "イランの全知である博愛の鳥。"

#. TRANSLATORS: (Bennu); Mythological shapeshifting entity inhabiting the
#. lochs (lakes) of the west coast of Scotland. It commonly adopts the
#. appearance of a gigantic water bird.
#: data/nomenclature.fab:124
msgctxt "saxum"
msgid "Boobrie Saxum"
msgstr "ブーブリー岩塊"

#: data/nomenclature.fab:124
msgctxt "origin"
msgid ""
"Mythological shapeshifting entity inhabiting the lochs (lakes) of the west "
"coast of Scotland. It commonly adopts the appearance of a gigantic water "
"bird."
msgstr "スコットランド西海岸のロッホ (湖) に生息する、神話に登場する姿を変える存在。通常は巨大な水鳥の姿をとる。"

#. TRANSLATORS: (Bennu); Slavic prophetic bird, symbol of wisdom and
#. knowledge; she is depicted as a large bird with a woman's head.
#: data/nomenclature.fab:126
msgctxt "saxum"
msgid "Gamayun Saxum"
msgstr "ガマユン岩塊"

#: data/nomenclature.fab:126
msgctxt "origin"
msgid ""
"Slavic prophetic bird, symbol of wisdom and knowledge; she is depicted as a "
"large bird with a woman's head."
msgstr "スラブ神話での預言的な鳥で知恵と知識の象徴。女性の頭を持つ大きな鳥として描かれる。"

#. TRANSLATORS: (Bennu); Ancient Egyptian primordial mound that arose from the
#. primordial waters Nu. The god Atum settled upon it to create the world
#. after his flight over the waters in the form of the Bennu bird, who is a
#. piece of his soul.
#: data/nomenclature.fab:128
msgctxt "saxum"
msgid "Benben Saxum"
msgstr "ベンベン岩塊"

#: data/nomenclature.fab:128
msgctxt "origin"
msgid ""
"Ancient Egyptian primordial mound that arose from the primordial waters Nu. "
"The god Atum settled upon it to create the world after his flight over the "
"waters in the form of the Bennu bird, who is a piece of his soul."
msgstr ""
"原初の水ヌー (Nu) から生じた古代エジプトの原始の丘。アトゥム (Atum) 神は魂の一部であるベンヌ (Bennu) "
"鳥の形で水の上を飛んだ後、世界を創造するためにそこに定住した。"

#. TRANSLATORS: (Bennu); Norse, one of the two ravens (together with Huginn)
#. accompanying the supreme god Odin.
#: data/nomenclature.fab:130
msgctxt "saxum"
msgid "Muninn Saxum"
msgstr "ムニン岩塊"

#: data/nomenclature.fab:130
msgctxt "origin"
msgid ""
"Norse, one of the two ravens (together with Huginn) accompanying the supreme"
" god Odin."
msgstr "北欧神話で最高神オーディンに随伴する二羽のカラス (フギンとムニン) のうちの一羽。"

#. TRANSLATORS: (Bennu); Māori (Polynesia) monstrous bird who kills and eat
#. humans.
#: data/nomenclature.fab:132
msgctxt "saxum"
msgid "Pouakai Saxum"
msgstr "ポウアカイ岩塊"

#: data/nomenclature.fab:132
msgctxt "origin"
msgid "Māori (Polynesia) monstrous bird who kills and eat humans."
msgstr "人間を殺して食べるマオリ (ポリネシア) の怪鳥。"

#. TRANSLATORS: (Bennu); Greek, one of the three named harpies, half-maiden
#. and half-bird personification of storm winds, that would snatch and carry
#. things away from Earth.
#: data/nomenclature.fab:134
msgctxt "saxum"
msgid "Ocypete Saxum"
msgstr "オキペテ岩塊"

#: data/nomenclature.fab:134
msgctxt "origin"
msgid ""
"Greek, one of the three named harpies, half-maiden and half-bird "
"personification of storm winds, that would snatch and carry things away from"
" Earth."
msgstr "ギリシャ神話でハルピーと呼ばれた3匹のうちの1匹。地上から物を奪い、運び去る嵐の風を擬人化した半乙女、半鳥の生き物。"

#. TRANSLATORS: (Bennu); Roman vampiric bird of ill omen.
#: data/nomenclature.fab:136
msgctxt "saxum"
msgid "Strix Saxum"
msgstr "ストリクス岩塊"

#: data/nomenclature.fab:136
msgctxt "origin"
msgid "Roman vampiric bird of ill omen."
msgstr "ローマ神話で不吉な予兆をもたらす吸血鬼の鳥。"

#. TRANSLATORS: (Bennu); Greek, childhood playmate of the supreme god Zeus who
#. was turned into an eagle by Hera.
#: data/nomenclature.fab:138
msgctxt "saxum"
msgid "Aetos Saxum"
msgstr "アエトス岩塊"

#: data/nomenclature.fab:138
msgctxt "origin"
msgid ""
"Greek, childhood playmate of the supreme god Zeus who was turned into an "
"eagle by Hera."
msgstr "ギリシャ神話で最高神ゼウスの幼少期の遊び相手。ヘラによってワシに変えられた。"

#. TRANSLATORS: (Bennu); Giant flying creature looking like bird or bat in
#. myths of Kaonde, a Bantu-speaking people of NW Zambia and the adjacent
#. areas of the Democratic Republic of Congo (Zaire).
#: data/nomenclature.fab:140
msgctxt "saxum"
msgid "Kongamato Saxum"
msgstr "コンガマトー岩塊"

#: data/nomenclature.fab:140
msgctxt "origin"
msgid ""
"Giant flying creature looking like bird or bat in myths of Kaonde, a Bantu-"
"speaking people of NW Zambia and the adjacent areas of the Democratic "
"Republic of Congo (Zaire)."
msgstr ""
"ザンビア北西部とコンゴ民主共和国（旧ザイール）の隣接地域に住むバンツー語を話すカオンデ族の神話に登場する、鳥かコウモリのような姿をした巨大な飛行生物。"

#. TRANSLATORS: (Bennu); King of the Eagles in the Middle-earth, the fictional
#. setting in fantasy novels by English author J.R.R. Tolkien, the greatest of
#. all eagles, with a wingspan of 55 m (approximately as this boulder).
#: data/nomenclature.fab:142
msgctxt "saxum"
msgid "Thorondor Saxum"
msgstr "ソロンドール岩塊"

#: data/nomenclature.fab:142
msgctxt "origin"
msgid ""
"King of the Eagles in the Middle-earth, the fictional setting in fantasy "
"novels by English author J.R.R. Tolkien, the greatest of all eagles, with a "
"wingspan of 55 m (approximately as this boulder)."
msgstr ""
"中つ国のワシの王。イングランド人作家 J.R.R.トールキンによるファンタジー小説の架空の設定。すべてのワシの中で最大で、翼を広げると55メートル "
"(この岩塊とほぼ同じ大きさ) です。"

#. TRANSLATORS: (Bennu); Non-flying bird, rounded and gray, a fictional
#. character in the book Alice's Adventure in Wonderland (1865) by English
#. writer Lewis Carroll.
#: data/nomenclature.fab:144
msgctxt "saxum"
msgid "Dodo Saxum"
msgstr "ドードー岩塊"

#: data/nomenclature.fab:144
msgctxt "origin"
msgid ""
"Non-flying bird, rounded and gray, a fictional character in the book Alice's"
" Adventure in Wonderland (1865) by English writer Lewis Carroll."
msgstr "イングランド人作家ルイス・キャロルの『不思議の国のアリス』 (1865 年) に登場する、丸くて灰色の飛べない鳥。"

#. TRANSLATORS: (Bennu); Princess turned into White Swan in the ballet Swan
#. Lake (1877) by Russian composer Pyotr Tchaikovsky. This character, which
#. name derives from French, is opposite to Odile, the Black Swan maiden.
#: data/nomenclature.fab:146
msgctxt "saxum"
msgid "Odette Saxum"
msgstr "オデット岩塊"

#: data/nomenclature.fab:146
msgctxt "origin"
msgid ""
"Princess turned into White Swan in the ballet Swan Lake (1877) by Russian "
"composer Pyotr Tchaikovsky. This character, which name derives from French, "
"is opposite to Odile, the Black Swan maiden."
msgstr ""
"ロシアの作曲家ピョートル・チャイコフスキーのバレエ「白鳥の湖」 (1877年) "
"で白鳥に変身した王女。名前はフランス語に由来し、黒鳥の乙女であるオディール (Odile) と正反対にあります。"

#. TRANSLATORS: (Bennu); Thunder-beings of Algonquian mythology (in particular
#. Oklahoma Miami Nation) that live in the sky and cause thunder and
#. lightning. They look like giant eagles, or as birds with a human head.
#: data/nomenclature.fab:148
msgctxt "saxum"
msgid "Ciinkwia Saxum"
msgstr "チインクウィア岩塊"

#: data/nomenclature.fab:148
msgctxt "origin"
msgid ""
"Thunder-beings of Algonquian mythology (in particular Oklahoma Miami Nation)"
" that live in the sky and cause thunder and lightning. They look like giant "
"eagles, or as birds with a human head."
msgstr ""
"アルゴンキン族の神話 (特にオクラホマ・ マイアミ部族) "
"に登場する、空に住んで雷と稲妻を引き起こす雷の存在。彼らは巨大なワシのように、あるいは人間の頭を持った鳥のように見えます。"

#. TRANSLATORS: (Bennu); Norse, gold-combed rooster who lives in the heavenly
#. majestic hall Valhalla and wakes gods and heroes.
#: data/nomenclature.fab:150
msgctxt "saxum"
msgid "Gullinkambi Saxum"
msgstr "グリンカムビ岩塊"

#: data/nomenclature.fab:150
msgctxt "origin"
msgid ""
"Norse, gold-combed rooster who lives in the heavenly majestic hall Valhalla "
"and wakes gods and heroes."
msgstr "北欧神話で天の荘厳な宮殿ヴァルハラに住み、神々と英雄を目覚めさせる金頭鶏。"

#. TRANSLATORS: (Bennu); Aello; Greek, one of the harpies (together with
#. Celaeno and Ocypete), half-maiden and half-bird personification of storm
#. winds, that would snatch and carry things away from Earth.
#: data/nomenclature.fab:152
msgctxt "saxum"
msgid "Aellopus Saxum"
msgstr "アエロプス岩塊"

#: data/nomenclature.fab:152
msgctxt "origin"
msgid ""
"Aello; Greek, one of the harpies (together with Celaeno and Ocypete), half-"
"maiden and half-bird personification of storm winds, that would snatch and "
"carry things away from Earth."
msgstr "アエロはギリシア神話で (ケラエノ、オキュペテと共に) ハルピーの一人で、半乙女、半鳥の嵐の擬人化です。地上から物をさらって運び去ります。"

#. TRANSLATORS: (Bennu); Black Swan maiden in the ballet Swan Lake (1877) by
#. Russian composer Pyotr Tchaikovsky. This character, which name derives from
#. Old German, is opposite to Odette, the Swan Princess.
#: data/nomenclature.fab:154
msgctxt "saxum"
msgid "Odile Saxum"
msgstr "オディール岩塊"

#: data/nomenclature.fab:154
msgctxt "origin"
msgid ""
"Black Swan maiden in the ballet Swan Lake (1877) by Russian composer Pyotr "
"Tchaikovsky. This character, which name derives from Old German, is opposite"
" to Odette, the Swan Princess."
msgstr ""
"ロシアの作曲家ピョートル・チャイコフスキーのバレエ「白鳥の湖」 (1877年) に登場する黒鳥の乙女。名前は古ドイツ語に由来し、白鳥の王女オデット "
"(Odette) の正反対にあります。"

#. TRANSLATORS: (Bennu); One of four birds which destructed the first race of
#. people carved out of wood in Kʼicheʼ Maya (Guatemala) creation myth.
#: data/nomenclature.fab:156
msgctxt "saxum"
msgid "Camulatz Saxum"
msgstr "カムラツ岩塊"

#: data/nomenclature.fab:156
msgctxt "origin"
msgid ""
"One of four birds which destructed the first race of people carved out of "
"wood in Kʼicheʼ Maya (Guatemala) creation myth."
msgstr "マヤ人キチェ族  (グアテマラ) の創世神話で、木から彫られた最初の人類を滅ぼした4羽の鳥のうちの 1 羽。"

#. TRANSLATORS: (Bennu); Greek, one of the harpies (together with Aellopus and
#. Ocypete), half-maiden and half-bird personification of darkness and storm
#. winds, that would snatch and carry things away from Earth.
#: data/nomenclature.fab:158
msgctxt "saxum"
msgid "Celaeno Saxum"
msgstr "ケラエノ岩塊"

#: data/nomenclature.fab:158
msgctxt "origin"
msgid ""
"Greek, one of the harpies (together with Aellopus and Ocypete), half-maiden "
"and half-bird personification of darkness and storm winds, that would snatch"
" and carry things away from Earth."
msgstr "ギリシア神話で (アエロポス、オキュペテと共に) ハルピーの一人で、半乙女、半鳥の闇と嵐の擬人化で、地上から物をさらって運び去ります。"

#. TRANSLATORS: (Callisto); Norse dwarf.
#: data/nomenclature.fab:160
msgctxt "crater"
msgid "Durinn"
msgstr "ドゥリン"

#: data/nomenclature.fab:160 data/nomenclature.fab:166
#: data/nomenclature.fab:174 data/nomenclature.fab:210
#: data/nomenclature.fab:222 data/nomenclature.fab:224
#: data/nomenclature.fab:240 data/nomenclature.fab:268
#: data/nomenclature.fab:298 data/nomenclature.fab:302
#: data/nomenclature.fab:312 data/nomenclature.fab:326
#: data/nomenclature.fab:354 data/nomenclature.fab:368
#: data/nomenclature.fab:396 data/nomenclature.fab:406
#: data/nomenclature.fab:418 data/nomenclature.fab:420
#: data/nomenclature.fab:426 data/nomenclature.fab:430
msgctxt "origin"
msgid "Norse dwarf."
msgstr "北欧神話のドワーフ。"

#. TRANSLATORS: (Callisto); Greek; Callisto's sister.
#: data/nomenclature.fab:162
msgctxt "crater"
msgid "Dia"
msgstr "ディア"

#: data/nomenclature.fab:162
msgctxt "origin"
msgid "Greek; Callisto's sister."
msgstr "ギリシャ神話; カリストの姉妹。"

#. TRANSLATORS: (Callisto); Ottar's ancestor.
#: data/nomenclature.fab:164
msgctxt "crater"
msgid "Ginandi"
msgstr "ギナンディ"

#: data/nomenclature.fab:164 data/nomenclature.fab:220
#: data/nomenclature.fab:260 data/nomenclature.fab:278
#: data/nomenclature.fab:304 data/nomenclature.fab:358
#: data/nomenclature.fab:440
msgctxt "origin"
msgid "Ottar's ancestor."
msgstr "オッタルの先祖。"

#. TRANSLATORS: (Callisto); Norse dwarf.
#: data/nomenclature.fab:166
msgctxt "crater"
msgid "Gloi"
msgstr "グローイ"

#. TRANSLATORS: (Callisto); Norse; a Valkyrie.
#: data/nomenclature.fab:168
msgctxt "crater"
msgid "Gunnr"
msgstr "グン"

#: data/nomenclature.fab:168 data/nomenclature.fab:180
msgctxt "origin"
msgid "Norse; a Valkyrie."
msgstr "北欧神話; ヴァルキリー。"

#. TRANSLATORS: (Callisto); Norse; another name for the sea-god, Legir.
#: data/nomenclature.fab:170
msgctxt "crater"
msgid "Gymir"
msgstr "ギュミル"

#: data/nomenclature.fab:170
msgctxt "origin"
msgid "Norse; another name for the sea-god, Legir."
msgstr "北欧神話; 海神レギルの別名。"

#. TRANSLATORS: (Callisto); Norse; maid to Frigg, queen of the gods.
#: data/nomenclature.fab:172
msgctxt "crater"
msgid "Fulla"
msgstr "フッラ"

#: data/nomenclature.fab:172
msgctxt "origin"
msgid "Norse; maid to Frigg, queen of the gods."
msgstr "北欧神話; 神々の女王フリッグの侍女。"

#. TRANSLATORS: (Callisto); Norse dwarf.
#: data/nomenclature.fab:174
msgctxt "crater"
msgid "Gandalfr"
msgstr "ガンダールヴル"

#. TRANSLATORS: (Callisto); Norse; wolf's name meaning "greedy."
#: data/nomenclature.fab:176
msgctxt "crater"
msgid "Geri"
msgstr "ゲリ"

#: data/nomenclature.fab:176
msgctxt "origin"
msgid "Norse; wolf's name meaning “greedy.”"
msgstr "北欧神話; 「貪欲」を意味するオオカミの名前。"

#. TRANSLATORS: (Callisto); Norse; servant to the gods.
#: data/nomenclature.fab:178
msgctxt "crater"
msgid "Göll"
msgstr "ゲル"

#: data/nomenclature.fab:178
msgctxt "origin"
msgid "Norse; servant to the gods."
msgstr "北欧神話; 神々に仕える従者。"

#. TRANSLATORS: (Callisto); Norse; a Valkyrie.
#: data/nomenclature.fab:180
msgctxt "crater"
msgid "Göndul"
msgstr "ゲンドゥル"

#. TRANSLATORS: (Callisto); Norse giant.
#: data/nomenclature.fab:182
msgctxt "crater"
msgid "Haki"
msgstr "ハキ"

#: data/nomenclature.fab:182 data/nomenclature.fab:412
msgctxt "origin"
msgid "Norse giant."
msgstr "北欧神話の巨人"

#. TRANSLATORS: (Callisto); Son of Karl and Snor in Rigdismal.
#: data/nomenclature.fab:184
msgctxt "crater"
msgid "Höldr"
msgstr "ヘルズ"

#: data/nomenclature.fab:184
msgctxt "origin"
msgid "Son of Karl and Snor in Rigdismal."
msgstr "リグティスマルでのカールとスノルの息子。"

#. TRANSLATORS: (Callisto); Norse; a name for Odin.
#: data/nomenclature.fab:186
msgctxt "crater"
msgid "Grimr"
msgstr "グリーム"

#: data/nomenclature.fab:186 data/nomenclature.fab:252
#: data/nomenclature.fab:400
msgctxt "origin"
msgid "Norse; a name for Odin."
msgstr "北欧神話; オーディンの別名。"

#. TRANSLATORS: (Callisto); Norse; Ottar's ancestor.
#: data/nomenclature.fab:188
msgctxt "crater"
msgid "Högni"
msgstr "ヘーグニ"

#: data/nomenclature.fab:188 data/nomenclature.fab:206
#: data/nomenclature.fab:308 data/nomenclature.fab:372
#: data/nomenclature.fab:398 data/nomenclature.fab:422
#: data/nomenclature.fab:424
msgctxt "origin"
msgid "Norse; Ottar's ancestor."
msgstr "北欧神話; オッタルの先祖。"

#. TRANSLATORS: (Callisto); Karelian deity of hunting.
#: data/nomenclature.fab:190
msgctxt "crater"
msgid "Hijsi"
msgstr "ヒジシ"

#: data/nomenclature.fab:190
msgctxt "origin"
msgid "Karelian deity of hunting."
msgstr "カレリア人の狩猟の神様。"

#. TRANSLATORS: (Callisto); Norse; god who gave souls to first humans.
#: data/nomenclature.fab:192
msgctxt "crater"
msgid "Hoenir"
msgstr "ヘーニル"

#: data/nomenclature.fab:192
msgctxt "origin"
msgid "Norse; god who gave souls to first humans."
msgstr "北欧神話; 最初の人間に魂を与えた神。"

#. TRANSLATORS: (Callisto); Norse; a hawk.
#: data/nomenclature.fab:194
msgctxt "crater"
msgid "Hábrok"
msgstr "ハーブローク"

#: data/nomenclature.fab:194
msgctxt "origin"
msgid "Norse; a hawk."
msgstr "北欧神話; 鷹。"

#. TRANSLATORS: (Callisto); Norse; Hledis' father.
#: data/nomenclature.fab:196
msgctxt "crater"
msgid "Frodi"
msgstr "フロディ"

#: data/nomenclature.fab:196
msgctxt "origin"
msgid "Norse; Hledis' father."
msgstr "北欧神話; フレディズの父。"

#. TRANSLATORS: (Callisto); Norse; wolf's name meaning "insatiable."
#: data/nomenclature.fab:198
msgctxt "crater"
msgid "Freki"
msgstr "フレキ"

#: data/nomenclature.fab:198
msgctxt "origin"
msgid "Norse; wolf's name meaning “insatiable.”"
msgstr "北欧神話;  狼の名前で「飽くことのない」を意味する。"

#. TRANSLATORS: (Callisto); Norse; Baldr's blind brother who shot Baldr
#. unknowingly.
#: data/nomenclature.fab:200
msgctxt "crater"
msgid "Hödr"
msgstr "ヘズ"

#: data/nomenclature.fab:200
msgctxt "origin"
msgid "Norse; Baldr's blind brother who shot Baldr unknowingly."
msgstr "北欧神話; バルドルの盲目の兄弟で、バルドルと知らずに射殺した。"

#. TRANSLATORS: (Callisto); Alaskan name of the Moon.
#: data/nomenclature.fab:202
msgctxt "crater"
msgid "Igaluk"
msgstr "イガルク"

#: data/nomenclature.fab:202
msgctxt "origin"
msgid "Alaskan name of the Moon."
msgstr "アラスカの月の名前。"

#. TRANSLATORS: (Callisto); A celestial divinity of air.
#: data/nomenclature.fab:204
msgctxt "crater"
msgid "Ilma"
msgstr "イルマ"

#: data/nomenclature.fab:204
msgctxt "origin"
msgid "A celestial divinity of air."
msgstr "天上の空気の神格。"

#. TRANSLATORS: (Callisto); Norse; Ottar's ancestor.
#: data/nomenclature.fab:206
msgctxt "crater"
msgid "Ivarr"
msgstr "イーヴァル"

#. TRANSLATORS: (Callisto); Another name for Odinn.
#: data/nomenclature.fab:208
msgctxt "crater"
msgid "Jalkr"
msgstr "ジャルクル"

#: data/nomenclature.fab:208 data/nomenclature.fab:362
msgctxt "origin"
msgid "Another name for Odinn."
msgstr "オーディンの別名。"

#. TRANSLATORS: (Callisto); Norse dwarf.
#: data/nomenclature.fab:210
msgctxt "crater"
msgid "Reginn"
msgstr "レギン"

#. TRANSLATORS: (Callisto); Finno-Ugric evil spirit.
#: data/nomenclature.fab:212
msgctxt "crater"
msgid "Lempo"
msgstr "レンポ"

#: data/nomenclature.fab:212
msgctxt "origin"
msgid "Finno-Ugric evil spirit."
msgstr "フィン・ウゴル族の悪霊。"

#. TRANSLATORS: (Callisto); Mongolian; Mongol evil snake; tried to kill all
#. living things.
#: data/nomenclature.fab:214
msgctxt "crater"
msgid "Losy"
msgstr "ロシー"

#: data/nomenclature.fab:214
msgctxt "origin"
msgid "Mongolian; Mongol evil snake; tried to kill all living things."
msgstr "モンゴル族; モンゴルの邪悪な蛇; すべての生き物を殺そうとした。"

#. TRANSLATORS: (Callisto); Finno-Ugric god of barley.
#: data/nomenclature.fab:216
msgctxt "crater"
msgid "Pekko"
msgstr "ペッコ"

#: data/nomenclature.fab:216
