msgstr "ケプラー尾根"

#. TRANSLATORS: (Phobos); Fictional city in Jonathan Swift's Gulliver's
#. Travels, ruled by a tyrannical king from the flying island Laputa.
#: data/nomenclature.fab:26590
msgctxt "planitia"
msgid "Lagado Planitia"
msgstr "ラガード平原"

#: data/nomenclature.fab:26590
msgctxt "origin"
msgid ""
"Fictional city in Jonathan Swift's Gulliver's Travels, ruled by a tyrannical"
" king from the flying island Laputa."
msgstr "ジョナサン・スイフトのガリヴァー旅行記に登場する架空の都市。空飛ぶ島ラピュタの暴君王が統治する。"

#. TRANSLATORS: (Phobos); Fictional flying island in Jonathan Swift's
#. Gulliver's Travels.
#: data/nomenclature.fab:26592
msgctxt "regio"
msgid "Laputa Regio"
msgstr "ラピュタ地域"

#: data/nomenclature.fab:26592
msgctxt "origin"
msgid "Fictional flying island in Jonathan Swift's Gulliver's Travels."
msgstr "ジョナサン・スイフトのガリヴァー旅行記に登場する架空の空飛ぶ島。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Neptune and Amymone, or of
#. Klytoneos.
#: data/nomenclature.fab:26594
msgctxt "crater"
msgid "Nauplius"
msgstr "ナウプリウス"

#: data/nomenclature.fab:26594
msgctxt "origin"
msgid "Argonaut, son of Neptune and Amymone, or of Klytoneos."
msgstr "アルゴ号の乗組員、ネプチューンとアミモネの息子、またはクリトネオスの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, founder and king of Pherae in Thessaly.
#: data/nomenclature.fab:26596
msgctxt "crater"
msgid "Admetus"
msgstr "アドメトス"

#: data/nomenclature.fab:26596
msgctxt "origin"
msgid "Argonaut, founder and king of Pherae in Thessaly."
msgstr "アルゴ号の乗組員、テッサリアにあるフェラエの創始者であり王。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Hyperasius and Hypso.
#: data/nomenclature.fab:26598
msgctxt "crater"
msgid "Amphion"
msgstr "アンフィオン"

#: data/nomenclature.fab:26598
msgctxt "origin"
msgid "Argonaut, son of Hyperasius and Hypso."
msgstr "アルゴ号の乗組員、ヒペラシウスとヒプソの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of the Thessalian king Pelias, took
#. part in the Calydonian boar hunt.
#: data/nomenclature.fab:26600
msgctxt "crater"
msgid "Acastus"
msgstr "アカストス"

#: data/nomenclature.fab:26600
msgctxt "origin"
msgid ""
"Argonaut, son of the Thessalian king Pelias, took part in the Calydonian "
"boar hunt."
msgstr "アルゴ号の乗組員、テッサリア王ペリアスの息子で、カリュドニアの猪狩りに参加した。"

#: data/nomenclature.fab:26602
msgctxt "origin"
msgid "Argonaut, son of Teleon, bee-master."
msgstr "アルゴ号の乗組員、養蜂家テレオンの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Kanethos or Cerion, the only member
#. of the expedition to die in combat.
#: data/nomenclature.fab:26604
msgctxt "crater"
msgid "Canthus"
msgstr "カントス"

#: data/nomenclature.fab:26604
msgctxt "origin"
msgid ""
"Argonaut, son of Kanethos or Cerion, the only member of the expedition to "
"die in combat."
msgstr "アルゴ号の乗組員、カネトスまたはケリオンの息子、 遠征隊の中で戦闘で死亡した唯一のメンバー。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Boreas, the north wind.
#: data/nomenclature.fab:26606
msgctxt "crater"
msgid "Calais"
msgstr "カライス"

#: data/nomenclature.fab:26606 data/nomenclature.fab:26640
msgctxt "origin"
msgid "Argonaut, son of Boreas, the north wind."
msgstr "アルゴ号の乗組員、ボレアス (北風) の息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Eurytus, skilled archer who was
#. killed by Apollo for challenging the god to a shooting match.
#: data/nomenclature.fab:26608
msgctxt "crater"
msgid "Clytius"
msgstr "クリティウス"

#: data/nomenclature.fab:26608
msgctxt "origin"
msgid ""
"Argonaut, son of Eurytus, skilled archer who was killed by Apollo for "
"challenging the god to a shooting match."
msgstr "アルゴ号の乗組員、エウリュトスの息子。神に射撃の勝負を挑んだためにアポロに殺された熟練の射手。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Neptune and Europa.
#: data/nomenclature.fab:26610
msgctxt "crater"
msgid "Euphemus"
msgstr "エウフェモス"

#: data/nomenclature.fab:26610
msgctxt "origin"
msgid "Argonaut, son of Neptune and Europa."
msgstr "アルゴ号の乗組員、ネプチューンとエウロパの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Ctimenus.
#: data/nomenclature.fab:26612
msgctxt "crater"
msgid "Eurydamas"
msgstr "エウリダマス"

#: data/nomenclature.fab:26612
msgctxt "origin"
msgid "Argonaut, son of Ctimenus."
msgstr "アルゴ号の乗組員、クティメノスの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Kenethos or Cerion.
#: data/nomenclature.fab:26614
msgctxt "crater"
msgid "Eurytion"
msgstr "エウリティオン"

#: data/nomenclature.fab:26614
msgctxt "origin"
msgid "Argonaut, son of Kenethos or Cerion."
msgstr "アルゴ号の乗組員、ケネトス、またはケリオンの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Mercury and Antianira.
#: data/nomenclature.fab:26616
msgctxt "crater"
msgid "Eurytus"
msgstr "エウリタス"

#: data/nomenclature.fab:26616
msgctxt "origin"
msgid "Argonaut, son of Mercury and Antianira."
msgstr "アルゴ号の乗組員、マーキュリーとアンティアニラの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Neptune, helmsman of the Argo after
#. the death of Tiphys.
#: data/nomenclature.fab:26618
msgctxt "crater"
msgid "Erginus"
msgstr "エルギヌス"

#: data/nomenclature.fab:26618
msgctxt "origin"
msgid ""
"Argonaut, son of Neptune, helmsman of the Argo after the death of Tiphys."
msgstr "アルゴ号の乗組員、ネプチューンの息子、ティピュスの死後はアルゴ号の操舵手となった。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Theiodamas/Theodamas, king of the
#. Dryopes.
#: data/nomenclature.fab:26620
msgctxt "crater"
msgid "Hylas"
msgstr "ヒラス"

#: data/nomenclature.fab:26620
msgctxt "origin"
msgid "Argonaut, son of Theiodamas/Theodamas, king of the Dryopes."
msgstr "アルゴ号の乗組員、ドリオペスの王テイオダマス/テオダマスの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Apollo and the nymph Cyrene, or of
#. Abas, a prophet.
#: data/nomenclature.fab:26622
msgctxt "crater"
msgid "Idmon"
msgstr "イドモン"

#: data/nomenclature.fab:26622
msgctxt "origin"
msgid "Argonaut, son of Apollo and the nymph Cyrene, or of Abas, a prophet."
msgstr "アルゴ号の乗組員、アポロとニンフのキレネの息子、またはアバスの息子、預言者。"

#. TRANSLATORS: (Phoebe); The leading argonaut, son of the Thessalian king
#. Aeson, delivered the Fleece.
#: data/nomenclature.fab:26624
msgctxt "crater"
msgid "Jason"
msgstr "イアソン"

#: data/nomenclature.fab:26624
msgctxt "origin"
msgid ""
"The leading argonaut, son of the Thessalian king Aeson, delivered the "
"Fleece."
msgstr "アルゴ号の乗組員のリーダー、テッサリア王アイソンの息子、羊毛を届けた。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Eurytus, Jason's host during his
#. consultation with the Oracle at Delphi.
#: data/nomenclature.fab:26626
msgctxt "crater"
msgid "Iphitus"
msgstr "イフィトス"

#: data/nomenclature.fab:26626
msgctxt "origin"
msgid ""
"Argonaut, son of Eurytus, Jason's host during his consultation with the "
"Oracle at Delphi."
msgstr "アルゴ号の乗組員、エウリトスの息子。デルフィで神託者と相談していたイアソンをホストした。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Aeacus, father of Achilles.
#: data/nomenclature.fab:26628
msgctxt "crater"
msgid "Peleus"
msgstr "ペレウス"

#: data/nomenclature.fab:26628
msgctxt "origin"
msgid "Argonaut, son of Aeacus, father of Achilles."
msgstr "アルゴ号の乗組員、アエアコスの息子、アキレスの父。"

#. TRANSLATORS: (Phoebe); Argonaut, prophesying son of Apollo.
#: data/nomenclature.fab:26630
msgctxt "crater"
msgid "Mopsus"
msgstr "モプサス"

#: data/nomenclature.fab:26630
msgctxt "origin"
msgid "Argonaut, prophesying son of Apollo."
msgstr "アルゴ号の乗組員、アポロの息子、預言者。"

#. TRANSLATORS: (Phoebe); Argonaut, king of the Locrians, renowned for his
#. courage in battle.
#: data/nomenclature.fab:26632
msgctxt "crater"
msgid "Oileus"
msgstr "オイレウス"

#: data/nomenclature.fab:26632
msgctxt "origin"
msgid "Argonaut, king of the Locrians, renowned for his courage in battle."
msgstr "アルゴ号の乗組員、ロクリア人の王、戦闘での勇猛さで有名。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Dionysus.
#: data/nomenclature.fab:26634
msgctxt "crater"
msgid "Phlias"
msgstr "フィリアス"

#: data/nomenclature.fab:26634
msgctxt "origin"
msgid "Argonaut, son of Dionysus."
msgstr "アルゴ号の乗組員、ディオニソスの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Teleon, or of Bias and Pero.
#: data/nomenclature.fab:26636
msgctxt "crater"
msgid "Talaus"
msgstr "タラウス"

#: data/nomenclature.fab:26636
msgctxt "origin"
msgid "Argonaut, son of Teleon, or of Bias and Pero."
msgstr "アルゴ号の乗組員、テロンの、またはビアスとペロの息子。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Aeacus, took part in the Calydonian
#. boar hunt.
#: data/nomenclature.fab:26638
msgctxt "crater"
msgid "Telamon"
msgstr "タラモン"

#: data/nomenclature.fab:26638
msgctxt "origin"
msgid "Argonaut, son of Aeacus, took part in the Calydonian boar hunt."
msgstr "アルゴ号の乗組員、アエアコスの息子で、カリドニアの猪狩りに参加した。"

#. TRANSLATORS: (Phoebe); Argonaut, son of Boreas, the north wind.
#: data/nomenclature.fab:26640
msgctxt "crater"
msgid "Zetes"
msgstr "ゼテス"

#. TRANSLATORS: (Phoebe); Daughter of Phoebe in Greek mythology.
#: data/nomenclature.fab:26642
msgctxt "regio"
msgid "Leto Regio"
msgstr "レト地域"

#: data/nomenclature.fab:26642
msgctxt "origin"
msgid "Daughter of Phoebe in Greek mythology."
msgstr "ギリシャ神話ではフェーベの娘。"

#. TRANSLATORS: (Pluto); Ernest Clare; American astronomer who calculated one
#. of the first independent orbits of Pluto, shortly after that planet’s 1930
#. discovery by Lowell Observatory’s Clyde Tombaugh (1890-1964).
#: data/nomenclature.fab:26644
msgctxt "crater"
msgid "Bower"
msgstr "バウアー"

#: data/nomenclature.fab:26644
msgctxt "origin"
msgid ""
"Ernest Clare; American astronomer who calculated one of the first "
"independent orbits of Pluto, shortly after that planet’s 1930 discovery by "
"Lowell Observatory’s Clyde Tombaugh (1890-1964)."
msgstr ""
"アーネスト・クレア; アメリカの天文学者(1890-1964) "
"。1930年にローウェル天文台のクライド・トンボーが冥王星を発見した直後、冥王星の最初の独立した軌道の1つを計算した。"

#. TRANSLATORS: (Pluto); Paolo; Italian planetary scientist who conducted
#. critical investigations of the formation and collisional evolution of small
#. bodies, satellites, and space debris, including Kuiper Belt objects
#. (1953-2000).
#: data/nomenclature.fab:26646
msgctxt "crater"
msgid "Farinella"
msgstr "ファリネッラ"

#: data/nomenclature.fab:26646
msgctxt "origin"
msgid ""
"Paolo; Italian planetary scientist who conducted critical investigations of "
"the formation and collisional evolution of small bodies, satellites, and "
"space debris, including Kuiper Belt objects (1953-2000)."
msgstr ""
"パオロ; イタリアの惑星科学者 (1953-2000) "
"。カイパーベルト天体を含む小天体、衛星、スペースデブリの形成と衝突進化に関する重要な研究を行った。"

#. TRANSLATORS: (Pluto); William C.; Original Science Payload Manager of the
#. New Horizons mission to Pluto and the Kuiper Belt (1945-2017).
#: data/nomenclature.fab:26648
msgctxt "crater"
msgid "Gibson"
msgstr "ギブソン"

#: data/nomenclature.fab:26648
msgctxt "origin"
msgid ""
"William C.; Original Science Payload Manager of the New Horizons mission to "
"Pluto and the Kuiper Belt (1945-2017)."
msgstr ""
"ウィリアム・C ; 冥王星とカイパーベルトを探査するニュー・ホライズンズのミッションにおけるオリジナル・サイエンス・ペイロード・マネージャー "
"(1945-2017) 。"

#. TRANSLATORS: (Pluto); Henry L.; astronomer at Lowell Observatory, who
#. obtained early photographic plates that remain critical to determination of
#. Pluto’s orbit (1910-2007).
#: data/nomenclature.fab:26650
msgctxt "crater"
msgid "Giclas"
msgstr "ギクラス"

#: data/nomenclature.fab:26650
msgctxt "origin"
msgid ""
"Henry L.; astronomer at Lowell Observatory, who obtained early photographic "
"plates that remain critical to determination of Pluto’s orbit (1910-2007)."
msgstr ""
"ヘンリー・L ; ローウェル天文台所属の天文学者 (1910-2007) 。冥王星の軌道の決定に依然として不可欠である初期の写真乾板を入手した。"

#. TRANSLATORS: (Pluto); Bishun; Indian-born American atmosphere chemistry
#. scientist, investigated, in particular, tholins, the organic molecules that
#. probably account for the darkest regions on Pluto (1933–2013).
#: data/nomenclature.fab:26652
msgctxt "crater"
msgid "Khare"
msgstr "カレ"

#: data/nomenclature.fab:26652
msgctxt "origin"
msgid ""
"Bishun; Indian-born American atmosphere chemistry scientist, investigated, "
"in particular, tholins, the organic molecules that probably account for the "
"darkest regions on Pluto (1933–2013)."
msgstr "インド生まれのアメリカ人大気化学者 (1933–2013) 。特に、冥王星の最も暗い領域を占めると考えられる有機分子のソリンを調査した。"

#. TRANSLATORS: (Pluto); Rolan; Georgian (Caucasus) astronomer. Investigated
#. the dynamics, astrometry and photometry of Pluto (1931–2010).
#: data/nomenclature.fab:26654
msgctxt "crater"
msgid "Kiladze"
msgstr "キラドゥゼ"

#: data/nomenclature.fab:26654
msgctxt "origin"
msgid ""
"Rolan; Georgian (Caucasus) astronomer. Investigated the dynamics, astrometry"
" and photometry of Pluto (1931–2010)."
msgstr "ロラン; ジョージア (コーカサス地方) の天文学者 (1931–2010)。冥王星の運動の研究、位置観測、測光観測を行った。"

#. TRANSLATORS: (Pluto); Damon; American astronomer; investigated the
#. formation history of Pluto (1959–2004).
#: data/nomenclature.fab:26656
msgctxt "crater"
msgid "Simonelli"
msgstr "シモネリ"

#: data/nomenclature.fab:26656
msgctxt "origin"
msgid ""
"Damon; American astronomer; investigated the formation history of Pluto "
"(1959–2004)."
msgstr "デイモン; アメリカの天文学者 (1959–2004) 。冥王星の形成過程を調査した。"

#. TRANSLATORS: (Pluto); Thomas Boyd; American mechanical/space engineer,
#. first project manager of the New Horizons mission to Pluto and the Kuiper
#. Belt (1941–2014).
#: data/nomenclature.fab:26658
msgctxt "crater"
msgid "Coughlin"
msgstr "コフリン"

#: data/nomenclature.fab:26658
msgctxt "origin"
msgid ""
"Thomas Boyd; American mechanical/space engineer, first project manager of "
"the New Horizons mission to Pluto and the Kuiper Belt (1941–2014)."
msgstr ""
"トーマス・ボイド; アメリカの機械/宇宙工学者 (1941–2014) "
"。冥王星とカイパーベルトへ向かうニュー・ホライズンズ計画での最初のプロジェクトマネージャー。"

#. TRANSLATORS: (Pluto); Robert H.; American astronomer, co-discoverer (1955)
#. of Pluto’s 6.4-day rotation period (1923–1989).
#: data/nomenclature.fab:26660
msgctxt "crater"
msgid "Hardie"
msgstr "ハーディ"

#: data/nomenclature.fab:26660
msgctxt "origin"
msgid ""
"Robert H.; American astronomer, co-discoverer (1955) of Pluto’s 6.4-day "
"rotation period (1923–1989)."
msgstr "ロバート・H; アメリカの天文学者 (1923–1989) 、冥王星の自転周期6.4日の共同発見者 (1955年) 。"

#. TRANSLATORS: (Pluto); Lisa; Led the development of the RALPH instrument,
#. the visual and infrared imager and spectrometer on the New Horizons
#. spacecraft (1966-2017).
#: data/nomenclature.fab:26662
msgctxt "crater"
msgid "Hardaway"
msgstr "ハーダウェイ"

#: data/nomenclature.fab:26662
msgctxt "origin"
msgid ""
"Lisa; Led the development of the RALPH instrument, the visual and infrared "
"imager and spectrometer on the New Horizons spacecraft (1966-2017)."
msgstr "リサ; ニューホライズンズ探査機の可視光および赤外線撮像および分光装置であるRALPH機器の開発を主導した (1966-2017) 。"

#. TRANSLATORS: (Pluto); Carl; German physicist, inventor of the blink
#. comparator which Clyde Tombaugh used for discovery of Pluto (1858-1927).
#: data/nomenclature.fab:26664
msgctxt "crater"
msgid "Pulfrich"
msgstr "プルフリッヒ"

#: data/nomenclature.fab:26664
msgctxt "origin"
msgid ""
"Carl; German physicist, inventor of the blink comparator which Clyde "
"Tombaugh used for discovery of Pluto (1858-1927)."
msgstr "カール; ドイツの物理学者、クライド・トンボーが冥王星の発見に使用したブリンク・コンパレータの発明者 (1858-1927) 。"

#. TRANSLATORS: (Pluto); Francesco; Italian astronomer who carried out early
#. studies of the orbit of Pluto (1900-1976).
#: data/nomenclature.fab:26666
msgctxt "crater"
msgid "Zagar"
msgstr "ザガル"

#: data/nomenclature.fab:26666
msgctxt "origin"
msgid ""
"Francesco; Italian astronomer who carried out early studies of the orbit of "
"Pluto (1900-1976)."
msgstr "フランチェスコ; イタリアの天文学者 (1900-1976) 。初期の冥王星軌道の研究を行った。"

#. TRANSLATORS: (Pluto); Kenneth; Irish astronomer, the first to propose the
#. existence of a disk of bodies beyond the orbit of Neptune, now known as the
#. Edgeworth-Kuiper Belt (1880-1972).
#. TRANSLATORS: (Venus); Maria; Irish writer (1767-1849).
#: data/nomenclature.fab:26668 data/nomenclature.fab:29820
msgctxt "crater"
msgid "Edgeworth"
msgstr "エッジワース"

#: data/nomenclature.fab:26668
msgctxt "origin"
msgid ""
"Kenneth; Irish astronomer, the first to propose the existence of a disk of "
"bodies beyond the orbit of Neptune, now known as the Edgeworth-Kuiper Belt "
"(1880-1972)."
msgstr ""
"ケネス; アイルランドの天文学者。現在エッジワース・カイパーベルトとして知られる、海王星の軌道の外に円盤状の天体が存在することを最初に提唱した "
"(1880-1972) 。"

#. TRANSLATORS: (Pluto); Jan Hendrik, Dutch astronomer, first described the
#. Oort Cloud, a theoretical cloud of icy planetesimals beyond the Kuiper
#. Belt, and believed to be the source of long- period comets (1900 to 1992).
#: data/nomenclature.fab:26670
msgctxt "crater"
msgid "Oort"
msgstr "オールト"

#: data/nomenclature.fab:26670
msgctxt "origin"
msgid ""
"Jan Hendrik, Dutch astronomer, first described the Oort Cloud, a theoretical"
" cloud of icy planetesimals beyond the Kuiper Belt, and believed to be the "
"source of long- period comets (1900 to 1992)."
msgstr ""
"ヤン・ヘンドリック; オランダの天文学者 (1900-1992) "
"。オールトの雲を最初に言及した人。オールトの雲はカイパーベルトの先にある氷の微惑星からなる理論上の雲で、また長周期彗星の源であると考えられている。"

#. TRANSLATORS: (Pluto); James; American astronomer, discoverer of the
#. atmosphere of Pluto (1943–2011).
#: data/nomenclature.fab:26672
msgctxt "crater"
msgid "Elliot"
msgstr "エリオット"

#: data/nomenclature.fab:26672
msgctxt "origin"
msgid ""
"James; American astronomer, discoverer of the atmosphere of Pluto "
"(1943–2011)."
msgstr "ジェームズ。アメリカの天文学者 (1943–2011) 。冥王星の大気を発見した。"

#. TRANSLATORS: (Pluto); Venetia; British schoolgirl, who suggested in 1930
#. the name “Pluto” for Tombaugh’s newly discovered planet (1918–2009).
#: data/nomenclature.fab:26674
msgctxt "crater"
msgid "Burney"
msgstr "バーニー"

#: data/nomenclature.fab:26674
msgctxt "origin"
msgid ""
"Venetia; British schoolgirl, who suggested in 1930 the name “Pluto” for "
"Tombaugh’s newly discovered planet (1918–2009)."
msgstr ""
"ベニシア; イギリスの女子学生 (1918–2009) 。1930年にトンボーが新たに発見した惑星に\"Pluto\"「冥王星」という名前を提案した。"

#. TRANSLATORS: (Pluto); Charles T.; American astronomer and discoverer of
#. 2060 Chiron (1940-2011).
#: data/nomenclature.fab:26676
msgctxt "crater"
msgid "Kowal"
msgstr "コワル"

#: data/nomenclature.fab:26676
msgctxt "origin"
msgid ""
"Charles T.; American astronomer and discoverer of 2060 Chiron (1940-2011)."
msgstr "チャールズ・T; アメリカの天文学者 (1940-2011) 。小惑星2060番キロンを発見した。"

#. TRANSLATORS: (Pluto); Angioletta; Italian planetary scientist (1946-2011).
#: data/nomenclature.fab:26678
msgctxt "crater"
msgid "Coradini"
msgstr "コラディーニ"

#: data/nomenclature.fab:26678
msgctxt "origin"
msgid "Angioletta; Italian planetary scientist (1946-2011)."
msgstr "アンジョレッタ; イタリアの惑星科学者 (1946-2011) 。"

#. TRANSLATORS: (Pluto); An Icelandic volcano believed to be the entrance to
#. Hell in medieval European times.
#: data/nomenclature.fab:26680
msgctxt "cavus"
msgid "Hekla Cavus"
msgstr "ヘクラ不規則凹地"

#: data/nomenclature.fab:26680
msgctxt "origin"
msgid ""
"An Icelandic volcano believed to be the entrance to Hell in medieval "
"European times."
msgstr "中世ヨーロッパでは地獄の入口だと信じられていたアイスランドの火山。"

#. TRANSLATORS: (Pluto); Underworld in Inuit myths.
#: data/nomenclature.fab:26682
msgctxt "cavus"
msgid "Adlivun Cavus"
msgstr "アドリヴン不規則凹地"

#: data/nomenclature.fab:26682
msgctxt "origin"
msgid "Underworld in Inuit myths."
msgstr "イヌイットの神話での冥界。"

#. TRANSLATORS: (Pluto); First fully operational US space shuttle, launched
#. first on April 12, 1981, and lost during re-entry on February 1, 2003.
#: data/nomenclature.fab:26684
msgctxt "collis"
msgid "Columbia Colles"
msgstr "コロンビア丘"

#: data/nomenclature.fab:26684
msgctxt "origin"
msgid ""
"First fully operational US space shuttle, launched first on April 12, 1981, "
"and lost during re-entry on February 1, 2003."
msgstr "完全に運用可能な最初の米国スペースシャトル。1981年4月12日に初めて打ち上げられ、2003年2月1日の再突入中に失われた。"

#. TRANSLATORS: (Pluto); Second fully operational US Space Shuttle, first
#. launched on April 4, 1983. It was lost during its tenth launch on January
#. 28, 1986.
#: data/nomenclature.fab:26686
msgctxt "collis"
msgid "Challenger Colles"
msgstr "チャレンジャー丘"

#: data/nomenclature.fab:26686
msgctxt "origin"
msgid ""
"Second fully operational US Space Shuttle, first launched on April 4, 1983. "
"It was lost during its tenth launch on January 28, 1986."
msgstr ""
"完全に運用可能な2番目の米国スペースシャトル。1983年4月4日に初めて打ち上げられた。1986年1月28日の10回目の打ち上げ中に失われた。"

#. TRANSLATORS: (Pluto); The deepest, darkest pit of the Underworld in Greek
#. mythology.
#: data/nomenclature.fab:26688
msgctxt "dorsum"
msgid "Tartarus Dorsa"
msgstr "タルタルス尾根"

#: data/nomenclature.fab:26688
msgctxt "origin"
msgid "The deepest, darkest pit of the Underworld in Greek mythology."
msgstr "ギリシャ神話に登場する冥界にある最も深く、最も暗い穴。"

#. TRANSLATORS: (Pluto); Nyanga (Eastern Dem. Rep. Congo/Zaire) epic hero who
#. travelled to the underworld and after returning home became a wise and
#. powerful king.
#: data/nomenclature.fab:26690
msgctxt "fossa"
msgid "Mwindo Fossae"
msgstr "ムウィンド地溝帯"

#: data/nomenclature.fab:26690
msgctxt "origin"
msgid ""
"Nyanga (Eastern Dem. Rep. Congo/Zaire) epic hero who travelled to the "
"underworld and after returning home became a wise and powerful king."
msgstr "ンヤンガ族 (コンゴ民主共和国/ザイールの東部) の英雄。冥界へ旅し、戻ってから賢く力強い王になった。"

#. TRANSLATORS: (Pluto); Epic hero of the Chochenyo/Ohlone (N. California)
#. mythology, an anthropomorphic being resembling a peregrine falcon, who
#. traveled to the underworld to battle Wiwe (“Body of Stone”), the lord of
#. the underworld.
#: data/nomenclature.fab:26692
msgctxt "fossa"
msgid "Kaknú Fossa"
msgstr "カクヌー地溝帯"

#: data/nomenclature.fab:26692
msgctxt "origin"
msgid ""
"Epic hero of the Chochenyo/Ohlone (N. California) mythology, an "
"anthropomorphic being resembling a peregrine falcon, who traveled to the "
"underworld to battle Wiwe (“Body of Stone”), the lord of the underworld."
msgstr ""
"チョチェニョ/オローネ族 (北カリフォルニア) の神話の壮大な英雄、ハヤブサに似た擬人化された存在。冥界の主ウィウェ (「石の体」の意味) "
"と戦うために冥界へ旅立った。"

#. TRANSLATORS: (Pluto); Son of Odin, who rode the horse Sleipnir into the
#. underworld to retrieve his brother, Balder.
#: data/nomenclature.fab:26694
msgctxt "fossa"
msgid "Hermod Fossae"
msgstr "ヘルモード地溝帯"

#: data/nomenclature.fab:26694
msgctxt "origin"
msgid ""
"Son of Odin, who rode the horse Sleipnir into the underworld to retrieve his"
" brother, Balder."
msgstr "オーディンの息子で、兄バルドルを取り戻すために馬スレイプニルに乗って冥界へ赴いた。"

#. TRANSLATORS: (Pluto); Zulu tale hero, who followed a porcupine underground
#. and came upon the village of dead souls.
#: data/nomenclature.fab:26696
msgctxt "fossa"
msgid "Uncama Fossa"
msgstr "ウンカマ地溝帯"

#: data/nomenclature.fab:26696
msgctxt "origin"
msgid ""
"Zulu tale hero, who followed a porcupine underground and came upon the "
"village of dead souls."
msgstr "ズールー族の物語の英雄。地下でヤマアラシを追い、死んだ魂の村にやって来た。"

#. TRANSLATORS: (Pluto); In The Inferno by Dante, Beatrice descends into hell
#. to find Virgil and ask him to guide Dante. She later guides Dante through
#. Paradise in Paradiso.
#: data/nomenclature.fab:26698
msgctxt "fossa"
msgid "Beatrice Fossa"
msgstr "ベアトリーチェ地溝帯"

#: data/nomenclature.fab:26698
msgctxt "origin"
msgid ""
"In The Inferno by Dante, Beatrice descends into hell to find Virgil and ask "
"him to guide Dante. She later guides Dante through Paradise in Paradiso."
msgstr "ダンテの『神曲』地獄篇では、ベアトリーチェが地獄に降りてヴァージルを見つけ、ダンテを導いてくれるように頼む。天国篇ではダンテを天国へ導く。"

#. TRANSLATORS: (Pluto); Inanna was the Queen of Heaven in ancient Sumerian
#. mythology. She visited the Underworld but was permitted to return in
#. exchange for the life of her husband, Dumuzi.
#: data/nomenclature.fab:26700
msgctxt "fossa"
msgid "Inanna Fossa"
msgstr "イナンナ地溝帯"

#: data/nomenclature.fab:26700
msgctxt "origin"
msgid ""
"Inanna was the Queen of Heaven in ancient Sumerian mythology. She visited "
"the Underworld but was permitted to return in exchange for the life of her "
"husband, Dumuzi."
msgstr "イナンナは古代シュメール神話に登場する天界の女王。彼女は冥界を訪れ、夫ドゥムジの命と引き換えに帰還を許された。"

#. TRANSLATORS: (Pluto); In ancient Sumerian mythology, Dumuzi was a god of
#. the harvest. He was taken down into the Underworld, but permitted to return
#. to earth for half of each year, resulting in the cycle of the seasons.
#: data/nomenclature.fab:26702
msgctxt "fossa"
msgid "Dumuzi Fossa"
msgstr "ドゥムジ地溝帯"

#: data/nomenclature.fab:26702
msgctxt "origin"
msgid ""
"In ancient Sumerian mythology, Dumuzi was a god of the harvest. He was taken"
" down into the Underworld, but permitted to return to earth for half of each"
" year, resulting in the cycle of the seasons."
msgstr ""
"古代シュメール神話ではドゥムジは収穫の神だった。彼は冥界に連れて行かれたが、一年の半分は地上に戻ることが許された。その結果、季節が生まれた。"

#. TRANSLATORS: (Pluto); Italian; Dante’s guide through Hell and Purgatory in
#. the Divine Comedy of Dante Alighieri (1265–1321).
#: data/nomenclature.fab:26704
msgctxt "fossa"
msgid "Virgil Fossae"
msgstr "ヴァージル地溝帯"

#: data/nomenclature.fab:26704
msgctxt "origin"
msgid ""
"Italian; Dante’s guide through Hell and Purgatory in the Divine Comedy of "
"Dante Alighieri (1265–1321)."
msgstr "イタリア人; ダンテ・アリギエーリ作『神曲』の地獄編と煉獄編に登場するダンテを教導する人物 (1265–1321) 。"

#. TRANSLATORS: (Pluto); Ancestral beings in Yolngu (Australia) myth who
#. traveled between the island of the dead and Australia.
#: data/nomenclature.fab:26706
msgctxt "fossa"
msgid "Djanggawul Fossae"
msgstr "ジャンガウウル地溝帯"

#: data/nomenclature.fab:26706
msgctxt "origin"
msgid ""
"Ancestral beings in Yolngu (Australia) myth who traveled between the island "
"of the dead and Australia."
msgstr "ヨルング (オーストラリア) の神話に登場し、死者の島とオーストラリアの間を旅した祖先の存在。"

#. TRANSLATORS: (Pluto); A powerful, eight-legged horse in Norse mythology who
#. carried Odin into the Underworld.
#: data/nomenclature.fab:26708
msgctxt "fossa"
msgid "Sleipnir Fossa"
msgstr "スレイプニル地溝帯"

#: data/nomenclature.fab:26708
msgctxt "origin"
msgid ""
"A powerful, eight-legged horse in Norse mythology who carried Odin into the "
"Underworld."
msgstr "北欧神話に登場し、オーディンを冥界へ連れて行った強力な8本足の馬。"

#. TRANSLATORS: (Pluto); A bottomless lake, one of the entrances to the
#. underworld in Greek mythology.
#: data/nomenclature.fab:26710
msgctxt "lacus"
msgid "Alcyonia Lacus"
msgstr "アルキオニア湖"

#: data/nomenclature.fab:26710
msgctxt "origin"
msgid ""
"A bottomless lake, one of the entrances to the underworld in Greek "
"mythology."
msgstr "ギリシャ神話に登場する冥界への入口の一つである底なしの湖。"

#. TRANSLATORS: (Pluto); First Japanese spacecraft to the Moon, 1990.
#: data/nomenclature.fab:26712
msgctxt "linea"
msgid "Hiten Linea"
msgstr "ヒテン線紋"

#: data/nomenclature.fab:26712
msgctxt "origin"
msgid "First Japanese spacecraft to the Moon, 1990."
msgstr "1990年に日本で最初に月へ行った探査機。"

#. TRANSLATORS: (Pluto); A series of seven unmanned U.S. probes to the lunar
#. surface, 1966-1968.
#: data/nomenclature.fab:26714
msgctxt "linea"
msgid "Surveyor Linea"
msgstr "サーベイヤー線紋"

#: data/nomenclature.fab:26714
msgctxt "origin"
msgid ""
"A series of seven unmanned U.S. probes to the lunar surface, 1966-1968."
msgstr "1966年から1968年にかけて行われた、米国による月面への無人探査機7機のシリーズ。"

#. TRANSLATORS: (Pluto); A series of eight unmanned Soviet lunar and
#. interplanetary probes, 1964–1970.
#: data/nomenclature.fab:26716
msgctxt "linea"
msgid "Zond Linea"
msgstr "ゾンド線紋"

#: data/nomenclature.fab:26716
msgctxt "origin"
msgid ""
"A series of eight unmanned Soviet lunar and interplanetary probes, "
"1964–1970."
msgstr "1964年から1970年にかけて行われたソ連の無人月探査機および惑星間探査機8機のシリーズ。"

#. TRANSLATORS: (Pluto); A series of Indian lunar probes, beginning in 2008.
#: data/nomenclature.fab:26718
msgctxt "linea"
msgid "Chandrayaan Linea"
msgstr "チャンドラヤーン線紋"

#: data/nomenclature.fab:26718
msgctxt "origin"
msgid "A series of Indian lunar probes, beginning in 2008."
msgstr "2008年に始まったインドの月探査シリーズ。"

#. TRANSLATORS: (Pluto); A series of 24 unmanned Soviet lunar probes launched
#. between 1959 and 1976.
#: data/nomenclature.fab:26720
msgctxt "linea"
msgid "Luna Linea"
msgstr "ルナ線紋"

#: data/nomenclature.fab:26720
msgctxt "origin"
msgid ""
"A series of 24 unmanned Soviet lunar probes launched between 1959 and 1976."
msgstr "1959年から1976年にかけて打ち上げられたソ連の無人月探査機24機のシリーズ。"

#. TRANSLATORS: (Pluto); A series of Chinese lunar probes, beginning in 2013.
#: data/nomenclature.fab:26722
msgctxt "linea"
msgid "Yutu Linea"
msgstr "イートゥー線紋"

#: data/nomenclature.fab:26722
msgctxt "origin"
msgid "A series of Chinese lunar probes, beginning in 2013."
msgstr "玉兔; 2013年に始まった中国の月探査シリーズ。"

#. TRANSLATORS: (Pluto); Jeanne Baret (Baré); first woman to have completed
#. circumnavigation voyage of the globe (1740-1807).
#: data/nomenclature.fab:26724
msgctxt "mons"
msgid "Baret Montes"
msgstr "バレ山脈"

#: data/nomenclature.fab:26724
msgctxt "origin"
msgid ""
"Jeanne Baret (Baré); first woman to have completed circumnavigation voyage "
"of the globe (1740-1807)."
msgstr "ジャンヌ・バレ (BaretまたはBaré) ; 女性として初めて世界一周航海を達成した (1740-1807) 。"

#. TRANSLATORS: (Pluto); Orville (1871–1948) and Wilbur (1867–1912), brothers,
#. U.S. aviation pioneers who invented, built, and flew in 1903 the world’s
#. first successful powered heavier-than-air flying machine (airplane) with a
#. pilot aboard.
#: data/nomenclature.fab:26726
msgctxt "mons"
msgid "Wright Mons"
msgstr "ライト山"

#: data/nomenclature.fab:26726
msgctxt "origin"
msgid ""
"Orville (1871–1948) and Wilbur (1867–1912), brothers, U.S. aviation pioneers"
" who invented, built, and flew in 1903 the world’s first successful powered "
"heavier-than-air flying machine (airplane) with a pilot aboard."
msgstr ""
"オリヴィー (1871-1948) とウィルバー (1867-1912) の兄弟。パイロットを乗せて動力を与えて空気より重い飛行機械 (飛行機) "
"を発明、製造し、1903年に世界初の飛行を成功させた米国航空の先駆者。"

#. TRANSLATORS: (Pluto); Auguste; Swiss-Belgian inventor and physicist known
#. for his pioneering balloon flights into the Earth’s upper atmosphere up to
#. 17 km (1884–1962).
#: data/nomenclature.fab:26728
msgctxt "mons"
msgid "Piccard Mons"
msgstr "ピカール山"

#: data/nomenclature.fab:26728
msgctxt "origin"
msgid ""
"Auguste; Swiss-Belgian inventor and physicist known for his pioneering "
"balloon flights into the Earth’s upper atmosphere up to 17 km (1884–1962)."
msgstr "オーギュスト; スイスとベルギーの発明家で物理学者 (1884–1962) 。地球の上層大気圏17kmまでの先駆的な気球飛行で知られる。"

#. TRANSLATORS: (Pluto); Antonio; Italian scholar and explorer, whose journal
#. is the only original description of the discoveries made during the first
#. circumnavigation of the Earth which started in Spain in 1519 under the
#. leadership of Magellan (c.1491 – c.1531).
#: data/nomenclature.fab:26730
msgctxt "mons"
msgid "Pigafetta Montes"
msgstr "ピガフェッタ山脈"

#: data/nomenclature.fab:26730
msgctxt "origin"
msgid ""
"Antonio; Italian scholar and explorer, whose journal is the only original "
"description of the discoveries made during the first circumnavigation of the"
" Earth which started in Spain in 1519 under the leadership of Magellan "
"(c.1491 – c.1531)."
msgstr ""
"アントニオ; イタリアの学者、探検家 (1491年頃-1531年頃) "
"。彼の日記は1519年にマゼランの指揮のもとスペインで始まった初の地球周回航海中になされた発見についての唯一オリジナルの記述になる。"

#. TRANSLATORS: (Pluto); Juan Sebastián; Spanish explorer of Basque origin,
#. who completed in 1522 the first circumnavigation of the Earth which started
#. in 1519 under the leadership of Magellan (c.1476–1526).
#: data/nomenclature.fab:26732
msgctxt "mons"
msgid "Elcano Montes"
msgstr "エルカーノ山脈"

#: data/nomenclature.fab:26732
msgctxt "origin"
msgid ""
"Juan Sebastián; Spanish explorer of Basque origin, who completed in 1522 the"
" first circumnavigation of the Earth which started in 1519 under the "
"leadership of Magellan (c.1476–1526)."
msgstr ""
"フアン・セバスティアン; バスク出身のスペイン人探検家 (1476年頃-1526年) "
"。マゼランの指揮下、1519年に始まった初の地球一周航海を1522年に完遂した。"

#. TRANSLATORS: (Pluto); Edmund; New Zealand mountaineer (1919–2008).
#: data/nomenclature.fab:26734
msgctxt "mons"
msgid "Hillary Montes"
msgstr "ヒラリー山脈"

#: data/nomenclature.fab:26734
msgctxt "origin"
msgid "Edmund; New Zealand mountaineer (1919–2008)."
msgstr "エドモンド; ニュージーランドの登山家 (1919–2008) 。"

#. TRANSLATORS: (Pluto); Junko Tabei, Japanese mountaineer and the first woman
#. to climb both Mount Everest and the Seven Summits (1939–2016).
#: data/nomenclature.fab:26736
msgctxt "mons"
msgid "Tabei Montes"
msgstr "タベイ山脈"

#: data/nomenclature.fab:26736
msgctxt "origin"
msgid ""
"Junko Tabei, Japanese mountaineer and the first woman to climb both Mount "
"Everest and the Seven Summits (1939–2016)."
msgstr "田部井淳子 (1939–2016) 。日本の登山家で、エベレストと七大陸最高峰の両方に登った最初の女性。"

#. TRANSLATORS: (Pluto); Ash-Sharīf al-Idrīsī; Arabian mapmaker and geographer
#. (1100–1165/66).
#: data/nomenclature.fab:26738
msgctxt "mons"
msgid "Al-Idrisi Montes"
msgstr "アル=イドリーシー山脈"

#: data/nomenclature.fab:26738
msgctxt "origin"
msgid "Ash-Sharīf al-Idrīsī; Arabian mapmaker and geographer (1100–1165/66)."
msgstr "アッシュ=シャリフ・アル=イドリーシー; アラビアの地図作成者および地理学者 (1100–1165/66) 。"

#. TRANSLATORS: (Pluto); Zheng He, Chinese explorer, led voyages of Asia,
#. Africa, and the Middle East (1371 to 1433).
#: data/nomenclature.fab:26740
msgctxt "mons"
msgid "Zheng He Montes"
msgstr "チェン・ヘー山脈"

#: data/nomenclature.fab:26740
msgctxt "origin"
msgid ""
"Zheng He, Chinese explorer, led voyages of Asia, Africa, and the Middle East"
" (1371 to 1433)."
msgstr "鄭和、中国人の探検家、アジア、アフリカ、中東の航海を率いた (1371-1433) 。"

#. TRANSLATORS: (Pluto); Tenzing Norgay; Nepalese (Sherpa) mountaineer
#. (1914–1986).
#: data/nomenclature.fab:26742
msgctxt "mons"
msgid "Tenzing Montes"
msgstr "テンジン山脈"

#: data/nomenclature.fab:26742
msgctxt "origin"
msgid "Tenzing Norgay; Nepalese (Sherpa) mountaineer (1914–1986)."
msgstr "テンジン・ノルゲイ; ネパール人 (シェルパ) の登山家 (1914–1986) 。"

#. TRANSLATORS: (Pluto); Elizabeth “Bessie”; early American aviator and the
#. first woman of African-American and Native American descent to earn a
#. pilot’s license (1892-1926).
#: data/nomenclature.fab:26744
msgctxt "mons"
msgid "Coleman Mons"
msgstr "コールマン山"

#: data/nomenclature.fab:26744
msgctxt "origin"
msgid ""
"Elizabeth “Bessie”; early American aviator and the first woman of African-"
"American and Native American descent to earn a pilot’s license (1892-1926)."
msgstr ""
"エリザベス・「ベッシー」; 初期のアメリカ人飛行家で、パイロットの免許を取得したアフリカ系アメリカ人およびネイティブ・アメリカンの子孫である最初の女性 "
"(1892-1926) 。"

#. TRANSLATORS: (Pluto); Korean traveler and scholar, who crossed the Asian
#. continent from China to Arabia and back (724-727), and documented the
#. journey in his journals (704–787).
#: data/nomenclature.fab:26746
msgctxt "palus"
msgid "Hyecho Palus"
msgstr "ヘチョ沼"

#: data/nomenclature.fab:26746
msgctxt "origin"
msgid ""
"Korean traveler and scholar, who crossed the Asian continent from China to "
"Arabia and back (724-727), and documented the journey in his journals "
"(704–787)."
msgstr ""
"慧超; 朝鮮の旅行者、学者 (704年-787年) 。中国からアラビアまでアジア大陸を横断、往復 (724年-727年) 、また日記を残した。"

#. TRANSLATORS: (Pluto); A series of US space probes sent to the Moon during
#. 1961-1965. In 1964, Ranger 7 obtained the first close-up images of an
#. extraterrestrial surface.
#: data/nomenclature.fab:26748
msgctxt "planitia"
msgid "Ranger Planitia"
msgstr "レンジャー平原"

#: data/nomenclature.fab:26748
msgctxt "origin"
msgid ""
"A series of US space probes sent to the Moon during 1961-1965. In 1964, "
"Ranger 7 obtained the first close-up images of an extraterrestrial surface."
msgstr ""
"1961年から1965年にかけて月へ送られた一連の米国の宇宙探査機。1964年にレンジャー7号で地球以外の天体の表面の最初のクローズアップ画像を得た。"

#. TRANSLATORS: (Pluto); Two Soviet Union planetary rovers that were sent to
#. the surface of the Moon (1970, 1973). Lunokhod 1 was the first remote-
#. controlled, wheeled robot to land on and rove on an extraterrestrial body.
#: data/nomenclature.fab:26750
msgctxt "planitia"
msgid "Lunokhod Planitia"
msgstr "ルノホート平原"

#: data/nomenclature.fab:26750
msgctxt "origin"
msgid ""
"Two Soviet Union planetary rovers that were sent to the surface of the Moon "
"(1970, 1973). Lunokhod 1 was the first remote-controlled, wheeled robot to "
"land on and rove on an extraterrestrial body."
msgstr ""
"月面に送られた2台のソ連の惑星探査車 (1970年、1973年)、ルノホート1号は、地球外に着陸して移動した最初の遠隔操作の車輪付きロボットだった。"

#. TRANSLATORS: (Pluto); Soviet Union's Sputnik 1 (literally Satellite 1), the
#. first human-built satellite of the Earth (1957).
#: data/nomenclature.fab:26752
msgctxt "planitia"
msgid "Sputnik Planitia"
msgstr "スプートニク平原"

#: data/nomenclature.fab:26752
msgctxt "origin"
msgid ""
"Soviet Union's Sputnik 1 (literally Satellite 1), the first human-built "
"satellite of the Earth (1957)."
msgstr "ソ連のスプートニク1号 (衛星1号という意味) 、地球を周回する初めての人工衛星 (1957年) 。"

#. TRANSLATORS: (Pluto); Rosetta mission, the first mission to orbit and land
#. a spacecraft on a comet.
#: data/nomenclature.fab:26754
msgctxt "planitia"
msgid "Rosetta Planitia"
msgstr "ロゼッタ平原"

#: data/nomenclature.fab:26754
msgctxt "origin"
msgid ""
"Rosetta mission, the first mission to orbit and land a spacecraft on a "
"comet."
msgstr "ロゼッタミッション、彗星を周回して宇宙船を着陸させる最初のミッション。"

#. TRANSLATORS: (Pluto); Viktor; Russian astronomer who proposed the
#. planetesimal hypothesis for how the Solar System formed from a disk of gas
#. and dust around the Sun (1917-1999).
#: data/nomenclature.fab:26756
msgctxt "regio"
msgid "Safronov Regio"
msgstr "サフロノフ地域"

#: data/nomenclature.fab:26756
msgctxt "origin"
msgid ""
"Viktor; Russian astronomer who proposed the planetesimal hypothesis for how "
"the Solar System formed from a disk of gas and dust around the Sun "
"(1917-1999)."
msgstr ""
"ヴィクトル; ロシアの天文学者 (1917-1999) 。太陽の周りのガスと塵の円盤からどのように太陽系が形成されたかについて微惑星仮説を提案した。"

#. TRANSLATORS: (Pluto); Michael J. S.; British astronomer who in 2002 chaired
#. the first Planetary Science Decadal Survey, which established NASA’s New
#. Frontiers Program, including the New Horizons mission to Pluto and the
#. Kuiper Belt (1934-2018).
#: data/nomenclature.fab:26758
msgctxt "regio"
msgid "Belton Regio"
msgstr "ベルトン地域"

#: data/nomenclature.fab:26758
msgctxt "origin"
msgid ""
"Michael J. S.; British astronomer who in 2002 chaired the first Planetary "
"Science Decadal Survey, which established NASA’s New Frontiers Program, "
"including the New Horizons mission to Pluto and the Kuiper Belt (1934-2018)."
msgstr ""
"マイケル・J・S; イギリスの天文学者 (1934-2018) "
"。2002年に惑星科学10年探査計画の初代議長となる。そこで冥王星とカイパーベルトへのニューホライズンズ・ミッションを含む NASA "
"のニューフロンティア・プログラムが確立した。"

#. TRANSLATORS: (Pluto); Robert S.; American astronomer at the US Naval
#. Observatory who is considered the co-discoverer of Charon and was the first
#. to calculate the Pluto system’s mass (1942-1993).
#: data/nomenclature.fab:26760
msgctxt "regio"
msgid "Harrington Regio"
msgstr "ハリントン地域"

#: data/nomenclature.fab:26760
msgctxt "origin"
msgid ""
"Robert S.; American astronomer at the US Naval Observatory who is considered"
" the co-discoverer of Charon and was the first to calculate the Pluto "
"system’s mass (1942-1993)."
msgstr ""
"ロバート・S; 米国海軍天文台のアメリカ人天文学者 (1942-1993) "
"。カロンの共同発見者と考えられており、冥王星系の質量を最初に計算した人物である。"

#. TRANSLATORS: (Pluto); Shafika Gil’mievna; Soviet astronomer of Tatar
#. origin, celestial mechanics expert who developed an analytical theory for
#. Pluto’s motion and derived new orbital elements (1915-2002).
#: data/nomenclature.fab:26762
msgctxt "regio"
msgid "Sharaf Regio"
msgstr "シャラフ地域"

#: data/nomenclature.fab:26762
msgctxt "origin"
msgid ""
"Shafika Gil’mievna; Soviet astronomer of Tatar origin, celestial mechanics "
"expert who developed an analytical theory for Pluto’s motion and derived new"
" orbital elements (1915-2002)."
msgstr ""
"シャフィカ・ギルミエヴナ; タタール出身のソビエトの天文学者 (1915-2002) 。 "
"冥王星の運動の分析理論を開発し、新しい軌道要素を導き出した天体力学の専門家。"

#. TRANSLATORS: (Pluto); Percival; American astronomer who in 1906-1916
#. undertook extensive searches of transneptunian planets (1855-1916).
#: data/nomenclature.fab:26764
msgctxt "regio"
msgid "Lowell Regio"
msgstr "ローウェル地域"

#: data/nomenclature.fab:26764
msgctxt "origin"
msgid ""
"Percival; American astronomer who in 1906-1916 undertook extensive searches "
"of transneptunian planets (1855-1916)."
msgstr "パーシヴァル; アメリカの天文学者 (1855-1916) 。1906年から1916年に太陽系外惑星の大規模な探索を行った。"

#. TRANSLATORS: (Pluto); Clyde William; American astronomer, discoverer of
#. Pluto (1906–1997).
#: data/nomenclature.fab:26766
msgctxt "regio"
msgid "Tombaugh Regio"
msgstr "トンボー地域"

#: data/nomenclature.fab:26766
msgctxt "origin"
msgid "Clyde William; American astronomer, discoverer of Pluto (1906–1997)."
msgstr "クライド・ウィリアム; アメリカの天文学者、冥王星の発見者 (1906–1997) 。"

#. TRANSLATORS: (Pluto); Ahmed Muhiddin, also known as Piri Reis, Ottoman
#. navigator and cartographer (c. 1470–1553). Author of one of the earliest
#. existing world maps in 1513. His “Book of the Sea” (1521), containing 290
#. maps, was one of the most famous cartographical work
#: data/nomenclature.fab:26768
msgctxt "rupes"
msgid "Piri Rupes"
msgstr "ピーリー断崖"

#: data/nomenclature.fab:26768
msgctxt "origin"
msgid ""
"Ahmed Muhiddin, also known as Piri Reis, Ottoman navigator and cartographer "
"(c. 1470–1553). Author of one of the earliest existing world maps in 1513. "
"His “Book of the Sea” (1521), containing 290 maps, was one of the most "
"famous cartographical work"
msgstr ""
"アフメド・ムヒディン、ピリ・レイスとしても知られる、オスマン帝国の航海家兼地図製作者(1470年頃-1553年) "
"。現存する最古の世界地図の1つを1513年に作成した。290枚の地図を含む「海の書」(1521年) は、最も有名な地図作成作品の1つだった。"

#. TRANSLATORS: (Pluto); Sally; American physicist, astronaut, and first
#. American woman in space (1951-2012).
#: data/nomenclature.fab:26770
msgctxt "rupes"
msgid "Ride Rupes"
msgstr "ライド断崖"

#: data/nomenclature.fab:26770
msgctxt "origin"
msgid ""
"Sally; American physicist, astronaut, and first American woman in space "
"(1951-2012)."
msgstr "サリー; アメリカの物理学者、宇宙飛行士、宇宙に行った最初のアメリカ人女性 (1951-2012) 。"

#. TRANSLATORS: (Pluto); Series of the Soviet Union’s 16 spacecraft sent to
#. Venus in 1961–1983. The missions accomplished a number of firsts, including
#. the first human made device to enter the atmosphere of another planet
#. (Venera 3, 1966), to measure in situ atmosphere compo
#: data/nomenclature.fab:26772
msgctxt "terra"
msgid "Venera Terra"
msgstr "ベネラ大陸"

#: data/nomenclature.fab:26772
msgctxt "origin"
msgid ""
"Series of the Soviet Union’s 16 spacecraft sent to Venus in 1961–1983. The "
"missions accomplished a number of firsts, including the first human made "
"device to enter the atmosphere of another planet (Venera 3, 1966), to "
"measure in situ atmosphere compo"
msgstr ""
"1961年から1983年までソ連が打ち上げた一連の16機の金星探査機。このミッションでは数々の初の成果が数々達成された。一例として、その場の大気組成を測定するため、初めて人工機器が他の惑星の大気圏に突入した"
" (1966年のベネラ3号) "

#. TRANSLATORS: (Pluto); A pair of the Soviet Union’s Vega 1 and Vega 2
#. spacecraft launched in 1984 that were the first ones to fly balloons on
#. another planet (Venus, 1985) and then the first ones to image the nucleus
#. of a comet (1P/Halley, 1986).
#: data/nomenclature.fab:26774
msgctxt "terra"
msgid "Vega Terra"
msgstr "ヴェガ大陸"

#: data/nomenclature.fab:26774
msgctxt "origin"
msgid ""
"A pair of the Soviet Union’s Vega 1 and Vega 2 spacecraft launched in 1984 "
"that were the first ones to fly balloons on another planet (Venus, 1985) and"
" then the first ones to image the nucleus of a comet (1P/Halley, 1986)."
msgstr ""
"1984年に打ち上げられたソ連のベガ1号とベガ2号の探査機ペア。他の惑星で最初に気球を飛ばした探査機 (1985年の金星) "
"。そして彗星の核を最初に撮影した探査機 (1986年のハレー彗星 (1P ) ) 。"

#. TRANSLATORS: (Pluto); Early US lunar, planetary, and heliospheric missions
#. including the first to Jupiter and Saturn, 1958-1997.
#: data/nomenclature.fab:26776
msgctxt "terra"
msgid "Pioneer Terra"
msgstr "パイオニア大陸"

#: data/nomenclature.fab:26776
msgctxt "origin"
msgid ""
"Early US lunar, planetary, and heliospheric missions including the first to "
"Jupiter and Saturn, 1958-1997."
msgstr "1958年から1997年まで米国が行った木星と土星へ初めてのミッションを含む、月、惑星、太陽圏の初期のミッション。"

#. TRANSLATORS: (Pluto); A pair of US-launched Voyager 1 and Voyager 2
#. spacecraft that performed the “grand tour” of all four giant planets
#. (1977-1989).
#: data/nomenclature.fab:26778
msgctxt "terra"
msgid "Voyager Terra"
msgstr "ボイジャー大陸"

#: data/nomenclature.fab:26778
msgctxt "origin"
msgid ""
"A pair of US-launched Voyager 1 and Voyager 2 spacecraft that performed the "
"“grand tour” of all four giant planets (1977-1989)."
msgstr ""
"米国が打ち上げたボイジャー1号とボイジャー2号の探査機ペアで、4つの巨大惑星すべてを巡る「グランド ツアー」を実施した (1977年-1989年) 。"

#. TRANSLATORS: (Pluto); US Mars orbiter and landed missions that conducted
#. the first successful explorations of the surface of Mars, 1976 to 1982.
#: data/nomenclature.fab:26780
msgctxt "terra"
msgid "Viking Terra"
msgstr "バイキング大陸"

#: data/nomenclature.fab:26780
msgctxt "origin"
msgid ""
"US Mars orbiter and landed missions that conducted the first successful "
"explorations of the surface of Mars, 1976 to 1982."
msgstr "米国の行った火星周回と着陸のミッション。1976年から1982年にかけて、火星表面の探査に初めて成功した。"

#. TRANSLATORS: (Pluto); Japanese Hayabusa (literally Peregrine Falcon)
#. spacecraft that performed the first asteroid sample return (2003–2010).
#: data/nomenclature.fab:26782
msgctxt "terra"
msgid "Hayabusa Terra"
msgstr "ハヤブサ大陸"

#: data/nomenclature.fab:26782
msgctxt "origin"
msgid ""
"Japanese Hayabusa (literally Peregrine Falcon) spacecraft that performed the"
" first asteroid sample return (2003–2010)."
msgstr "最初の小惑星サンプルリターンを行った日本の探査機はやぶさ (文字通り隼を意味する)  (2003 -2010) 。"

#. TRANSLATORS: (Pluto); One of the Hero Twins (with Xbalanque) in Mayan
#. mythology, who defeated the lords of the Underworld in a ball game.
#: data/nomenclature.fab:26784
msgctxt "vallis"
msgid "Hunahpu Valles"
msgstr "フンアフプー峡谷"

#: data/nomenclature.fab:26784
msgctxt "origin"
msgid ""
"One of the Hero Twins (with Xbalanque) in Mayan mythology, who defeated the "
"lords of the Underworld in a ball game."
msgstr "マヤ神話での双子の英雄の一人 (もう一人はシュバランケ) 。球技で冥界の領主を破った。"

#. TRANSLATORS: (Pluto); Väinämöinen is a central character of the Finnish
#. national epic The Kalevala. He traveled to the Underworld to seek knowledge
#. of the dead.
#: data/nomenclature.fab:26786
msgctxt "vallis"
msgid "Väinämöinen Vallis"
msgstr "ヴァイナモイネン峡谷"

#: data/nomenclature.fab:26786
msgctxt "origin"
msgid ""
"Väinämöinen is a central character of the Finnish national epic The "
"Kalevala. He traveled to the Underworld to seek knowledge of the dead."
msgstr "ヴァイナモイネンはフィンランドの国民的叙事詩『カレワラ』の中心人物です。彼は死者についての知識を求めて冥界へ旅しました。"

#. TRANSLATORS: (Pluto); Lemminkäinen is a hero of the Finnish national epic
#. The Kalevala. He travels to the Underworld to capture the black swan.
#: data/nomenclature.fab:26788
msgctxt "vallis"
msgid "Lemminkäinen Vallis"
msgstr "レンミンカイネン峡谷"

#: data/nomenclature.fab:26788
msgctxt "origin"
msgid ""
"Lemminkäinen is a hero of the Finnish national epic The Kalevala. He travels"
" to the Underworld to capture the black swan."
msgstr "レンミンカイネンは、フィンランドの国民的叙事詩『カレワラ』の英雄です。彼は黒鳥を捕まえるために冥界へ旅します。"

#. TRANSLATORS: (Proteus); Island where Proteus reigned.
#: data/nomenclature.fab:26790
msgctxt "crater"
msgid "Pharos"
msgstr "ファロス"

#: data/nomenclature.fab:26790
msgctxt "origin"
msgid "Island where Proteus reigned."
msgstr "プロテウスが治めた島。"

#. TRANSLATORS: (Puck); Scottish mischievous spirits.
#: data/nomenclature.fab:26792
msgctxt "crater"
msgid "Bogle"
msgstr "ボーグル"

#: data/nomenclature.fab:26792
msgctxt "origin"
msgid "Scottish mischievous spirits."
msgstr "スコットランドのいたずら好きな精霊。"

#. TRANSLATORS: (Puck); German roguish or evil spirits.
#: data/nomenclature.fab:26794
msgctxt "crater"
msgid "Butz"
msgstr "ブツ"

#: data/nomenclature.fab:26794
msgctxt "origin"
msgid "German roguish or evil spirits."
msgstr "ドイツの悪党、または悪霊。"

#. TRANSLATORS: (Puck); British mischievous spirits.
#: data/nomenclature.fab:26796
msgctxt "crater"
msgid "Lob"
msgstr "ロブ"

#: data/nomenclature.fab:26796
msgctxt "origin"
msgid "British mischievous spirits."
msgstr "ブリトン族のイタズラの精霊。"

#. TRANSLATORS: (Rhea); Pygmy lord of the world, creator of all things.
#: data/nomenclature.fab:26798
msgctxt "crater"
msgid "Tore"
msgstr "トレ"

#: data/nomenclature.fab:26798
msgctxt "origin"
msgid "Pygmy lord of the world, creator of all things."
msgstr "ピグミーの世界の領主、万物の創造主。"

#. TRANSLATORS: (Rhea); Jivaro (Peru) wife of the creator god Kumpara.
#: data/nomenclature.fab:26800
msgctxt "crater"
msgid "Chingaso"
msgstr "チンガソ"

#: data/nomenclature.fab:26800
msgctxt "origin"
msgid "Jivaro (Peru) wife of the creator god Kumpara."
msgstr "ヒバロ族 (ペルー) の創造神クンパラの妻。"

#. TRANSLATORS: (Rhea); Mythical ancestor of Korean nation, son of creator
#. god.
#: data/nomenclature.fab:26802
msgctxt "crater"
msgid "Dangun"
msgstr "ダングン"

#: data/nomenclature.fab:26802
msgctxt "origin"
msgid "Mythical ancestor of Korean nation, son of creator god."
msgstr "檀君; 神話上の朝鮮民族の祖先、創造神の子。"

#. TRANSLATORS: (Rhea); Mosetene (N. Bolivia) creator of the earth and men.
#: data/nomenclature.fab:26804
msgctxt "crater"
msgid "Dohitt"
msgstr "ドヒット"

#: data/nomenclature.fab:26804
msgctxt "origin"
msgid "Mosetene (N. Bolivia) creator of the earth and men."
msgstr "モセテン族 (ボリビア北部) 地球と人間の創造主。"

#. TRANSLATORS: (Rhea); Fang (Gabon) sky god and creator of all things.
#: data/nomenclature.fab:26806
msgctxt "crater"
msgid "Nzame"
msgstr "ンザメ"

#: data/nomenclature.fab:26806
msgctxt "origin"
msgid "Fang (Gabon) sky god and creator of all things."
msgstr "ファン族 (ガボン) の天空の神、万物の創造主。"

#. TRANSLATORS: (Rhea); Yoruba (Nigeria) sky god involved in the work of
#. creation.
#: data/nomenclature.fab:26808
msgctxt "crater"
msgid "Obatala"
msgstr "オバタラ"

#: data/nomenclature.fab:26808
msgctxt "origin"
msgid "Yoruba (Nigeria) sky god involved in the work of creation."
msgstr "ヨルバ人 (ナイジェリア) の天空の神、創造の業に携わる。"

#. TRANSLATORS: (Rhea); Yoruba (Nigeria) creator god, gave life to man.
#: data/nomenclature.fab:26810
msgctxt "crater"
msgid "Olorun"
msgstr "オロルン"

#: data/nomenclature.fab:26810
msgctxt "origin"
msgid "Yoruba (Nigeria) creator god, gave life to man."
msgstr "ヨルバ人 (ナイジェリア) の創造神、人間に命を与えた。"

#. TRANSLATORS: (Rhea); Inca supreme god, "Earth maker."
#: data/nomenclature.fab:26812
msgctxt "crater"
msgid "Pachacamac"
msgstr "パチャカマック"

#: data/nomenclature.fab:26812
msgctxt "origin"
msgid "Inca supreme god, “Earth maker.”"
msgstr "インカの最高神、「大地を作る者」を意味する。"

#. TRANSLATORS: (Rhea); Pallawonaps (S. California, USA) deity who made all
#. things.
#: data/nomenclature.fab:26814
msgctxt "crater"
msgid "Pokoh"
msgstr "ポコフ"

#: data/nomenclature.fab:26814
msgctxt "origin"
msgid "Pallawonaps (S. California, USA) deity who made all things."
msgstr "パラワナップ族 (米国カリフォルニア州南部) の全ての物を作った神様。"

#. TRANSLATORS: (Rhea); The first male being in Hawaiian myth, parent (with
#. Powehiwehi) of all the creatures in the ocean.
#: data/nomenclature.fab:26816
msgctxt "crater"
msgid "Pouliuli"
msgstr "ポウリウリ"

#: data/nomenclature.fab:26816
msgctxt "origin"
msgid ""
"The first male being in Hawaiian myth, parent (with Powehiwehi) of all the "
"creatures in the ocean."
msgstr "ハワイ神話に登場する最初の男性、海のすべての生物の (ポウェヒウェヒと共に) 親。"

#. TRANSLATORS: (Rhea); The first female being in Hawaiian myth, parent (with
#. Pouliuli) of all the creatures in the ocean.
#: data/nomenclature.fab:26818
msgctxt "crater"
msgid "Powehiwehi"
msgstr "ポウェヒウェヒ"

#: data/nomenclature.fab:26818
msgctxt "origin"
msgid ""
"The first female being in Hawaiian myth, parent (with Pouliuli) of all the "
"creatures in the ocean."
msgstr "ハワイ神話に登場する最初の女性、海のすべての生物の (ポウリウリと共に) 親。"

#. TRANSLATORS: (Rhea); Chamorro (Guam Island, Micronesia) pre-existent being
#. from whose body the world was formed.
#: data/nomenclature.fab:26820
msgctxt "crater"
msgid "Puntan"
msgstr "プンタン"

#: data/nomenclature.fab:26820
msgctxt "origin"
msgid ""
"Chamorro (Guam Island, Micronesia) pre-existent being from whose body the "
"world was formed."
msgstr "チャモロ族 (ミクロネシアのグアム島) の世界が形成された元となった、先在する存在。"

#. TRANSLATORS: (Rhea); Kachins (Burma) primeval god, the male element and
#. father of the gods.
#: data/nomenclature.fab:26822
msgctxt "crater"
msgid "Samni"
msgstr "サムニ"

#: data/nomenclature.fab:26822
msgctxt "origin"
msgid "Kachins (Burma) primeval god, the male element and father of the gods."
msgstr "カチン族 (ビルマ) の原始の神、男性的要素であり神々の父。"

#. TRANSLATORS: (Rhea); Evenki (Siberia, Russia) creator of the earth and man.
#: data/nomenclature.fab:26824
msgctxt "crater"
msgid "Seveki"
msgstr "セヴェキ"

#: data/nomenclature.fab:26824
msgctxt "origin"
msgid "Evenki (Siberia, Russia) creator of the earth and man."
msgstr "エヴェンキ (ロシアのシベリア地方) の地球と人類の創造主。"

#. TRANSLATORS: (Rhea); The first woman, ancestor of human race, co-creator
#. (with her brother and husband Melo) of the earth and sky in the myths of
#. the Minyong (Assam, India).
#: data/nomenclature.fab:26826
msgctxt "crater"
msgid "Shedi"
msgstr "シェディ"

#: data/nomenclature.fab:26826
msgctxt "origin"
msgid ""
"The first woman, ancestor of human race, co-creator (with her brother and "
"husband Melo) of the earth and sky in the myths of the Minyong (Assam, "
"India)."
msgstr "最初の女性、人類の祖先、ミンヨン族 (インドのアッサム地方) の神話では、(兄と夫のメロと共に) 地球と天空の共同創造者。"

#. TRANSLATORS: (Rhea); Tuamotu Islands (Polynesia) creator god.
#: data/nomenclature.fab:26828
msgctxt "crater"
msgid "Tane"
msgstr "タネ"

#: data/nomenclature.fab:26828
msgctxt "origin"
msgid "Tuamotu Islands (Polynesia) creator god."
msgstr "ツアモツ諸島 (ポリネシア) の創造神。"

#. TRANSLATORS: (Rhea); Hopi (Arizona, USA) sun god who existed at the
#. beginning of creation, father of everything.
#: data/nomenclature.fab:26830
msgctxt "crater"
msgid "Tawa"
msgstr "タワ"

#: data/nomenclature.fab:26830
msgctxt "origin"
msgid ""
"Hopi (Arizona, USA) sun god who existed at the beginning of creation, father"
" of everything."
msgstr "ホピ族 (米国アリゾナ州) の創造の初めに存在した太陽神、万物の父。"

#. TRANSLATORS: (Rhea); Japanese moon god, born from the right eye of the
#. primeval god Izanagi.
#: data/nomenclature.fab:26832
msgctxt "crater"
msgid "Tsuki-Yomi"
msgstr "ツキ=ヨミ"

#: data/nomenclature.fab:26832
msgctxt "origin"
msgid ""
"Japanese moon god, born from the right eye of the primeval god Izanagi."
msgstr "日本の月の神、原初の神イザナギの右目から生まれた。"

#. TRANSLATORS: (Rhea); Ceram (Molucca Islands, Indonesia) sun god and
#. personification of the sky, took part in creation.
#: data/nomenclature.fab:26834
msgctxt "crater"
msgid "Tuwale"
msgstr "トゥワレ"

#: data/nomenclature.fab:26834
msgctxt "origin"
msgid ""
"Ceram (Molucca Islands, Indonesia) sun god and personification of the sky, "
"took part in creation."
msgstr "セラム族 (インドネシアのモルッカ諸島) の太陽神で天空の擬人化。創造に参加した。"

#. TRANSLATORS: (Rhea); Sioux (Great Plains, USA) great creator of all things.
#: data/nomenclature.fab:26836
msgctxt "crater"
msgid "Wakonda"
msgstr "ワコンダ"

#: data/nomenclature.fab:26836
msgctxt "origin"
msgid "Sioux (Great Plains, USA) great creator of all things."
msgstr "スー族 (米国グレートプレーンズ) の偉大な万物の創造主。"

#. TRANSLATORS: (Rhea); Mossi (Burkina Faso) supreme god who lives in the sun,
#. creator of the heavens and earth.
#: data/nomenclature.fab:26838
msgctxt "crater"
msgid "Wende"
msgstr "ウェンデ"

#: data/nomenclature.fab:26838
msgctxt "origin"
msgid ""
"Mossi (Burkina Faso) supreme god who lives in the sun, creator of the "
"heavens and earth."
msgstr "モシ族 (ブルキナファソ) の最高神。太陽に住み、天地を創造した。"

#. TRANSLATORS: (Rhea); Ijaw (Nigeria) creatrix who made men out of earth.
#: data/nomenclature.fab:26840
msgctxt "crater"
msgid "Woyengi"
msgstr "ウォイェンギ"

#: data/nomenclature.fab:26840
msgctxt "origin"
msgid "Ijaw (Nigeria) creatrix who made men out of earth."
msgstr "イジャウ族 (ナイジェリア) の大地から人間を作った女性創造者。"

#. TRANSLATORS: (Rhea); Krachi (Ghana) primeval sky god, mate of mother earth.
#: data/nomenclature.fab:26842
msgctxt "crater"
msgid "Wulbari"
msgstr "ウルバリ"

#: data/nomenclature.fab:26842
msgctxt "origin"
msgid "Krachi (Ghana) primeval sky god, mate of mother earth."
msgstr "クラチェ語 (ガーナ) 話者における原始の空の神、母なる大地の伴侶。"

#. TRANSLATORS: (Rhea); Joshua (Oregon, USA) creator god.
#: data/nomenclature.fab:26844
msgctxt "crater"
msgid "Xowalaci"
msgstr "ソワラシ"

#: data/nomenclature.fab:26844
msgctxt "origin"
msgid "Joshua (Oregon, USA) creator god."
msgstr "ジョシュア族 (米国オレゴン州) の創造神。"

#. TRANSLATORS: (Rhea); Assyro/Babylonian primeval goddess from whom came the
#. earth and the heavens, mother of the gods.
#: data/nomenclature.fab:26846
msgctxt "crater"
msgid "Zicum"
msgstr "ジクム"

#: data/nomenclature.fab:26846
msgctxt "origin"
msgid ""
"Assyro/Babylonian primeval goddess from whom came the earth and the heavens,"
" mother of the gods."
msgstr "アッシリア/バビロニアの地上と天界生んだ原始の女神、神々の母。"

#. TRANSLATORS: (Rhea); Efik (Ghana) creator god.
#: data/nomenclature.fab:26848
msgctxt "crater"
msgid "Abassi"
msgstr "アバッシ"

#: data/nomenclature.fab:26848
msgctxt "origin"
msgid "Efik (Ghana) creator god."
msgstr "エフィク族 (ガーナ) の創造神。"

#. TRANSLATORS: (Rhea); Eskimo/Inuit (N. Canada) supreme being who created
#. everything, father of the sea goddess Sedna.
#: data/nomenclature.fab:26850
msgctxt "crater"
msgid "Anguta"
msgstr "アングタ"

#: data/nomenclature.fab:26850
msgctxt "origin"
msgid ""
"Eskimo/Inuit (N. Canada) supreme being who created everything, father of the"
" sea goddess Sedna."
msgstr "エスキモー/イヌイット (カナダ北部) を創造した至高の存在、海の女神セドナの父。"

#. TRANSLATORS: (Rhea); Zuni (New Mexico, USA) primeval deity, supreme life
#. giver.
#: data/nomenclature.fab:26852
msgctxt "crater"
msgid "Awonawilona"
msgstr "アウォナウィロナ"

#: data/nomenclature.fab:26852
msgctxt "origin"
msgid "Zuni (New Mexico, USA) primeval deity, supreme life giver."
msgstr "ズニ族 (米国ニューメキシコ州) の太古の神様、至高の生命の与える主。"

#. TRANSLATORS: (Rhea); Creator of islands from the giant shellfishes in
#. mythology of Malekula Island (New Hebrides/Vanuatu, Melanesia).
#: data/nomenclature.fab:26854
msgctxt "crater"
msgid "Ambat"
msgstr "アンバット"

#: data/nomenclature.fab:26854
msgctxt "origin"
msgid ""
"Creator of islands from the giant shellfishes in mythology of Malekula "
"Island (New Hebrides/Vanuatu, Melanesia)."
msgstr "マレクラ島 (メラネシアのニューヘブリディーズ諸島/バヌアツ) の神話に登場する、巨大な貝から島を創造した者。"

#. TRANSLATORS: (Rhea); Dogon (Mali) creator of the universe.
#: data/nomenclature.fab:26856
msgctxt "crater"
msgid "Amma"
msgstr "アンマ"

#: data/nomenclature.fab:26856
msgctxt "origin"
msgid "Dogon (Mali) creator of the universe."
msgstr "ドゴン族 (マリ) の宇宙の創造主。"

#. TRANSLATORS: (Rhea); Salish (NW USA, SW Canada) creator deity, wise and
#. kind old man.
#: data/nomenclature.fab:26858
msgctxt "crater"
msgid "Amotken"
msgstr "アモトケン"

#: data/nomenclature.fab:26858
msgctxt "origin"
msgid "Salish (NW USA, SW Canada) creator deity, wise and kind old man."
msgstr "サリッシュ族 (米国北西部、カナダ南西部) の創造の神様、賢く優しい老人。"

#. TRANSLATORS: (Rhea); Spider in Ashanti (Ghana) mythology, who created the
#. sun, moon, stars, and mankind.
#: data/nomenclature.fab:26860
msgctxt "crater"
msgid "Anansi"
msgstr "アナンシ"

#: data/nomenclature.fab:26860
msgctxt "origin"
msgid ""
"Spider in Ashanti (Ghana) mythology, who created the sun, moon, stars, and "
"mankind."
msgstr "アサンテ族 (ガーナ) の神話に登場する蜘蛛。太陽、月、星、人類を創造した。"

#. TRANSLATORS: (Rhea); Taino (Puerto Rico) mother goddess, the “First-In-
#. Existence.”
#: data/nomenclature.fab:26862
msgctxt "crater"
msgid "Atabei"
msgstr "アタベイ"

#: data/nomenclature.fab:26862
msgctxt "origin"
msgid "Taino (Puerto Rico) mother goddess, the “First-In-Existence.”"
msgstr "タイノ族 (プエルトリコ) の母なる女神、「最初の存在者」。"

#. TRANSLATORS: (Rhea); Coyote, creator of many places and things in Chinook
#. (NW USA) mythology.
#: data/nomenclature.fab:26864
msgctxt "crater"
msgid "Talapas"
msgstr "タラパス"

#: data/nomenclature.fab:26864
msgctxt "origin"
msgid ""
"Coyote, creator of many places and things in Chinook (NW USA) mythology."
msgstr "チヌーク族 (米国北西部)の神話に登場する、多くの場所や物の創造したコヨーテ。"

#. TRANSLATORS: (Rhea); Ket (Yenisey River area, Central Siberia, Russia) god,
#. creator of the northern, down-sloped part of the earth.
#: data/nomenclature.fab:26866
msgctxt "crater"
msgid "Dotet"
msgstr "ドテト"

#: data/nomenclature.fab:26866
msgctxt "origin"
msgid ""
"Ket (Yenisey River area, Central Siberia, Russia) god, creator of the "
"northern, down-sloped part of the earth."
msgstr "ケット人 (ロシアの中央シベリア、エニセイ川流域) の神、地球の北側の傾斜した部分の創造者。"

#. TRANSLATORS: (Rhea); Aztec feathered serpent god of wind, one of the
#. creators of the Earth, heavens and humans. His other name is Quetzalcoatl.
#: data/nomenclature.fab:26868
msgctxt "crater"
msgid "Ehecatl"
msgstr "エエカトル"

#: data/nomenclature.fab:26868
msgctxt "origin"
msgid ""
"Aztec feathered serpent god of wind, one of the creators of the Earth, "
"heavens and humans. His other name is Quetzalcoatl."
msgstr "アステカの風の神で羽根の生えた蛇。地上、天界、人間の創造主の一人。別名ケツァルコアトル。"

#. TRANSLATORS: (Rhea); Maasai (Tanzania, Kenya) creator god and the ruler of
#. rains.
#: data/nomenclature.fab:26870
msgctxt "crater"
msgid "Enkai"
msgstr "エンカイ"

#: data/nomenclature.fab:26870
msgctxt "origin"
msgid "Maasai (Tanzania, Kenya) creator god and the ruler of rains."
msgstr "マサイ族 (タンザニア、ケニア) の創造神で雨の支配者。"

#. TRANSLATORS: (Rhea); Chinese god, husband of the goddess Nugua. These two
#. beings were worshipped as the ultimate ancestors of all humankind.
#: data/nomenclature.fab:26872
msgctxt "crater"
msgid "Fuxi"
msgstr "フーシー"

#: data/nomenclature.fab:26872
msgctxt "origin"
msgid ""
"Chinese god, husband of the goddess Nugua. These two beings were worshipped "
"as the ultimate ancestors of all humankind."
msgstr "伏羲; 中国の神、女神である女媧の夫。この二人の存在は人類の究極の祖先として崇拝された。"

#. TRANSLATORS: (Rhea); Algonquin (Great Lakes area, Canada and USA) creator
#. of plants, animals and humans; son of the Great Earth Mother.
#: data/nomenclature.fab:26874
msgctxt "crater"
msgid "Glooskap"
msgstr "グルースキャップ"

#: data/nomenclature.fab:26874
msgctxt "origin"
msgid ""
"Algonquin (Great Lakes area, Canada and USA) creator of plants, animals and "
"humans; son of the Great Earth Mother."
msgstr "アルゴンキン族 (カナダと米国の五大湖地域) の植物、動物、人間の創造主。偉大なる大地の母の息子。"

#. TRANSLATORS: (Rhea); Nanai (Amur River area, E. Siberia, Russia) goddess
#. who created the Asian continent and Sakhalin Island. For this action, she
#. was killed by her husband and world creator, Khado.
#: data/nomenclature.fab:26876
msgctxt "crater"
msgid "Mamaldi"
msgstr "ママルディ"

#: data/nomenclature.fab:26876
msgctxt "origin"
msgid ""
"Nanai (Amur River area, E. Siberia, Russia) goddess who created the Asian "
"continent and Sakhalin Island. For this action, she was killed by her "
"husband and world creator, Khado."
msgstr ""
"ナナイ人 (ロシアのシベリア東部、アムール川流域) のアジア大陸とサハリン島を創造した女神。この行為のため、夫であり世界の創造主であるカドに殺された。"

#. TRANSLATORS: (Rhea); Yaruro (Venezuela) moon goddess, creator of all
#. things.
#: data/nomenclature.fab:26878
msgctxt "crater"
msgid "Kuma"
msgstr "クマ"

#: data/nomenclature.fab:26878
msgctxt "origin"
msgid "Yaruro (Venezuela) moon goddess, creator of all things."
msgstr "ユルロ人 (ベネズエラ) の月の女神、万物の創造者。"

#. TRANSLATORS: (Rhea); Ember-goose who took up some clay from an ocean floor
#. to create a land in Mansi myth (W. Siberia, Russia).
#: data/nomenclature.fab:26880
msgctxt "crater"
msgid "Luli"
msgstr "ルリ"

#: data/nomenclature.fab:26880
msgctxt "origin"
msgid ""
"Ember-goose who took up some clay from an ocean floor to create a land in "
"Mansi myth (W. Siberia, Russia)."
msgstr "マンシ神話 (ロシアの西シベリア) で海底から粘土をすくい上げ、陸地を作ったエンバー=グース。"

#. TRANSLATORS: (Rhea); Pomo (N. California, USA) creator of the universe,
#. brother of Kuksu.
#: data/nomenclature.fab:26882
msgctxt "crater"
msgid "Madumda"
msgstr "マドゥムダ"

#: data/nomenclature.fab:26882
msgctxt "origin"
msgid "Pomo (N. California, USA) creator of the universe, brother of Kuksu."
msgstr "ポモ族 (米国カリフォルニア州北部) の宇宙の創造主、ククスの兄弟。"

#. TRANSLATORS: (Rhea); Cheyenne (Great Plains, USA) Great Spirit, creator of
#. the world.
#: data/nomenclature.fab:26884
msgctxt "crater"
msgid "Maheo"
msgstr "マヘオ"

#: data/nomenclature.fab:26884
msgctxt "origin"
msgid "Cheyenne (Great Plains, USA) Great Spirit, creator of the world."
msgstr "シャイアン族 (米国グレートプレーンズ) の偉大なる精霊、世界の創造主。"

#. TRANSLATORS: (Rhea); Blackfoot (Alberta, Canada/Montana, USA) creator of
#. the earth, animals and mankind.
#: data/nomenclature.fab:26886
msgctxt "crater"
msgid "Napi"
msgstr "ナピ"

#: data/nomenclature.fab:26886
msgctxt "origin"
msgid ""
"Blackfoot (Alberta, Canada/Montana, USA) creator of the earth, animals and "
"mankind."
msgstr "ブラックフット族 (カナダのアルバータ州、米国モンタナ州) の地球、動物、人類の創造主。"

#. TRANSLATORS: (Rhea); Arikara (N. Dakota, USA) creation spirit, great sky
#. chief.
#: data/nomenclature.fab:26888
msgctxt "crater"
msgid "Nishanu"
msgstr "ニシャヌ"

#: data/nomenclature.fab:26888
msgctxt "origin"
msgid "Arikara (N. Dakota, USA) creation spirit, great sky chief."
msgstr "アリカラ族 (米国ノースダコタ州) の創造の精霊、偉大なる空の酋長。"

#. TRANSLATORS: (Rhea); Samoan (Polynesia) male of the first human couple.
#: data/nomenclature.fab:26890
msgctxt "crater"
msgid "Fatu"
msgstr "ファトゥ"

#: data/nomenclature.fab:26890
msgctxt "origin"
msgid "Samoan (Polynesia) male of the first human couple."
msgstr "サモア (ポリネシア) の人間の最初のカップルの男性の方。"

#. TRANSLATORS: (Rhea); Lugbara (Uganda) first man, pair to Meme.
#: data/nomenclature.fab:26892
msgctxt "crater"
msgid "Gborogboro"
msgstr "グボログボロ"

#: data/nomenclature.fab:26892
msgctxt "origin"
msgid "Lugbara (Uganda) first man, pair to Meme."
msgstr "ルグバラ族 (ウガンダ) の最初の男、メメと夫婦になる。"

#. TRANSLATORS: (Rhea); Georgian (Caucasus) god, founder and keeper of the
#. world order.
#: data/nomenclature.fab:26894
msgctxt "crater"
msgid "Gmerti"
msgstr "グメルティ"

#: data/nomenclature.fab:26894
msgctxt "origin"
msgid "Georgian (Caucasus) god, founder and keeper of the world order."
msgstr "ジョージア (コーカサス地方) の神であり、世界秩序の創始者であり守護者。"

#. TRANSLATORS: (Rhea); Mayan creator god.
#: data/nomenclature.fab:26896
msgctxt "crater"
msgid "Gucumatz"
msgstr "グクマッツ"

#: data/nomenclature.fab:26896
msgctxt "origin"
msgid "Mayan creator god."
msgstr "マヤの創造神。"

#. TRANSLATORS: (Rhea); Kiche (Guatemala) creator god, bringer of children,
#. ruler of wind and storms.
#: data/nomenclature.fab:26898
msgctxt "crater"
msgid "Huracan"
msgstr "フラカン"

#: data/nomenclature.fab:26898
msgctxt "origin"
msgid ""
"Kiche (Guatemala) creator god, bringer of children, ruler of wind and "
"storms."
msgstr "キチェ (グアテマラ) の創造神。子供をもたらし、風と嵐を支配する。"

#. TRANSLATORS: (Rhea); Kakadu (N. Australia) creator goddess, the Great
#. Mother, mate of the giant Wuraka.
#: data/nomenclature.fab:26900
msgctxt "crater"
msgid "Imberombera"
msgstr "インベロンベラ"

#: data/nomenclature.fab:26900
msgctxt "origin"
msgid ""
"Kakadu (N. Australia) creator goddess, the Great Mother, mate of the giant "
"Wuraka."
msgstr "カカドゥ (オーストラリア北部) の創造の女神、偉大なる母、巨人ウラカの仲間。"

#. TRANSLATORS: (Rhea); Dakota (USA) spirit, "The Spider," created time, space
#. and language.
#: data/nomenclature.fab:26902
msgctxt "crater"
msgid "Inktomi"
msgstr "インクトミ"

#: data/nomenclature.fab:26902
msgctxt "origin"
msgid "Dakota (USA) spirit, “The Spider,” created time, space and language."
msgstr "ダコタ族 (米国) の精霊「蜘蛛」。時間、空間、言葉を作った。"

#. TRANSLATORS: (Rhea); Udmurtian (Uralic Finns, Russia) creator god.
#: data/nomenclature.fab:26904
msgctxt "crater"
msgid "Inmar"
msgstr "インマル"

#: data/nomenclature.fab:26904
msgctxt "origin"
msgid "Udmurtian (Uralic Finns, Russia) creator god."
msgstr "ウドムルト人 (ロシアのウラル・フィン族) の創造神。"

#. TRANSLATORS: (Rhea); Pomo (N. California, USA) deity who created the world
#. with his brother Madumda.
#: data/nomenclature.fab:26906
msgctxt "crater"
msgid "Kuksu"
msgstr "ククス"

#: data/nomenclature.fab:26906
msgctxt "origin"
msgid ""
"Pomo (N. California, USA) deity who created the world with his brother "
"Madumda."
msgstr "ポモ族 (米国カリフォルニア州北部) の兄弟のマドゥムダとともに世界を創造した神様。"

#. TRANSLATORS: (Rhea); Old creator God of Heliopolis; became son of Ptah.
#: data/nomenclature.fab:26908
msgctxt "crater"
msgid "Atum"
msgstr "アトゥム"

#: data/nomenclature.fab:26908
msgctxt "origin"
msgid "Old creator God of Heliopolis; became son of Ptah."
msgstr "古代ヘリオポリスの創造神。プタハの息子になった。"

#. TRANSLATORS: (Rhea); Ceram (Indonesia) ancestor whose blood made Hainuwele.
#: data/nomenclature.fab:26910
msgctxt "crater"
msgid "Ameta"
msgstr "アメタ"

#: data/nomenclature.fab:26910
msgctxt "origin"
msgid "Ceram (Indonesia) ancestor whose blood made Hainuwele."
msgstr "セラム族 (インドネシア) のハイヌウェレを作った血統を持つ先祖。"

#. TRANSLATORS: (Rhea); Korean god of the Heavens.
#: data/nomenclature.fab:26912
msgctxt "crater"
msgid "Aananin"
msgstr "アアナニン"

#: data/nomenclature.fab:26912
msgctxt "origin"
msgid "Korean god of the Heavens."
msgstr "朝鮮の天界の神。"

#. TRANSLATORS: (Rhea); Kafir (Nuristan, NE Afghanistan) supreme god, creator
#. of gods and people.
#: data/nomenclature.fab:26914
msgctxt "crater"
msgid "Imra"
msgstr "イムラ"

#: data/nomenclature.fab:26914
msgctxt "origin"
msgid ""
"Kafir (Nuristan, NE Afghanistan) supreme god, creator of gods and people."
msgstr "カーフィル (アフガニスタン北東部ヌーリスタン地方) の最高神、神と人々の創造者。"

#. TRANSLATORS: (Rhea); Mythical heroine and ancestor of the Ulci tribe.
#: data/nomenclature.fab:26916
msgctxt "crater"
msgid "Adjua"
msgstr "アドジュア"

#: data/nomenclature.fab:26916
msgctxt "origin"
msgid "Mythical heroine and ancestor of the Ulci tribe."
msgstr "ウリチ族の神話での女性主人公で彼らの祖先。"

#. TRANSLATORS: (Rhea); San Cristobal (Melanesia) god who made sea, land,
#. people.
#: data/nomenclature.fab:26918
msgctxt "crater"
msgid "Agunua"
msgstr "アグヌア"

#: data/nomenclature.fab:26918
msgctxt "origin"
msgid "San Cristobal (Melanesia) god who made sea, land, people."
msgstr "サン・クリストバル (メラネシア) の海、陸、人々を創造した神。"

#. TRANSLATORS: (Rhea); Yaruro (Venezuela) jaguar god, creator of the river
#. waters.
#: data/nomenclature.fab:26920
msgctxt "crater"
msgid "Itciai"
msgstr "イトスィアイ"

#: data/nomenclature.fab:26920
msgctxt "origin"
msgid "Yaruro (Venezuela) jaguar god, creator of the river waters."
msgstr "ユルロ人 (ベネズエラ) のジャガーの神、川の水の創造者。"

#. TRANSLATORS: (Rhea); Inca creator of all things.
#: data/nomenclature.fab:26922
msgctxt "crater"
msgid "Arunaka"
msgstr "アルナカ"

#: data/nomenclature.fab:26922 data/nomenclature.fab:27020
msgctxt "origin"
msgid "Inca creator of all things."
msgstr "インカの万物の創造者。"

#. TRANSLATORS: (Rhea); Shilluk (S. Sudan) creator god.
#: data/nomenclature.fab:26924
msgctxt "crater"
msgid "Juok"
msgstr "ジュオク"

#: data/nomenclature.fab:26924
msgctxt "origin"
msgid "Shilluk (S. Sudan) creator god."
msgstr "シルック族 (スーダン南部) の創造神。"

#. TRANSLATORS: (Rhea); Warrau/Warao (Orinoco River Delta, Venezuela)
#. benevolent supreme being and creator god.
#: data/nomenclature.fab:26926
msgctxt "crater"
msgid "Kanobo"
msgstr "カノボ"

#: data/nomenclature.fab:26926
msgctxt "origin"
msgid ""
"Warrau/Warao (Orinoco River Delta, Venezuela) benevolent supreme being and "
"creator god."
msgstr "ワッラウ族、またはワラオ族 (ベネズエラ、オリノコ川デルタ地帯) の慈悲深い至高の存在であり創造神。"

#. TRANSLATORS: (Rhea); Bushongo; dwelt in primordial waters; vomited up sun,
#. moon, stars, animals, and men. Showed man how to make fire.
#: data/nomenclature.fab:26928
msgctxt "crater"
msgid "Bumba"
msgstr "ブムバ"

#: data/nomenclature.fab:26928
msgctxt "origin"
msgid ""
"Bushongo; dwelt in primordial waters; vomited up sun, moon, stars, animals, "
"and men. Showed man how to make fire."
msgstr "ブションゴ; 原始の水に住んでいた。太陽、月、星、動物、人間を吐き出し、人間に火の起こし方を教えた。"

#. TRANSLATORS: (Rhea); Buriat (Siberia) god who created world.
#: data/nomenclature.fab:26930
msgctxt "crater"
msgid "Burkhan"
msgstr "ブルカン"

#: data/nomenclature.fab:26930
msgctxt "origin"
msgid "Buriat (Siberia) god who created world."
msgstr "ブリヤート (シベリア) の世界を創造した神。"

#. TRANSLATORS: (Rhea); Ossetian (N. Caucasus, Russia) supreme god, creator of
#. the Earth.
#: data/nomenclature.fab:26932
msgctxt "crater"
msgid "Khutsau"
msgstr "フツァウ"

#: data/nomenclature.fab:26932
msgctxt "origin"
msgid "Ossetian (N. Caucasus, Russia) supreme god, creator of the Earth."
msgstr "オセチア人 (ロシア北コーカサス地方) の地球の創造主、最高神。"

#. TRANSLATORS: (Rhea); Mundurucu (Tapajos and Trombetas Rivers area, NE
#. Brazil) creator god.
#: data/nomenclature.fab:26934
msgctxt "crater"
msgid "Karusakaibo"
msgstr "カルサカイボ"

#: data/nomenclature.fab:26934
msgctxt "origin"
msgid "Mundurucu (Tapajos and Trombetas Rivers area, NE Brazil) creator god."
msgstr "ムンドゥルク族 (ブラジル北東部、タパジョス川とトロンベタス川地域) の創造神。 "

#. TRANSLATORS: (Rhea); Chukchi (NE Russia) creator raven.
#: data/nomenclature.fab:26936
msgctxt "crater"
msgid "Kurkyl"
msgstr "クルキル"

#: data/nomenclature.fab:26936
msgctxt "origin"
msgid "Chukchi (NE Russia) creator raven."
msgstr "チュクチ族 (ロシア北東部) の創造のカラス。"

#. TRANSLATORS: (Rhea); Yakutian ancestor of the people.
#: data/nomenclature.fab:26938
msgctxt "crater"
msgid "Ellyay"
msgstr "エリアイ"

#: data/nomenclature.fab:26938
msgctxt "origin"
msgid "Yakutian ancestor of the people."
msgstr "ヤクート人の祖先。"

#. TRANSLATORS: (Rhea); Neghidahan (Ukrainian) first man who was ancestor of
#. the people.
#: data/nomenclature.fab:26940
msgctxt "crater"
msgid "Djuli"
msgstr "ドゥユリ"

#: data/nomenclature.fab:26940
msgctxt "origin"
msgid "Neghidahan (Ukrainian) first man who was ancestor of the people."
msgstr "ネグヒダハ人 (ウクライナ人) の人類の祖先となった最初の人。"

#. TRANSLATORS: (Rhea); Igorot (Luzon Island, Philippines) Great Spirit,
#. created humans from cut reeds.
#: data/nomenclature.fab:26942
msgctxt "crater"
msgid "Lumawig"
msgstr "ルマウィグ"

#: data/nomenclature.fab:26942
msgctxt "origin"
msgid ""
"Igorot (Luzon Island, Philippines) Great Spirit, created humans from cut "
"reeds."
msgstr "イゴロット族 (フィリピン、ルソン島) の偉大なる精霊。刈り取った葦から人間を創造した。"

#. TRANSLATORS: (Rhea); Micronesian (Truk/Chuuk Island, Caroline Islands)
#. earth goddess, created the world together with her husband Anulap, a god of
#. magic and knowledge.
#: data/nomenclature.fab:26944
msgctxt "crater"
msgid "Ligoupup"
msgstr "リゴウププ"

#: data/nomenclature.fab:26944
msgctxt "origin"
msgid ""
"Micronesian (Truk/Chuuk Island, Caroline Islands) earth goddess, created the"
" world together with her husband Anulap, a god of magic and knowledge."
msgstr "ミクロネシア (カロリン諸島のトラック/チューク諸島) の大地の女神、魔法と知識の神である夫アヌラプとともに世界を創造した。"

#. TRANSLATORS: (Rhea); Inca coastal creator god.
#: data/nomenclature.fab:26946
msgctxt "crater"
msgid "Con"
msgstr "コン"

#: data/nomenclature.fab:26946
msgctxt "origin"
msgid "Inca coastal creator god."
msgstr "インカの沿岸の創造神。"

#. TRANSLATORS: (Rhea); Nias Island (W. Indonesia) sky god, creator of humans.
#: data/nomenclature.fab:26948
msgctxt "crater"
msgid "Lowalangi"
msgstr "ロワラニ"

#: data/nomenclature.fab:26948
msgctxt "origin"
msgid "Nias Island (W. Indonesia) sky god, creator of humans."
msgstr "ニアス島 (インドネシア西部) の天空の神、人間を創造した。"

#. TRANSLATORS: (Rhea); Guarani (Paraguay, Argentina, Brazil) creator worm who
#. appeared in pre-existing water, then became a human and made the world.
#: data/nomenclature.fab:26950
msgctxt "crater"
msgid "Mbir"
msgstr "ムビル"

#: data/nomenclature.fab:26950
msgctxt "origin"
msgid ""
"Guarani (Paraguay, Argentina, Brazil) creator worm who appeared in pre-"
"existing water, then became a human and made the world."
msgstr "グアラニー族 (パラグアイ、アルゼンチン、ブラジル) の創造主の虫。既存の水の中に現れ、その後人間になって世界を作った"

#. TRANSLATORS: (Rhea); Mythological mother of the Kikuyu people (Kenya), wife
#. of Gikuyu, the ancestor of the people, created by god Ngai, who took him on
#. top of Kirinyaga (Mount Kenya) to show all the land given for him.
#: data/nomenclature.fab:26952
msgctxt "crater"
msgid "Mumbi"
msgstr "ヌムビ"

#: data/nomenclature.fab:26952
msgctxt "origin"
msgid ""
"Mythological mother of the Kikuyu people (Kenya), wife of Gikuyu, the "
"ancestor of the people, created by god Ngai, who took him on top of "
"Kirinyaga (Mount Kenya) to show all the land given for him."
msgstr ""
"キクユ族 (ケニア) の神話上の母親であり、民族の祖先であるギクユの妻、ヌガイ神によって創造され、彼に与えられたすべての土地を見せるためにキリニャガ "
"(ケニア山) の頂上に彼を連れて行った。"

#. TRANSLATORS: (Rhea); Mande; his sacrificial killing in heaven atoned for
#. his twin Pemba's sin; purified Earth.
#: data/nomenclature.fab:26954
msgctxt "crater"
msgid "Faro"
msgstr "ファロ"

#: data/nomenclature.fab:26954
msgctxt "origin"
msgid ""
"Mande; his sacrificial killing in heaven atoned for his twin Pemba's sin; "
"purified Earth."
msgstr "マンデ族神話; 天国での犠牲的な殺害は、双子のペンバの罪を償った。また大地を浄化した。"

#. TRANSLATORS: (Rhea); Sre and Ma (Mon-Khmer peoples, S. Vietnam) supreme
#. god, created people and fire.
#: data/nomenclature.fab:26956
msgctxt "crater"
msgid "Ndu"
msgstr "ンドゥ"

#: data/nomenclature.fab:26956
msgctxt "origin"
msgid ""
"Sre and Ma (Mon-Khmer peoples, S. Vietnam) supreme god, created people and "
"fire."
msgstr "スレ族とマー族 (ベトナムのモンクメール語族の人々) の最高神。人々と火を創造した。"

#. TRANSLATORS: (Rhea); Mordvinian (Volga River Finns, Russia) supreme god,
#. creator of the sky and the Earth.
#: data/nomenclature.fab:26958
msgctxt "crater"
msgid "Nishke"
msgstr "ニシュケ"

#: data/nomenclature.fab:26958
msgctxt "origin"
msgid ""
"Mordvinian (Volga River Finns, Russia) supreme god, creator of the sky and "
"the Earth."
msgstr "モルドヴィン人 (ロシア・ヴォルガ川のフィン系人) の最高神、空と大地の創造主。"

#. TRANSLATORS: (Rhea); Uitoto (Amazon basin, SW Colombia) creator god.
#: data/nomenclature.fab:26960
msgctxt "crater"
msgid "Nainema"
msgstr "ナイネマ"

#: data/nomenclature.fab:26960
msgctxt "origin"
msgid "Uitoto (Amazon basin, SW Colombia) creator god."
msgstr "ウイトト人 (コロンビア南西部アマゾン盆地) の創造神。 "

#. TRANSLATORS: (Rhea); Micronesian (Gilbert Islands/Kiribati) creator of the
#. universe; made the world from a mussel shell.
#: data/nomenclature.fab:26962
msgctxt "crater"
msgid "Nareau"
msgstr "ナレアウ"

#: data/nomenclature.fab:26962
msgctxt "origin"
msgid ""
"Micronesian (Gilbert Islands/Kiribati) creator of the universe; made the "
"world from a mussel shell."
msgstr "ミクロネシア (キリバスのギルバート諸島) の宇宙の創造主; ムール貝の殻から世界を作った。"

#: data/nomenclature.fab:26964
msgctxt "origin"
msgid "Marijan sky god."
msgstr "マリジャンの天空の神。"

#. TRANSLATORS: (Rhea); Mythological ancestor of the Armenian people.
#: data/nomenclature.fab:26966
msgctxt "crater"
msgid "Haik"
msgstr "ハイク"

#: data/nomenclature.fab:26966
msgctxt "origin"
msgid "Mythological ancestor of the Armenian people."
msgstr "アルメニア人の神話上の祖先。"

#. TRANSLATORS: (Rhea); Japanese creator god, brother of Izanami.
#: data/nomenclature.fab:26968
msgctxt "crater"
msgid "Izanagi"
msgstr "イザナギ"

#: data/nomenclature.fab:26968
msgctxt "origin"
msgid "Japanese creator god, brother of Izanami."
msgstr "日本の創造神、イザナミの弟。"

#. TRANSLATORS: (Rhea); Sister and wife of Izanagi; creator goddess.
#: data/nomenclature.fab:26970
msgctxt "crater"
msgid "Izanami"
msgstr "イザナミ"

#: data/nomenclature.fab:26970
msgctxt "origin"
msgid "Sister and wife of Izanagi; creator goddess."
msgstr "イザナギの姉妹で妻、創造の女神。"

#. TRANSLATORS: (Rhea); Ancient Hindu primordial being from whom the cosmos
#. was formed.
#: data/nomenclature.fab:26972
msgctxt "crater"
msgid "Purusa"
msgstr "プルサ"

#: data/nomenclature.fab:26972
msgctxt "origin"
msgid "Ancient Hindu primordial being from whom the cosmos was formed."
msgstr "古代ヒンズー教の宇宙が形成された原始的存在。"

#. TRANSLATORS: (Rhea); Incan creator god who became the moon.
#: data/nomenclature.fab:26974
msgctxt "crater"
msgid "Iraca"
msgstr "イラカ"

#: data/nomenclature.fab:26974
msgctxt "origin"
msgid "Incan creator god who became the moon."
msgstr "月になったインカの創造神。"

#. TRANSLATORS: (Rhea); Aranda (Australia) ancestor who, in his dreams, gives
#. birth to animals and male children.
#: data/nomenclature.fab:26976
msgctxt "crater"
msgid "Karora"
msgstr "カロラ"

#: data/nomenclature.fab:26976
msgctxt "origin"
msgid ""
"Aranda (Australia) ancestor who, in his dreams, gives birth to animals and "
"male children."
msgstr "アランダ (オーストラリア) の先祖。夢の中で動物と男の子を産む。"

#. TRANSLATORS: (Rhea); Nanajan; mythological hero who built the world. The
#. first Shaman.
#: data/nomenclature.fab:26978
msgctxt "crater"
msgid "Khado"
msgstr "カド"

#: data/nomenclature.fab:26978
msgctxt "origin"
msgid "Nanajan; mythological hero who built the world. The first Shaman."
msgstr "ナナジャ族; 世界を築いた神話の英雄。最初のシャーマン。"

#. TRANSLATORS: (Rhea); Jivaro (Ecuador) creator god.
#: data/nomenclature.fab:26980
msgctxt "crater"
msgid "Kumpara"
msgstr "クンパラ"

#: data/nomenclature.fab:26980
msgctxt "origin"
msgid "Jivaro (Ecuador) creator god."
msgstr "ヒバロ族 (エクアドル) の創造神。"

#. TRANSLATORS: (Rhea); Cuebo (Columbia) god who created creeks and rocks, and
#. stocked streams with fish.
#: data/nomenclature.fab:26982
msgctxt "crater"
msgid "Quwai"
msgstr "クワイ"

#: data/nomenclature.fab:26982
msgctxt "origin"
msgid ""
"Cuebo (Columbia) god who created creeks and rocks, and stocked streams with "
"fish."
msgstr "クエボ族 (コロンビア) の神。小川や岩を作り、小川に魚を蓄えた。"

#. TRANSLATORS: (Rhea); Tonga originator of the conditions of life.
#: data/nomenclature.fab:26984
msgctxt "crater"
msgid "Leza"
msgstr "レザ"

#: data/nomenclature.fab:26984
msgctxt "origin"
msgid "Tonga originator of the conditions of life."
msgstr "トンガでの生活スタイルを始めた者。"

#. TRANSLATORS: (Rhea); Dhammai (NE India) pre-existent male. He and his wife
#. Zumiang-Nui were the parents of the Earth and the sky.
#: data/nomenclature.fab:26986
msgctxt "crater"
msgid "Shuzanghu"
msgstr "シュザングー"

#: data/nomenclature.fab:26986
msgctxt "origin"
msgid ""
"Dhammai (NE India) pre-existent male. He and his wife Zumiang-Nui were the "
"parents of the Earth and the sky."
msgstr "ダンマイ (インド北東部) の元々存在していた男性。彼とその妻ズミアン=ヌイは地球と天空の両親だった。"

#. TRANSLATORS: (Rhea); Lapcha (Nepal) god who created the first man and woman
#. from the ice of mountain glaciers.
#: data/nomenclature.fab:26988
msgctxt "crater"
msgid "Tasheting"
msgstr "ターシャティン"

#: data/nomenclature.fab:26988
msgctxt "origin"
msgid ""
"Lapcha (Nepal) god who created the first man and woman from the ice of "
"mountain glaciers."
msgstr "山の氷河の氷から最初の男女を創造したラプチャ (またはレプチャ、ネパール) の神。"

#. TRANSLATORS: (Rhea); Yao (Bantu); creator god; left Earth to live in sky
#. when man was cruel to animals.
#: data/nomenclature.fab:26990
msgctxt "crater"
msgid "Malunga"
msgstr "マルンガ"

#: data/nomenclature.fab:26990
msgctxt "origin"
msgid ""
"Yao (Bantu); creator god; left Earth to live in sky when man was cruel to "
"animals."
msgstr "ヤオ族 (バンツー系民族) の創造神; 人間が動物に対して残酷だった時代には、地上を離れて空で暮らしていた。"

#. TRANSLATORS: (Rhea); Birhor (Jharkhand, E. India) creator god, who arises
#. out of the primordial waters through the stem of a lotus.
#: data/nomenclature.fab:26992
msgctxt "crater"
msgid "Singbonga"
msgstr "シンボンガ"

#: data/nomenclature.fab:26992
msgctxt "origin"
msgid ""
"Birhor (Jharkhand, E. India) creator god, who arises out of the primordial "
"waters through the stem of a lotus."
msgstr "ビルホル族 (インド東部ジャールカンド州) の創造神、蓮の茎を通して太古の水から出現した。"

#. TRANSLATORS: (Rhea); Minyong (India); original male.
#: data/nomenclature.fab:26994
msgctxt "crater"
msgid "Melo"
msgstr "メロ"

#: data/nomenclature.fab:26994
msgctxt "origin"
msgid "Minyong (India); original male."
msgstr "ミンヨン族 (インド) の最初の男性。"

#. TRANSLATORS: (Rhea); Kazakh (Central Asia) winged horse born in the deep
#. primordial ocean; personification of the sun and eternal movement.
#: data/nomenclature.fab:26996
msgctxt "crater"
msgid "Tulpar"
msgstr "トゥルパー"

#: data/nomenclature.fab:26996
msgctxt "origin"
msgid ""
"Kazakh (Central Asia) winged horse born in the deep primordial ocean; "
"personification of the sun and eternal movement."
msgstr "カザフ (中央アジア) 神話に登場する、太古の深い海で生まれた有翼馬; 太陽と永遠の動きを擬人化したもの。"

#. TRANSLATORS: (Rhea); Nenets and Selkup (Samoyed) god of heaven.
#: data/nomenclature.fab:26998
msgctxt "crater"
msgid "Num"
msgstr "ヌム"

#: data/nomenclature.fab:26998
msgctxt "origin"
msgid "Nenets and Selkup (Samoyed) god of heaven."
msgstr "ネネツ人とセリクプ人 (サモエード系民族) の天界の神。"

#. TRANSLATORS: (Rhea); Negrito (Malay Peninsula) god who created first men.
#: data/nomenclature.fab:27000
msgctxt "crater"
msgid "Pedn"
msgstr "ペドゥン"

#: data/nomenclature.fab:27000
msgctxt "origin"
msgid "Negrito (Malay Peninsula) god who created first men."
msgstr "ネグリト族 (マレー半島) の最初の人間を創造した神。"

#. TRANSLATORS: (Rhea); Itelmen (Kamchatka Peninsula, E. Russia) creator and
#. master of the world.
#: data/nomenclature.fab:27002
msgctxt "crater"
msgid "Utleygon"
msgstr "ウトレイゴン"

#: data/nomenclature.fab:27002
msgctxt "origin"
msgid ""
"Itelmen (Kamchatka Peninsula, E. Russia) creator and master of the world."
msgstr "イテリメン人 (ロシア東部カムチャッカ半島) の創造主で世界の覇者。"

#. TRANSLATORS: (Rhea); Father of gods and humans in Cook Islands mythology
#. (Polynesia).
#: data/nomenclature.fab:27004
msgctxt "crater"
msgid "Vatea"
msgstr "ヴァテア"

#: data/nomenclature.fab:27004
msgctxt "origin"
msgid "Father of gods and humans in Cook Islands mythology (Polynesia)."
msgstr "クック諸島 (ポリネシア) の神話における神々と人間の父親。"

#. TRANSLATORS: (Rhea); Persian progenitor god of light.
#: data/nomenclature.fab:27006
msgctxt "crater"
msgid "Ormazd"
msgstr "オルマズド"

#: data/nomenclature.fab:27006
msgctxt "origin"
msgid "Persian progenitor god of light."
msgstr "ペルシアの光の始祖神。"

#. TRANSLATORS: (Rhea); Miao; creator of all things.
#: data/nomenclature.fab:27008
msgctxt "crater"
msgid "Pan Ku"
msgstr "パン・クー"

#: data/nomenclature.fab:27008
msgctxt "origin"
msgid "Miao; creator of all things."
msgstr "ミャオ族; 万物の創造主。"

#. TRANSLATORS: (Rhea); Ethiopian creator god, “Father of the Universe.”
#: data/nomenclature.fab:27010
msgctxt "crater"
msgid "Wak"
msgstr "ワク"

#: data/nomenclature.fab:27010
msgctxt "origin"
msgid "Ethiopian creator god, “Father of the Universe.”"
msgstr "エチオピアの創造神、「宇宙の父」を意味する。"

#. TRANSLATORS: (Rhea); The Great Raven, creator and cultural hero in Tlingit
#. (SE Alaska) myths.
#: data/nomenclature.fab:27012
msgctxt "crater"
msgid "Yehl"
msgstr "イェル"

#: data/nomenclature.fab:27012
msgctxt "origin"
msgid ""
"The Great Raven, creator and cultural hero in Tlingit (SE Alaska) myths."
msgstr "トリンギット(アラスカ南東部) 神話に登場する大カラス、創造者であり文化的英雄。"

#. TRANSLATORS: (Rhea); Estonian super god.
#: data/nomenclature.fab:27014
msgctxt "crater"
msgid "Uku"
msgstr "ウク"

#: data/nomenclature.fab:27014
msgctxt "origin"
msgid "Estonian super god."
msgstr "エストニアの超神。"

#. TRANSLATORS: (Rhea); Abkhaz (Georgian - eastern Black Sea region) supreme
#. being.
#: data/nomenclature.fab:27016
msgctxt "crater"
msgid "Tika"
msgstr "ティカ"

#: data/nomenclature.fab:27016
msgctxt "origin"
msgid "Abkhaz (Georgian - eastern Black Sea region) supreme being."
msgstr "アブハズ (ジョージアから黒海東岸地域) の最高の存在。"

#. TRANSLATORS: (Rhea); Tahitian god imminent in all creation; existed alone
#. in the void.
#: data/nomenclature.fab:27018
msgctxt "crater"
msgid "Taaroa"
msgstr "ターロア"

#: data/nomenclature.fab:27018
msgctxt "origin"
msgid "Tahitian god imminent in all creation; existed alone in the void."
msgstr "全ての創造物が差し迫ったタヒチの神; 何も無い場所に一人で居る。"

#. TRANSLATORS: (Rhea); Inca creator of all things.
#: data/nomenclature.fab:27020
msgctxt "crater"
msgid "Thunupa"
msgstr "トゥヌパ"

#. TRANSLATORS: (Rhea); Great spirit of Pawnee Tribe (USA), created first men;
#. his messengers were the planets, stars, lightning and thunder.
#: data/nomenclature.fab:27022
msgctxt "crater"
msgid "Tirawa"
msgstr "ティラワ"

#: data/nomenclature.fab:27022
msgctxt "origin"
msgid ""
"Great spirit of Pawnee Tribe (USA), created first men; his messengers were "
"the planets, stars, lightning and thunder."
msgstr "ポーニー族 (米国) の最初の人間を作った偉大なる精霊; 彼の使者が惑星、星、稲妻、雷鳴だった。"

#. TRANSLATORS: (Rhea); Ostyak (western Siberia) sky god.
#: data/nomenclature.fab:27024
msgctxt "crater"
msgid "Torom"
msgstr "トロム"

#: data/nomenclature.fab:27024
msgctxt "origin"
msgid "Ostyak (western Siberia) sky god."
msgstr "オスチャーク (西シベリア) の天神。"

#. TRANSLATORS: (Rhea); Bushman creator.
#: data/nomenclature.fab:27026
msgctxt "crater"
msgid "Xu"
msgstr "クシュ"

#: data/nomenclature.fab:27026
msgctxt "origin"
msgid "Bushman creator."
msgstr "ブッシュマンの創造主。"

#. TRANSLATORS: (Rhea); Bushman supreme being, creator of all things.
#: data/nomenclature.fab:27028
msgctxt "crater"
msgid "Xamba"
msgstr "サムバ"

#: data/nomenclature.fab:27028
msgctxt "origin"
msgid "Bushman supreme being, creator of all things."
msgstr "ブッシュマンの最高の存在、万物の創造主。"

#. TRANSLATORS: (Rhea); "August Personage of Jade"; supreme primal Chinese
#. god.
#: data/nomenclature.fab:27030
msgctxt "crater"
msgid "Yu-Ti"
msgstr "ユー=チー"

#: data/nomenclature.fab:27030
msgctxt "origin"
msgid "”August Personage of Jade”; supreme primal Chinese god."
msgstr "玉帝;「玉皇大帝」、中国神話で原初の最高神。"

#. TRANSLATORS: (Rhea); Manchurian creator of all things.
#: data/nomenclature.fab:27032
msgctxt "crater"
msgid "Haoso"
msgstr "ハオソ"

#: data/nomenclature.fab:27032
msgctxt "origin"
msgid "Manchurian creator of all things."
msgstr "満洲族の万物の創造主。"

#: data/nomenclature.fab:27034
msgctxt "origin"
msgid "Buriat (Siberia) devil who creates."
msgstr "ブリヤート (シベリア) の創造する悪魔。"

#. TRANSLATORS: (Rhea); Marshall Islands (Micronesia) great creator god.
#: data/nomenclature.fab:27036
msgctxt "crater"
msgid "Lowa"
msgstr "ロワ"

#: data/nomenclature.fab:27036
msgctxt "origin"
msgid "Marshall Islands (Micronesia) great creator god."
msgstr "マーシャル諸島 (ミクロネシア) の偉大なる創造神。"

#. TRANSLATORS: (Rhea); New Hebrides (Melanesia); born from a stone; formed
#. men out of trees.
#: data/nomenclature.fab:27038
msgctxt "crater"
msgid "Qat"
msgstr "クァト"

#: data/nomenclature.fab:27038
msgctxt "origin"
msgid "New Hebrides (Melanesia); born from a stone; formed men out of trees."
msgstr "ニューヘブリディーズ諸島 (メラネシア) の神話; 石から生まれ、木から人間を作った。"

#. TRANSLATORS: (Rhea); Auracanin creator of men and bringer of civilization.
#: data/nomenclature.fab:27040
msgctxt "crater"
msgid "Heller"
msgstr "ヘラー"

#: data/nomenclature.fab:27040
msgctxt "origin"
msgid "Auracanin creator of men and bringer of civilization."
msgstr "アウラカニの人類の創造者、文明をもたらした者。"

#. TRANSLATORS: (Rhea); Tuamotu (Society Islands) progenitor being; existed in
#. void; made land, sea.
#: data/nomenclature.fab:27042
msgctxt "crater"
msgid "Kiho"
msgstr "キホ"

#: data/nomenclature.fab:27042
msgctxt "origin"
msgid ""
"Tuamotu (Society Islands) progenitor being; existed in void; made land, sea."
msgstr "ツアモツ (ソシエテ諸島) の祖先の存在、虚空に存在した。陸地、海を作った。"

#. TRANSLATORS: (Rhea); Negrito (Malay Peninsula) female progenitor goddess;
#. wife of Pedn.
#: data/nomenclature.fab:27044
msgctxt "crater"
msgid "Manoid"
msgstr "マノイド"

#: data/nomenclature.fab:27044
msgctxt "origin"
msgid "Negrito (Malay Peninsula) female progenitor goddess; wife of Pedn."
msgstr "ネグリト族 (マレー半島) の女性の始祖の女神。ペドゥンの妻。"

#. TRANSLATORS: (Rhea); Korean creator of all things.
#: data/nomenclature.fab:27046
msgctxt "crater"
msgid "Whanin"
msgstr "ファニン"

#: data/nomenclature.fab:27046
msgctxt "origin"
msgid "Korean creator of all things."
msgstr "朝鮮の万物の創造主。"

#. TRANSLATORS: (Rhea); Kakadu (Australia) ancestor of all people; a giant.
#: data/nomenclature.fab:27048
msgctxt "crater"
msgid "Wuraka"
msgstr "ウラカ"

#: data/nomenclature.fab:27048
msgctxt "origin"
msgid "Kakadu (Australia) ancestor of all people; a giant."
msgstr "カカドゥ (オーストラリア北部) の全ての人類の祖先; 一人の巨人。"

#. TRANSLATORS: (Rhea); Tibetan heavenly god.
#: data/nomenclature.fab:27050
msgctxt "crater"
msgid "Mubai"
msgstr "ムバイ"

#: data/nomenclature.fab:27050
msgctxt "origin"
msgid "Tibetan heavenly god."
msgstr "チベットの天神。"

#. TRANSLATORS: (Rhea); Mythological ancestor of the Buriat tribe.
#: data/nomenclature.fab:27052
msgctxt "crater"
msgid "Bulagat"
msgstr "ブラガト"

#: data/nomenclature.fab:27052
msgctxt "origin"
msgid "Mythological ancestor of the Buriat tribe."
msgstr "ブリヤート族の神話上の祖先。"

#. TRANSLATORS: (Rhea); Ainu (Japan) god of the heavens, who gave the Ainus
#. civilization and taught them hunting and fishing.
#: data/nomenclature.fab:27054
msgctxt "crater"
msgid "Okikurumi"
msgstr "オキクルミ"

#: data/nomenclature.fab:27054
msgctxt "origin"
msgid ""
"Ainu (Japan) god of the heavens, who gave the Ainus civilization and taught "
"them hunting and fishing."
msgstr "アイヌ (日本) の天神、アイヌに文明を与え狩猟と漁業を教えた。(アイヌラックルの別名。)"

#. TRANSLATORS: (Rhea); Nganasan (Taymyr Peninsula Samoyed, Russia) mythical
#. mountain range, the first land to appear from the primordial waters after
#. creation. The first man and woman were placed on it.
#: data/nomenclature.fab:27056
msgctxt "catena"
msgid "Koykamou Catena"
msgstr "コイカモウ連鎖クレーター"

#: data/nomenclature.fab:27056
msgctxt "origin"
msgid ""
"Nganasan (Taymyr Peninsula Samoyed, Russia) mythical mountain range, the "
"first land to appear from the primordial waters after creation. The first "
"man and woman were placed on it."
msgstr ""
"ガナサン人 (ロシア、タイミル半島に住むサモエード系民族) の神話に登場する山脈、創造後に原始の水から現れた最初の陸地。最初の男と女がそこに置かれた。"

#. TRANSLATORS: (Rhea); Holy land created by Persian god Ahura Mazda (Ormazd);
#. modern Mary/Merv Oasis, Turkmenistan.
#: data/nomenclature.fab:27058
msgctxt "catena"
msgid "Mouru Catena"
msgstr "モウル連鎖クレーター"

#: data/nomenclature.fab:27058
msgctxt "origin"
msgid ""
"Holy land created by Persian god Ahura Mazda (Ormazd); modern Mary/Merv "
"Oasis, Turkmenistan."
msgstr "ペルシャの神アフラ・マズダ (オルマズド) が創造した聖地; 現在のトルクメニスタンにあるマリ/メルヴ・オアシス。"

#. TRANSLATORS: (Rhea); Island in Japanese mythology formed by a drop of water
#. that fell from a sword held by the primeval deities Izanagi and Izanami.
#: data/nomenclature.fab:27060
msgctxt "catena"
msgid "Onokoro Catenae"
msgstr "オノコロ連鎖クレーター"

#: data/nomenclature.fab:27060
msgctxt "origin"
msgid ""
"Island in Japanese mythology formed by a drop of water that fell from a "
"sword held by the primeval deities Izanagi and Izanami."
msgstr "日本神話に登場する島。太古の神イザナギとイザナミが持つ剣から落ちた一滴の水によって形作られた。"

#. TRANSLATORS: (Rhea); Holy mountain in Korean mythology, where creator god
#. came onto the earth.
#: data/nomenclature.fab:27062
msgctxt "catena"
msgid "Thebeksan Catena"
msgstr "テベクサン連鎖クレーター"

#: data/nomenclature.fab:27062
msgctxt "origin"
msgid ""
"Holy mountain in Korean mythology, where creator god came onto the earth."
msgstr "太伯山; 朝鮮神話の聖なる山、創造神が地球に降り立った場所。"

#. TRANSLATORS: (Rhea); Place where Kakadu (N. Australia) creator goddess
#. Imberombera landed after crossing the sea (modern Malay Bay). There he met
#. the giant Wuraka, ancestor of all peoples.
#: data/nomenclature.fab:27064
msgctxt "catena"
msgid "Wungaran Catenae"
msgstr "ウンガラン連鎖クレーター"

#: data/nomenclature.fab:27064
msgctxt "origin"
msgid ""
"Place where Kakadu (N. Australia) creator goddess Imberombera landed after "
"crossing the sea (modern Malay Bay). There he met the giant Wuraka, ancestor"
" of all peoples."
msgstr ""
"カカドゥ (オーストラリア北部) の創造主の女神インベロンベラが海 (現在のマレー湾) "
"を渡って上陸した場所。そこで彼は、すべての民族の祖先である巨人のウラカに出会いました。"

#. TRANSLATORS: (Rhea); Mountain in Chinese mythology attacked by horned
#. monster Kung Chung, resulting in the Earth’s axis becoming tilted.
#: data/nomenclature.fab:27066
msgctxt "catena"
msgid "Puchou Catenae"
msgstr "プチョウ連鎖クレーター"

#: data/nomenclature.fab:27066
msgctxt "origin"
msgid ""
"Mountain in Chinese mythology attacked by horned monster Kung Chung, "
"resulting in the Earth’s axis becoming tilted."
msgstr "中国神話に登場する角を持った怪物クン・チュンが登る山。その結果、地軸が傾いた。"

#. TRANSLATORS: (Rhea); Underworld in mythology of Cook Islands (Polynesia),
#. home for mother of Vatea, the ancestor of gods and humans.
#: data/nomenclature.fab:27068
msgctxt "chasma"
msgid "Avaiki Chasmata"
msgstr "アヴァイキ・カズマ地形"

#: data/nomenclature.fab:27068
msgctxt "origin"
msgid ""
"Underworld in mythology of Cook Islands (Polynesia), home for mother of "
"Vatea, the ancestor of gods and humans."
msgstr "クック諸島 (ポリネシア) の神話における冥界、ヴァテアの母親の故郷、神々と人間の祖先。"

#. TRANSLATORS: (Rhea); Vault above the sky in Cherokee (SE USA) myths, where
#. anything that was alive lived before the creation of Earth.
#: data/nomenclature.fab:27070
msgctxt "chasma"
msgid "Galunlati Chasmata"
msgstr "ガルンラティ・カズマ地形"

#: data/nomenclature.fab:27070
msgctxt "origin"
msgid ""
"Vault above the sky in Cherokee (SE USA) myths, where anything that was "
"alive lived before the creation of Earth."
msgstr "チェロキー族 (米国南東部) 神話に登場する空の上の丸天井。地球が創造される前にあらゆる生物が生息していた場所。"

#. TRANSLATORS: (Rhea); Mount in Igorot (Luzon Island, Philippines) mythology,
#. on the peak of which the palace of creator god Lumawig is located.
#: data/nomenclature.fab:27072
msgctxt "chasma"
msgid "Pulag Chasma"
msgstr "プラグ・カズマ地形"

#: data/nomenclature.fab:27072
msgctxt "origin"
msgid ""
"Mount in Igorot (Luzon Island, Philippines) mythology, on the peak of which "
"the palace of creator god Lumawig is located."
msgstr "イゴロット族 (フィリピン、ルソン島) の神話に登場する山。頂上に創造神ルマウィグの宮殿が鎮座する。"

#. TRANSLATORS: (Rhea); River in Cuebo (Columbia) myths, where the Cuebo
#. people were born.
#: data/nomenclature.fab:27074
msgctxt "chasma"
msgid "Vaupas Chasma"
msgstr "ヴァウパス・カズマ地形"

#: data/nomenclature.fab:27074
msgctxt "origin"
msgid "River in Cuebo (Columbia) myths, where the Cuebo people were born."
msgstr "クエボ族 (コロンビア) の神話に登場する川。クエボの人たちが生まれた所。"

#. TRANSLATORS: (Rhea); Lodge of the North Wind in Klamath (NW USA) myth,
#. where the creator god Kemush slept during the creation of the world.
#: data/nomenclature.fab:27076
msgctxt "chasma"
msgid "Yamsi Chasmata"
msgstr "ヤムシ・カズマ地形"

#: data/nomenclature.fab:27076
msgctxt "origin"
msgid ""
"Lodge of the North Wind in Klamath (NW USA) myth, where the creator god "
"Kemush slept during the creation of the world."
msgstr "クラマス族 (米国北西部) の神話に登場する北風のロッジ。世界創造の時に創造神ケムシュが眠った場所。"

#. TRANSLATORS: (Rhea); Beautiful land created by Persian god Ahura Mazda
#. (Ormazd); modern Kandahar, Afghanistan.
#: data/nomenclature.fab:27078
msgctxt "fossa"
msgid "Harahvaiti Fossa"
msgstr "ハラーヴァイティ地溝帯"

#: data/nomenclature.fab:27078
msgctxt "origin"
msgid ""
"Beautiful land created by Persian god Ahura Mazda (Ormazd); modern Kandahar,"
" Afghanistan."
msgstr "ペルシャの神アフラ・マズダ (オルマズド) が創造した美しい土地; 現在のアフガニスタン、カンダハル。"

#. TRANSLATORS: (Rhea); Nuristan (NE Afghanistan) river in which Bagisht, the
#. creator of people, was born by the mother goddess Disani.
#: data/nomenclature.fab:27080
msgctxt "fossa"
msgid "Parun Fossa"
msgstr "パルン地溝帯"

#: data/nomenclature.fab:27080
msgctxt "origin"
msgid ""
"Nuristan (NE Afghanistan) river in which Bagisht, the creator of people, was"
" born by the mother goddess Disani."
msgstr "ヌリスタン（アフガニスタン北東部）の川。母なる女神ディサニが人々の創造者であるバギシュトを産んだ川。"

#. TRANSLATORS: (Rhea); Kikuyu (Kenya) holy mountain, where the creator god
#. Ngai lives, when he came down from the sky (Mount Kenya).
#: data/nomenclature.fab:27082
msgctxt "linea"
msgid "Kirinyaga Linea"
msgstr "キリニャガ線紋"

#: data/nomenclature.fab:27082
msgctxt "origin"
msgid ""
"Kikuyu (Kenya) holy mountain, where the creator god Ngai lives, when he came"
" down from the sky (Mount Kenya)."
msgstr "キクユ族 (ケニア) の聖なる山、創造神ンガイが空から降りてきたときに住んでいる山 (ケニア山) 。"

#. TRANSLATORS: (Rhea); Mountain in Chinese mythology, dwelling place of the
#. immortals, location of palace of Hsi Wang Mu (Xiwangmu), the Queen Mother
#. of the West.
#: data/nomenclature.fab:27084
msgctxt "linea"
msgid "Kunlun Linea"
msgstr "クンルン線紋"

#: data/nomenclature.fab:27084
msgctxt "origin"
msgid ""
"Mountain in Chinese mythology, dwelling place of the immortals, location of "
"palace of Hsi Wang Mu (Xiwangmu), the Queen Mother of the West."
msgstr "崑崙; 中国神話に登場する山、仙人の住処、西王母 (Hsi Wang Mu、またはXiwangmu) の宮殿がある場所。"

#. TRANSLATORS: (Ryugu); Protagonist of a fairy tale Cendrillon by French
#. writer Charles Perrault (1697), also known as Cinderella.
#: data/nomenclature.fab:27086
msgctxt "crater"
msgid "Cendrillon"
msgstr "サンドリヨン"

#: data/nomenclature.fab:27086
msgctxt "origin"
msgid ""
"Protagonist of a fairy tale Cendrillon by French writer Charles Perrault "
"(1697), also known as Cinderella."
msgstr "フランスの作家シャルル・ペローによる童話『サンドリヨン』 (1697年) の主人公、シンデレラとも呼ばれる。"

#. TRANSLATORS: (Ryugu); ‘Golden Boy’ in Japanese fairy tale, who grew up in
#. the wild forests of Mount Ashigara and had a superhuman strength.
#: data/nomenclature.fab:27088
msgctxt "crater"
msgid "Kintaro"
msgstr "キンタロ"

#: data/nomenclature.fab:27088
msgctxt "origin"
msgid ""
"‘Golden Boy’ in Japanese fairy tale, who grew up in the wild forests of "
"Mount Ashigara and had a superhuman strength."
msgstr "日本のおとぎ話に登場する「金太郎」。足柄山の原生林で育ち、超人的な力を持った。"

#. TRANSLATORS: (Ryugu); Urashima Taro; fisherman in Japanese fairy tale who
#. rescued a turtle and traveled on its back to the dragon Ryujin’s undersea
#. Ryugu Palace, where he was welcomed by princess Otohime.
#: data/nomenclature.fab:27090
msgctxt "crater"
msgid "Urashima"
msgstr "ウラシマ"

#: data/nomenclature.fab:27090
msgctxt "origin"
msgid ""
"Urashima Taro; fisherman in Japanese fairy tale who rescued a turtle and "
"traveled on its back to the dragon Ryujin’s undersea Ryugu Palace, where he "
"was welcomed by princess Otohime."
msgstr "浦島太郎; 日本のおとぎ話に登場する漁師で、亀を助け、その背中に乗って龍神の住む海底の龍宮まで行き、そこで乙姫様に歓迎された。"

#. TRANSLATORS: (Ryugu); A brave young fellow, who defeated a giant, from
#. Dutch fairy tale.
#: data/nomenclature.fab:27092
msgctxt "crater"
msgid "Brabo"
msgstr "ブラボー"

#: data/nomenclature.fab:27092
msgctxt "origin"
msgid "A brave young fellow, who defeated a giant, from Dutch fairy tale."
msgstr "オランダのおとぎ話に出てくる、巨人を倒した勇敢な若い男。"

#. TRANSLATORS: (Ryugu); Small ball-like bun, which ran away from home and
#. rolled on the road, singing his tricky song; protagonist of a Russian fairy
#. tale.
#: data/nomenclature.fab:27094
msgctxt "crater"
msgid "Kolobok"
msgstr "コロボーク"

#: data/nomenclature.fab:27094
msgctxt "origin"
msgid ""
"Small ball-like bun, which ran away from home and rolled on the road, "
"singing his tricky song; protagonist of a Russian fairy tale."
msgstr "家から逃げ出し、トリッキーな歌を歌いながら道を転がる小さなボールのような丸パン。ロシアのおとぎ話の主人公。"

#. TRANSLATORS: (Ryugu); ‘Peach Boy’ in Japanese fairy tale, who came to Earth
#. inside a giant peach and once undertook a journey to fight horned ogres in
#. a distant island.
#: data/nomenclature.fab:27096
msgctxt "crater"
msgid "Momotaro"
msgstr "モモタロ"

#: data/nomenclature.fab:27096
msgctxt "origin"
msgid ""
"‘Peach Boy’ in Japanese fairy tale, who came to Earth inside a giant peach "
"and once undertook a journey to fight horned ogres in a distant island."
msgstr "日本のおとぎ話に登場する「桃太郎」。巨大な桃の中から地上に来て、かつて遠い島で角のある鬼と戦う旅に出た。"

#. TRANSLATORS: (Ryugu); Japanese ball-like dumplings made from the flour of
#. the kibi (proso millet) grain that the fairy tale hero Momotaro brought on
#. his distant journey because this sweet keeps its softness for a long time.
#: data/nomenclature.fab:27098
msgctxt "crater"
msgid "Kibidango"
msgstr "キビダンゴ"

#: data/nomenclature.fab:27098
msgctxt "origin"
msgid ""
"Japanese ball-like dumplings made from the flour of the kibi (proso millet) "
"grain that the fairy tale hero Momotaro brought on his distant journey "
"because this sweet keeps its softness for a long time."
msgstr "おとぎ話の主人公、桃太郎が遠い旅に持って行ったキビの粉を使った団子で、柔らかさが長持ちします。"

#. TRANSLATORS: (Ryugu); ‘Dragon god’, sea ruler in Japanese fairy tale,
#. father of princess Otohime, master of the undersea Ryugu Palace where
#. fisherman Urashima Taro was a guest.
#: data/nomenclature.fab:27100
msgctxt "dorsum"
msgid "Ryujin Dorsum"
msgstr "リュージン尾根"

#: data/nomenclature.fab:27100
msgctxt "origin"
msgid ""
"‘Dragon god’, sea ruler in Japanese fairy tale, father of princess Otohime, "
"master of the undersea Ryugu Palace where fisherman Urashima Taro was a "
"guest."
msgstr "「龍神」、日本のおとぎ話に登場する海の支配者、乙姫の父、漁師の浦島太郎が客として訪れた海底にある龍宮の主。"

#. TRANSLATORS: (Ryugu); Immortal world of Japanese mythology, eternal,
#. timeless land across the sea or undersea kingdom, where the princess
#. Otohime lives in the fairy tale about the fisherman Urashima.
#: data/nomenclature.fab:27102
msgctxt "fossa"
msgid "Tokoyo Fossa"
msgstr "トコヨ地溝帯"

#: data/nomenclature.fab:27102
msgctxt "origin"
msgid ""
"Immortal world of Japanese mythology, eternal, timeless land across the sea "
"or undersea kingdom, where the princess Otohime lives in the fairy tale "
"about the fisherman Urashima."
msgstr "日本神話の不滅の世界、永遠の時を超えた海の向こうの地、あるいは海底の王国、漁師浦島のおとぎ話の中で乙姫様が住んでいる場所。"

#. TRANSLATORS: (Ryugu); Mythical Mount Horai (Penglai in Chinese), paradise
#. of the immortals; in some versions of the Japanese fairy tale about
#. fisherman Urashima is located in the sea on the shell of tortoise that
#. princess Otohime has turned into.
#: data/nomenclature.fab:27104
msgctxt "fossa"
msgid "Horai Fossa"
msgstr "ホーライ地溝帯"

#: data/nomenclature.fab:27104
msgctxt "origin"
msgid ""
"Mythical Mount Horai (Penglai in Chinese), paradise of the immortals; in "
"some versions of the Japanese fairy tale about fisherman Urashima is located"
" in the sea on the shell of tortoise that princess Otohime has turned into."
msgstr ""
"神話上の蓬莱山（中国語で蓬莱）、仙人の楽園; 漁師浦島についての日本のおとぎ話のいくつかのバージョンでは海中で、乙姫様が変身した亀の甲羅の上にあります。"

#. TRANSLATORS: (Ryugu); Seacoast in Japanese fairy tale where fisherman
#. Urashima Taro rescued a turtle and started his journey to the undersea
#. Ryugu Palace.
#: data/nomenclature.fab:27106
msgctxt "saxum"
msgid "Ejima Saxum"
msgstr "エジマ岩塊"

#: data/nomenclature.fab:27106
msgctxt "origin"
msgid ""
"Seacoast in Japanese fairy tale where fisherman Urashima Taro rescued a "
"turtle and started his journey to the undersea Ryugu Palace."
msgstr "日本のおとぎ話に登場する海岸。漁師の浦島太郎が亀を助け、海底の竜宮城への旅を始めた場所。"

#. TRANSLATORS: (Ryugu); Smart boy, who marked a trail in the woods with corn
#. meal to know the way back, from Cajun (Southern USA) fairy tale.
#: data/nomenclature.fab:27108
msgctxt "saxum"
msgid "Catafo Saxum"
msgstr "カタフォ岩塊"

#: data/nomenclature.fab:27108
msgctxt "origin"
msgid ""
"Smart boy, who marked a trail in the woods with corn meal to know the way "
"back, from Cajun (Southern USA) fairy tale."
msgstr "ケイジャン人 (米国南部) のおとぎ話に登場する賢い少年。森の中にトウモロコシの粉で帰る方法を知らせ、帰り道を印した。"

#. TRANSLATORS: (Ryugu); Otohime Sama; princess in Japanese fairy tale, sea
#. mistress, who welcomed fisherman Urashima Taro in undersea Ryugu Palace and
#. gave him a parting gift, a jewel box whose lid he was told never to open.
#: data/nomenclature.fab:27110
msgctxt "saxum"
msgid "Otohime Saxum"
msgstr "オトヒメ岩塊"

#: data/nomenclature.fab:27110
msgctxt "origin"
msgid ""
"Otohime Sama; princess in Japanese fairy tale, sea mistress, who welcomed "
"fisherman Urashima Taro in undersea Ryugu Palace and gave him a parting "
"gift, a jewel box whose lid he was told never to open."
msgstr ""
"乙姫様; "
"日本のおとぎ話に登場するお姫様で、海底の竜宮城で漁師の浦島太郎を迎え、別れの贈り物として決して開けてはいけないと言われている宝石箱を贈った海の女主人。"

#. TRANSLATORS: (Steins); Green gemstone, a variety of the mineral beryl.
#: data/nomenclature.fab:27112
msgctxt "crater"
msgid "Emerald"
msgstr "エメラルド"

#: data/nomenclature.fab:27112
msgctxt "origin"
msgid "Green gemstone, a variety of the mineral beryl."
msgstr "和名 : 翠玉、緑玉 ; 緑色の宝石、ベリル (緑柱石) の一種。"

#. TRANSLATORS: (Steins); Volcanic glass used as a gemstone.
#: data/nomenclature.fab:27114
msgctxt "crater"
msgid "Obsidian"
msgstr "オブシディアン"

#: data/nomenclature.fab:27114
msgctxt "origin"
msgid "Volcanic glass used as a gemstone."
msgstr "和名 : 黒曜石 ; 宝石として扱われる火山性ガラス。"

#. TRANSLATORS: (Steins); Red to violet-red gemstone, a variety of the mineral
#. garnet.
#: data/nomenclature.fab:27116
msgctxt "crater"
msgid "Almandine"
msgstr "アルマンディン"

#: data/nomenclature.fab:27116
msgctxt "origin"
msgid "Red to violet-red gemstone, a variety of the mineral garnet."
msgstr "和名 : 鉄礬柘榴石 ; 赤から紫がかった赤色の宝石、ガーネット (和名:石榴石) の一種。"

#. TRANSLATORS: (Steins); Blue-green and light blue gemstone, a variety of the
#. mineral beryl.
#: data/nomenclature.fab:27118
msgctxt "crater"
msgid "Aquamarine"
msgstr "アクアマリン"

#: data/nomenclature.fab:27118
msgctxt "origin"
msgid "Blue-green and light blue gemstone, a variety of the mineral beryl."
msgstr "和名:藍玉、水宝玉 ; 青緑と水色の宝石、ベリル (緑柱石) の一種。"

#. TRANSLATORS: (Steins); Opaque blue-to-green mineral of arid climates that
#. has been used as a gemstone for thousands of years.
#: data/nomenclature.fab:27120
msgctxt "crater"
msgid "Turquoise"
msgstr "ターコイズ"

#: data/nomenclature.fab:27120
msgctxt "origin"
msgid ""
"Opaque blue-to-green mineral of arid climates that has been used as a "
"gemstone for thousands of years."
msgstr "和名:トルコ石 ; 乾燥地域で産出する不透明な青から緑色の鉱物、何千年もの間宝石として使用されてきた。"

#. TRANSLATORS: (Steins); Yellow or brownish-green gemstone, the third hardest
#. gemstone after diamond and sapphire.
#: data/nomenclature.fab:27122
msgctxt "crater"
msgid "Chrysoberyl"
msgstr "クリソベリル"

#: data/nomenclature.fab:27122
msgctxt "origin"
msgid ""
"Yellow or brownish-green gemstone, the third hardest gemstone after diamond "
"and sapphire."
msgstr "和名:金緑石 ; 黄色または茶色がかった緑色の宝石、 ダイヤモンド、サファイアに次いで3番目に硬い宝石。"

#. TRANSLATORS: (Steins); Gemstone notable for its color change, appearing
#. green in daylight, but red under incandescent light; a variety of
#. chrysoberyl.
#: data/nomenclature.fab:27124
msgctxt "crater"
msgid "Alexandrite"
msgstr "アレクサンドライト"

#: data/nomenclature.fab:27124
msgctxt "origin"
msgid ""
"Gemstone notable for its color change, appearing green in daylight, but red "
"under incandescent light; a variety of chrysoberyl."
msgstr "色の変化が特徴的な宝石。日光の下では緑色に見えるが白熱電球の下では赤色に見える。金緑石 (クリソベリル) の一種。"

#. TRANSLATORS: (Steins); Light bluish-green gemstone, a variety of the
#. mineral orthoclase.
#: data/nomenclature.fab:27126
msgctxt "crater"
msgid "Amazonite"
msgstr "アマゾナイト"

#: data/nomenclature.fab:27126
msgctxt "origin"
msgid "Light bluish-green gemstone, a variety of the mineral orthoclase."
msgstr "天河石とも; 明るい青緑色の宝石で、オーソクレース (正長石) の一種。"

#. TRANSLATORS: (Steins); Translucent to opaque gemstone, usually banded or
#. rich green and often found with azurite.
#: data/nomenclature.fab:27128
msgctxt "crater"
msgid "Malachite"
msgstr "マラカイト"

#: data/nomenclature.fab:27128
msgctxt "origin"
msgid ""
"Translucent to opaque gemstone, usually banded or rich green and often found"
" with azurite."
msgstr "和名:孔雀石 ; 半透明から不透明の宝石、通常は縞模様または濃い緑色で、アズライト (和名:藍銅鉱) と一緒に見つかることがよくある。"

#. TRANSLATORS: (Steins); All colors of gemstones of the mineral corundum
#. (except red, which is the gemstone ruby) are called sapphires.
#: data/nomenclature.fab:27130
msgctxt "crater"
msgid "Sapphire"
msgstr "サファイア"

#: data/nomenclature.fab:27130
msgctxt "origin"
msgid ""
"All colors of gemstones of the mineral corundum (except red, which is the "
"gemstone ruby) are called sapphires."
msgstr "和名:蒼玉、青玉 ; コランダム (鋼玉) のうち全ての色 (赤色を除く、赤色のものはルビーと呼ばれる) の宝石をサファイアと呼ぶ。"

#. TRANSLATORS: (Steins); Gemstone that occurs in a wide variety of colors.
#: data/nomenclature.fab:27132
msgctxt "crater"
msgid "Topaz"
msgstr "トパーズ"

#: data/nomenclature.fab:27132
msgctxt "origin"
msgid "Gemstone that occurs in a wide variety of colors."
msgstr "和名:黄玉 ; 多種多様な色が存在する宝石。"

#. TRANSLATORS: (Steins); Violet gemstone, a variety of the mineral quartz.
#: data/nomenclature.fab:27134
msgctxt "crater"
msgid "Amethyst"
msgstr "アメシスト"

#: data/nomenclature.fab:27134
msgctxt "origin"
msgid "Violet gemstone, a variety of the mineral quartz."
msgstr "和名:紫水晶 ; 紫色の宝石、クォーツ (石英) の一種。"

#. TRANSLATORS: (Steins); Non-crystalline gemstone noted for its rich play of
#. colors when turned in the light.
#: data/nomenclature.fab:27136
msgctxt "crater"
msgid "Opal"
msgstr "オパール"

#: data/nomenclature.fab:27136
msgctxt "origin"
msgid ""
"Non-crystalline gemstone noted for its rich play of colors when turned in "
"the light."
msgstr "和名:蛋白石 ; 光に当てると豊かな遊色効果が見えることで知られる非結晶質の宝石。"

#. TRANSLATORS: (Steins); Group of related minerals found in a variety of
#. colors and often cut as gemstones.
#: data/nomenclature.fab:27138
msgctxt "crater"
msgid "Garnet"
msgstr "ガーネット"

#: data/nomenclature.fab:27138
msgctxt "origin"
msgid ""
"Group of related minerals found in a variety of colors and often cut as "
"gemstones."
msgstr "和名:柘榴石 ; さまざまな色があり、宝石としてカットされることが多い鉱物グループ。"

#. TRANSLATORS: (Steins); Gemstone variety of the mineral chalcedony.
#: data/nomenclature.fab:27140
msgctxt "crater"
msgid "Onyx"
msgstr "オニキス"

#: data/nomenclature.fab:27140
msgctxt "origin"
msgid "Gemstone variety of the mineral chalcedony."
msgstr "宝石、カルセドニー (和名:玉髄) の変種。"

#. TRANSLATORS: (Steins); Banded gemstone, variety of the mineral chalcedony.
#: data/nomenclature.fab:27142
msgctxt "crater"
msgid "Agate"
msgstr "アゲート"

#: data/nomenclature.fab:27142
msgctxt "origin"
msgid "Banded gemstone, variety of the mineral chalcedony."
msgstr "和名:メノウ (瑪瑙) ; 縞模様の宝石、カルセドニー (和名:玉髄) の変種。"

#. TRANSLATORS: (Steins); Yellow gemstone, a variety of the mineral quartz.
#: data/nomenclature.fab:27144
msgctxt "crater"
msgid "Citrine"
msgstr "シトリン"

#: data/nomenclature.fab:27144
msgctxt "origin"
msgid "Yellow gemstone, a variety of the mineral quartz."
msgstr "和名:黄水晶; 黄色の宝石、クォーツ (石英) の一種。"

#. TRANSLATORS: (Steins); Lapis Lazuli; gemstone formed from a rock containing
#. a number of minerals, the quality and value determined by the color and
#. abundance of the blue mineral lazurite.
#: data/nomenclature.fab:27146
msgctxt "crater"
msgid "Lapis"
msgstr "ラピス"

#: data/nomenclature.fab:27146
msgctxt "origin"
msgid ""
"Lapis Lazuli; gemstone formed from a rock containing a number of minerals, "
"the quality and value determined by the color and abundance of the blue "
"mineral lazurite."
msgstr "ラピスラズリ (和名:瑠璃); いくつかの鉱物を含む岩石から形成された宝石、品質と価値は青色鉱物ラズライトの色と存在量によって決まる。"

#. TRANSLATORS: (Steins); Rare and precious gemstone, the hardest natural
#. substance.
#: data/nomenclature.fab:27148
msgctxt "crater"
msgid "Diamond"
msgstr "ダイヤモンド"

#: data/nomenclature.fab:27148
msgctxt "origin"
msgid "Rare and precious gemstone, the hardest natural substance."
msgstr "和名:金剛石 ; 希少で貴重な宝石、最も硬い天然物質。"

#. TRANSLATORS: (Steins); Green gemstone, a variety of the mineral olivine.
#: data/nomenclature.fab:27150
msgctxt "crater"
msgid "Peridot"
msgstr "ペリドット"

#: data/nomenclature.fab:27150
msgctxt "origin"
msgid "Green gemstone, a variety of the mineral olivine."
msgstr "緑色の宝石、オリビン (カンラン石) の一種。"

#. TRANSLATORS: (Steins); Gemstone that is colorless in its pure form, but
#. also found in yellows, browns, and reds.
#: data/nomenclature.fab:27152
msgctxt "crater"
msgid "Zircon"
msgstr "ジルコン"

#: data/nomenclature.fab:27152
msgctxt "origin"
msgid ""
"Gemstone that is colorless in its pure form, but also found in yellows, "
"browns, and reds."
msgstr "純粋なものは無色だが、黄色、茶色、赤色もある宝石。"

#. TRANSLATORS: (Steins); Semitransparent to translucent gemstone, a variety
#. of the minerals nephrite and jadeite.
#: data/nomenclature.fab:27154
msgctxt "crater"
msgid "Jade"
msgstr "ジェイド"

#: data/nomenclature.fab:27154
msgctxt "origin"
msgid ""
"Semitransparent to translucent gemstone, a variety of the minerals nephrite "
"and jadeite."
msgstr "和名:ヒスイ (翡翠) ; 半透明から透明な宝石。ネフライト (硬玉)とジェダイト (軟玉、ヒスイ輝石) がある。"

#. TRANSLATORS: (Steins); Gemstone noted for its beautiful, multi-colored
#. prismatic crystals.
#: data/nomenclature.fab:27156
msgctxt "crater"
msgid "Tourmaline"
msgstr "トルマリン"

#: data/nomenclature.fab:27156
msgctxt "origin"
msgid "Gemstone noted for its beautiful, multi-colored prismatic crystals."
msgstr "美しい多色のプリズム状の結晶が特徴的な宝石。"

#. TRANSLATORS: (Steins); Nikolai Stepanovich; Soviet and Ukrainian
#. astronomer, discovered asteroid (2867) Steins (1931-2004).
#: data/nomenclature.fab:27158
msgctxt "regio"
msgid "Chernykh Regio"
msgstr "チェルヌイフ地域"

#: data/nomenclature.fab:27158
msgctxt "origin"
msgid ""
"Nikolai Stepanovich; Soviet and Ukrainian astronomer, discovered asteroid "
"(2867) Steins (1931-2004)."
msgstr "ニコライ・ステパノビッチ; ソ連とウクライナの天文学者 (1931-2004) 。小惑星シュタインス (2867番) を発見した。"

#. TRANSLATORS: (Tethys); A suitor of Penelope, killed by Telemachus.
#: data/nomenclature.fab:27160
msgctxt "crater"
msgid "Leocritus"
msgstr "レオクリトゥス"

#: data/nomenclature.fab:27160
msgctxt "origin"
msgid "A suitor of Penelope, killed by Telemachus."
msgstr "ペネロペへの求婚者、テレマクスに殺された。"

#. TRANSLATORS: (Tethys); Ino’s name after she became a goddess.
#: data/nomenclature.fab:27162
msgctxt "crater"
msgid "Leucothea"
msgstr "レウコテア"

#: data/nomenclature.fab:27162
msgctxt "origin"
msgid "Ino’s name after she became a goddess."
msgstr "イノが女神となった後の名前。"

#. TRANSLATORS: (Tethys); Son of Euanthes, priest of Apollo at Ismarus.
#: data/nomenclature.fab:27164
msgctxt "crater"
msgid "Maron"
msgstr "マロン"

#: data/nomenclature.fab:27164
msgctxt "origin"
msgid "Son of Euanthes, priest of Apollo at Ismarus."
msgstr "エウアンテスの息子、イスマルスでのアポロの司祭。"

#. TRANSLATORS: (Tethys); Herald of Odysseus in Ithaca.
#: data/nomenclature.fab:27166
msgctxt "crater"
msgid "Medon"
msgstr "メドン"

#: data/nomenclature.fab:27166
msgctxt "origin"
msgid "Herald of Odysseus in Ithaca."
msgstr "イタカでのオデュッセウスの伝令。"

#. TRANSLATORS: (Tethys); Father of Nestor.
#: data/nomenclature.fab:27168
msgctxt "crater"
msgid "Neleus"
msgstr "ネレウス"

#: data/nomenclature.fab:27168
msgctxt "origin"
msgid "Father of Nestor."
msgstr "ネストルの父親。"

#. TRANSLATORS: (Tethys); Father of Euryalos.
#: data/nomenclature.fab:27170
msgctxt "crater"
msgid "Naubolos"
msgstr "ナウボロス"

#: data/nomenclature.fab:27170
msgctxt "origin"
msgid "Father of Euryalos."
msgstr "エウリュアロスの父親。"

#. TRANSLATORS: (Tethys); Daughter of Alcinous who advised Odysseus.
#: data/nomenclature.fab:27172
msgctxt "crater"
msgid "Nausicaa"
msgstr "ナウシカー"

#: data/nomenclature.fab:27172
msgctxt "origin"
msgid "Daughter of Alcinous who advised Odysseus."
msgstr "オデュッセウスが訪れたアルキノウスの娘。"

#. TRANSLATORS: (Tethys); Father of Antinous.
#: data/nomenclature.fab:27174
msgctxt "crater"
msgid "Eupithes"
msgstr "エウピテス"

#: data/nomenclature.fab:27174
msgctxt "origin"
msgid "Father of Antinous."
msgstr "アンティノウスの父親。"

#. TRANSLATORS: (Tethys); Father of Maron.
#: data/nomenclature.fab:27176
msgctxt "crater"
msgid "Euanthes"
msgstr "エウアンテス"

#: data/nomenclature.fab:27176
msgctxt "origin"
msgid "Father of Maron."
msgstr "マロンの父親。"

#. TRANSLATORS: (Tethys); Father of Ctesius.
#: data/nomenclature.fab:27178
msgctxt "crater"
msgid "Ormenus"
msgstr "オルメヌス"

#: data/nomenclature.fab:27178
msgctxt "origin"
msgid "Father of Ctesius."
msgstr "クテシウスの父親。"

#. TRANSLATORS: (Tethys); Faithful herdsman of Odysseus' flock.
#: data/nomenclature.fab:27180
msgctxt "crater"
msgid "Philoetius"
msgstr "フィロエティウス"

#: data/nomenclature.fab:27180
msgctxt "origin"
msgid "Faithful herdsman of Odysseus' flock."
msgstr "オデュッセウスの一団の誠実な牧夫。"

#. TRANSLATORS: (Tethys); Daughter of Nestor.
#: data/nomenclature.fab:27182
msgctxt "crater"
msgid "Polycaste"
msgstr "ポリュカステ"

#: data/nomenclature.fab:27182
msgctxt "origin"
msgid "Daughter of Nestor."
msgstr "ネストルの娘。"

#. TRANSLATORS: (Tethys); Son of Cronos, brother of Zeus, god of the sea.
#: data/nomenclature.fab:27184
msgctxt "crater"
msgid "Poseidon"
msgstr "ポセイドン"

#: data/nomenclature.fab:27184
msgctxt "origin"
msgid "Son of Cronos, brother of Zeus, god of the sea."
msgstr "クロノスの息子、ゼウスの兄弟、海の神。"

#. TRANSLATORS: (Tethys); Brother of Alcinous.
#: data/nomenclature.fab:27186
msgctxt "crater"
msgid "Rhexenor"
msgstr "レクセノル"

#: data/nomenclature.fab:27186
msgctxt "origin"
msgid "Brother of Alcinous."
msgstr "アルキノウスの兄弟。"

#. TRANSLATORS: (Tethys); Father of Tyro.
#: data/nomenclature.fab:27188
msgctxt "crater"
msgid "Salmoneus"
msgstr "サルモネウス"

#: data/nomenclature.fab:27188
msgctxt "origin"
msgid "Father of Tyro."
msgstr "ティロの父親。"

#. TRANSLATORS: (Tethys); Odysseus’ second in command.
#: data/nomenclature.fab:27190
msgctxt "crater"
msgid "Eurylochus"
msgstr "エウリュロクス"

#: data/nomenclature.fab:27190
msgctxt "origin"
msgid "Odysseus’ second in command."
msgstr "オデュッセウスの副司令官。"

#. TRANSLATORS: (Tethys); One of the two leading suitors of Penelope, killed
#. by Odysseus.
#: data/nomenclature.fab:27192
msgctxt "crater"
msgid "Eurymachus"
msgstr "エウリマクス"

#: data/nomenclature.fab:27192
msgctxt "origin"
msgid "One of the two leading suitors of Penelope, killed by Odysseus."
msgstr "ペネロペの有力な求婚者二人のうちの一人、オデュッセウスに殺された。"

#. TRANSLATORS: (Tethys); Wife of Alcinous, mother of Nausicaa.
#: data/nomenclature.fab:27194
msgctxt "crater"
msgid "Arete"
msgstr "アレテ"

#: data/nomenclature.fab:27194
msgctxt "origin"
msgid "Wife of Alcinous, mother of Nausicaa."
msgstr "アルキノウスの妻、ナウシカーの母親。"

#. TRANSLATORS: (Tethys); Son of Alcinous and Arete.
#: data/nomenclature.fab:27196
msgctxt "crater"
msgid "Halius"
msgstr "ハリウス"

#: data/nomenclature.fab:27196
msgctxt "origin"
msgid "Son of Alcinous and Arete."
msgstr "アルキノウスとアレテの息子。"

#. TRANSLATORS: (Tethys); Daughter of Menelaus and Helen.
#: data/nomenclature.fab:27198
msgctxt "crater"
msgid "Hermione"
msgstr "ヘルミオネ"

#: data/nomenclature.fab:27198
msgctxt "origin"
msgid "Daughter of Menelaus and Helen."
msgstr "メネラウスとヘレンの娘。"

#. TRANSLATORS: (Tethys); Father of Penelope.
#: data/nomenclature.fab:27200
msgctxt "crater"
msgid "Icarius"
msgstr "イカリウス"

#: data/nomenclature.fab:27200
msgctxt "origin"
msgid "Father of Penelope."
msgstr "ペネロペの父親。"

#. TRANSLATORS: (Tethys); Ithacan beggar.
#: data/nomenclature.fab:27202
msgctxt "crater"
msgid "Irus"
msgstr "イルス"

#: data/nomenclature.fab:27202
msgctxt "origin"
msgid "Ithacan beggar."
msgstr "イタカの物乞い。"

#. TRANSLATORS: (Tethys); Father of Penelope’s suitor Leodes.
#: data/nomenclature.fab:27204
msgctxt "crater"
msgid "Oenops"
msgstr "オイノプス"

#: data/nomenclature.fab:27204
msgctxt "origin"
msgid "Father of Penelope’s suitor Leodes."
msgstr "ペネロペの求婚者レオデスの父。"

#. TRANSLATORS: (Tethys); Greek hero second only to Achilles.
#: data/nomenclature.fab:27206
msgctxt "crater"
msgid "Ajax"
msgstr "アイアス"

#: data/nomenclature.fab:27206
msgctxt "origin"
msgid "Greek hero second only to Achilles."
msgstr "アキレスに次ぐギリシャの英雄。"

#. TRANSLATORS: (Tethys); Mother of Nausithous.
#: data/nomenclature.fab:27208
msgctxt "crater"
msgid "Periboea"
msgstr "ペリボエア"

#: data/nomenclature.fab:27208
msgctxt "origin"
msgid "Mother of Nausithous."
msgstr "ナウシトウスの母親。"

#. TRANSLATORS: (Tethys); Fugitive prophet, given refuge on Telemachus’ ship.
#: data/nomenclature.fab:27210
msgctxt "crater"
msgid "Theoclymenus"
msgstr "テオクリメヌス"

#: data/nomenclature.fab:27210
msgctxt "origin"
msgid "Fugitive prophet, given refuge on Telemachus’ ship."
msgstr "テレマクスの船に避難した逃亡中の預言者。"

#. TRANSLATORS: (Tethys); Mother of Odysseus.
#: data/nomenclature.fab:27212
msgctxt "crater"
msgid "Anticleia"
msgstr "アンティクレイア"

#: data/nomenclature.fab:27212
msgctxt "origin"
msgid "Mother of Odysseus."
msgstr "オデュッセウスの母親。"

#. TRANSLATORS: (Tethys); Chief of the wooers; slain by Odysseus.
#: data/nomenclature.fab:27214
msgctxt "crater"
msgid "Antinous"
msgstr "アンティノウス"

#: data/nomenclature.fab:27214
msgctxt "origin"
msgid "Chief of the wooers; slain by Odysseus."
msgstr "懇願者の長、オデュッセウスに殺される。"

#. TRANSLATORS: (Tethys); Son of Peleus and Thetis, commander of the Myrmidons
#. at Troy.
#: data/nomenclature.fab:27216
msgctxt "crater"
msgid "Achilles"
msgstr "アキレス"

#: data/nomenclature.fab:27216
msgctxt "origin"
msgid "Son of Peleus and Thetis, commander of the Myrmidons at Troy."
msgstr "ペレウスとテティスの息子、トロイでのミルミドン人の司令官。"

#. TRANSLATORS: (Tethys); Brother of Circe.
#: data/nomenclature.fab:27218
msgctxt "crater"
msgid "Aietes"
msgstr "アイエテス"

#: data/nomenclature.fab:27218
msgctxt "origin"
msgid "Brother of Circe."
msgstr "キルケの兄弟。"

#. TRANSLATORS: (Tethys); King of Phaeacia, husband of Arete, father of
#. Nausicaa.
#: data/nomenclature.fab:27220
msgctxt "crater"
msgid "Alcinous"
msgstr "アルキノウス"

#: data/nomenclature.fab:27220
msgctxt "origin"
msgid "King of Phaeacia, husband of Arete, father of Nausicaa."
msgstr "ファエアキア (スケリア) の王、アレテの夫、ナウシカーの父親。"

#. TRANSLATORS: (Tethys); A suitor killed by Telemachus, a favorite of
#. Penelope.
#: data/nomenclature.fab:27222
msgctxt "crater"
msgid "Amphinomus"
msgstr "アンフィノムス"

#: data/nomenclature.fab:27222
msgctxt "origin"
msgid "A suitor killed by Telemachus, a favorite of Penelope."
msgstr "ペネロペのお気に入り、テレマクスに殺された求婚者。"

#. TRANSLATORS: (Tethys); Blind Phaeacian singer.
#: data/nomenclature.fab:27224
msgctxt "crater"
msgid "Demodocus"
msgstr "デモドクス"

#: data/nomenclature.fab:27224
msgctxt "origin"
msgid "Blind Phaeacian singer."
msgstr "盲目のファエアキア人 (スケリア人) の詩人。"

#. TRANSLATORS: (Tethys); Son of Tydeus, king of Argos.
#: data/nomenclature.fab:27226
msgctxt "crater"
msgid "Diomedes"
msgstr "ディオメデス"

#: data/nomenclature.fab:27226
msgctxt "origin"
msgid "Son of Tydeus, king of Argos."
msgstr "ティデウスの息子、アルゴス王"

#. TRANSLATORS: (Tethys); Follower of Odysseus.
#: data/nomenclature.fab:27228
msgctxt "crater"
msgid "Elpenor"
msgstr "エルペノル"

#: data/nomenclature.fab:27228
msgctxt "origin"
msgid "Follower of Odysseus."
msgstr "オデュッセウスの従者。"

#. TRANSLATORS: (Tethys); Changed Odysseus' companions into swine.
#: data/nomenclature.fab:27230
msgctxt "crater"
msgid "Circe"
msgstr "キルケ"

#: data/nomenclature.fab:27230
msgctxt "origin"
msgid "Changed Odysseus' companions into swine."
msgstr "オデュッセウスの仲間を豚に変えた。"

#. TRANSLATORS: (Tethys); Old servant of Penelope.
#: data/nomenclature.fab:27232
msgctxt "crater"
msgid "Dolius"
msgstr "ドリウス"

#: data/nomenclature.fab:27232
msgctxt "origin"
msgid "Old servant of Penelope."
msgstr "ペネロペの老従者。"

#. TRANSLATORS: (Tethys); Faithful old nurse of Odysseus.
#: data/nomenclature.fab:27234
msgctxt "crater"
msgid "Eurycleia"
msgstr "エウリュクレイア"

#: data/nomenclature.fab:27234
msgctxt "origin"
msgid "Faithful old nurse of Odysseus."
msgstr "誠実で年老いたオデュッセウスの保母。"

#. TRANSLATORS: (Tethys); Faithful swineherd who greets Odysseus, gave him
#. warm cloak and guided him to palace.
#: data/nomenclature.fab:27236
msgctxt "crater"
msgid "Eumaeus"
msgstr "エウマエウス"

#: data/nomenclature.fab:27236
msgctxt "origin"
msgid ""
"Faithful swineherd who greets Odysseus, gave him warm cloak and guided him "
"to palace."
msgstr "オデュッセウスを出迎えた忠実な豚飼い。オデュッセウスに暖かいマントを与え、宮殿へ案内した。"

#. TRANSLATORS: (Tethys); A wise old king.
#: data/nomenclature.fab:27238
msgctxt "crater"
msgid "Nestor"
msgstr "ネストル"

#: data/nomenclature.fab:27238
msgctxt "origin"
msgid "A wise old king."
msgstr "年老いた賢い王。"

#. TRANSLATORS: (Tethys); Father of Odysseus.
#: data/nomenclature.fab:27240
msgctxt "crater"
msgid "Laertes"
msgstr "ラエルテス"

#: data/nomenclature.fab:27240
msgctxt "origin"
msgid "Father of Odysseus."
msgstr "オデュッセウスの父親。"

#. TRANSLATORS: (Tethys); Disloyal goatherd; insults Odysseus; is slain.
#: data/nomenclature.fab:27242
msgctxt "crater"
msgid "Melanthius"
msgstr "メランティウス"

#: data/nomenclature.fab:27242
msgctxt "origin"
msgid "Disloyal goatherd; insults Odysseus; is slain."
msgstr "不誠実なヤギ飼い。オデュッセウスを侮辱し、殺される。"

#. TRANSLATORS: (Tethys); Friend of Odysseus.
#: data/nomenclature.fab:27244
msgctxt "crater"
msgid "Mentor"
msgstr "メントル"

#: data/nomenclature.fab:27244
msgctxt "origin"
msgid "Friend of Odysseus."
msgstr "オデュッセウスの友人。"

#. TRANSLATORS: (Tethys); Hero of Odyssey.
#: data/nomenclature.fab:27246
msgctxt "crater"
msgid "Odysseus"
msgstr "オデュッセウス"

#: data/nomenclature.fab:27246
msgctxt "origin"
msgid "Hero of Odyssey."
msgstr "オデュッセイアの主人公。"

#. TRANSLATORS: (Tethys); Faithful wife of Odysseus.
#: data/nomenclature.fab:27248
msgctxt "crater"
msgid "Penelope"
msgstr "ペネロペ"

#: data/nomenclature.fab:27248
msgctxt "origin"
msgid "Faithful wife of Odysseus."
msgstr "オデュッセウスの貞節な妻。"

#. TRANSLATORS: (Tethys); Minstrel to the wooers; spared by Odysseus.
#: data/nomenclature.fab:27250
msgctxt "crater"
msgid "Phemius"
msgstr "フェミウス"

#: data/nomenclature.fab:27250
msgctxt "origin"
msgid "Minstrel to the wooers; spared by Odysseus."
msgstr "求愛する吟遊詩人; オデュッセウスに救われた。"

