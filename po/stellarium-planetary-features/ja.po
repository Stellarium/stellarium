#. TRANSLATORS: (Mars); Classical albedo feature name.
#: data/nomenclature.fab:5600
msgctxt "catena"
msgid "Coprates Catena"
msgstr "コプラテス連鎖クレーター"

#. TRANSLATORS: (Mars); Named for classical albedo feature at 35N, 140W.
#: data/nomenclature.fab:5602
msgctxt "catena"
msgid "Acheron Catena"
msgstr "アケロン連鎖クレーター"

#: data/nomenclature.fab:5602
msgctxt "origin"
msgid "Named for classical albedo feature at 35N, 140W."
msgstr "北緯35度、西経140度にある古典的なアルベド地形にちなんだ命名。"

#. TRANSLATORS: (Mars); Classical albedo name.
#: data/nomenclature.fab:5604
msgctxt "catena"
msgid "Alba Catena"
msgstr "アルバ連鎖クレーター"

