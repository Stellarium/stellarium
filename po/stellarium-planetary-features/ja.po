msgctxt "albedo feature"
msgid "Adiri"
msgstr "アディリ"

#: data/nomenclature.fab:27334
msgctxt "origin"
msgid "Melanesian afterworld where life is easier than on Earth."
msgstr "地上よりも生活が楽なメラネシアのあの世。"

#. TRANSLATORS: (Titan); Mythical land from which the Aztecs believed they
#. migrated.
#: data/nomenclature.fab:27336
msgctxt "albedo feature"
msgid "Aztlan"
msgstr "アズトラン"

