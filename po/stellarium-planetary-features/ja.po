msgctxt "origin"
msgid "Mythical land from which the Aztecs believed they migrated."
msgstr "アステカ人が移住してきたと信じられていた神話上の土地。"

#. TRANSLATORS: (Titan); Malay afterworld reached by a flower-lined bridge.
#: data/nomenclature.fab:27338
msgctxt "albedo feature"
msgid "Belet"
msgstr "ベレト"

