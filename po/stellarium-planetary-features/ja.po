#. TRANSLATORS: (Dione); A Rutulian.
#: data/nomenclature.fab:840
msgctxt "crater"
msgid "Murranus"
msgstr "ムッラヌス"

#: data/nomenclature.fab:840
msgctxt "origin"
msgid "A Rutulian."
msgstr "ルトゥリア人"

#. TRANSLATORS: (Dione); Soldier of Turnus, brother of Lucagus.
#: data/nomenclature.fab:842
msgctxt "crater"
msgid "Liger"
msgstr "リゲル"

#: data/nomenclature.fab:842
msgctxt "origin"
msgid "Soldier of Turnus, brother of Lucagus."
msgstr "トゥルヌスの兵士、ルカグスの兄弟。"

#. TRANSLATORS: (Dione); Soldier of Turnus, brother of Liger.
#: data/nomenclature.fab:844
msgctxt "crater"
msgid "Lucagus"
msgstr "ルカグス"

#: data/nomenclature.fab:844
msgctxt "origin"
msgid "Soldier of Turnus, brother of Liger."
msgstr "トゥルヌスの兵士、リゲルの兄弟。"

#. TRANSLATORS: (Dione); A Rutulian, charioteer of Turnus.
#: data/nomenclature.fab:846
msgctxt "crater"
msgid "Metiscus"
msgstr "メティスクス"

#: data/nomenclature.fab:846
msgctxt "origin"
msgid "A Rutulian, charioteer of Turnus."
msgstr "ルトゥリア人、トゥルヌスの御者。"

#. TRANSLATORS: (Dione); Trojan defending Aeneas' camp against Rutulian
#. attack.
#: data/nomenclature.fab:848
msgctxt "crater"
msgid "Prytanis"
msgstr "プリタニス"

#: data/nomenclature.fab:848 data/nomenclature.fab:856
msgctxt "origin"
msgid "Trojan defending Aeneas' camp against Rutulian attack."
msgstr "ルトゥリア人の攻撃からアエネアスの野営地を守るトロイ人。"

#. TRANSLATORS: (Dione); Etruscan king, ally of Turnus, father of Lausus.
#: data/nomenclature.fab:850
msgctxt "crater"
msgid "Mezentius"
msgstr "メゼンティウス"

#: data/nomenclature.fab:850
msgctxt "origin"
msgid "Etruscan king, ally of Turnus, father of Lausus."
msgstr "エトルリアの王、トゥルヌスの同盟者、ラウススの父。"

#. TRANSLATORS: (Dione); Trojan companion of Aeneas, friend of Euryalus.
#: data/nomenclature.fab:852
msgctxt "crater"
msgid "Nisus"
msgstr "ニスス"

#: data/nomenclature.fab:852
msgctxt "origin"
msgid "Trojan companion of Aeneas, friend of Euryalus."
msgstr "アエネアスの仲間のトロイ人、エウリュアロスの友。"

#. TRANSLATORS: (Dione); An Etruscan killed by Camilla.
#: data/nomenclature.fab:854
msgctxt "crater"
msgid "Pagasus"
msgstr "パガスス"

#: data/nomenclature.fab:854
msgctxt "origin"
msgid "An Etruscan killed by Camilla."
msgstr "カミラに殺されたエトルリア人。"

#. TRANSLATORS: (Dione); Trojan defending Aeneas' camp against Rutulian
#. attack.
#: data/nomenclature.fab:856
msgctxt "crater"
msgid "Phaleris"
msgstr "ファレリス"

#. TRANSLATORS: (Dione); A Trojan, comrade of Aeneas.
#: data/nomenclature.fab:858
msgctxt "crater"
msgid "Amycus"
msgstr "アミクス"

#: data/nomenclature.fab:858
msgctxt "origin"
msgid "A Trojan, comrade of Aeneas."
msgstr "トロイ人、アエネアスの同志。"

#. TRANSLATORS: (Dione); A soldier of Turnus.
#: data/nomenclature.fab:860
msgctxt "crater"
msgid "Lagus"
msgstr "ラグス"

#: data/nomenclature.fab:860
msgctxt "origin"
msgid "A soldier of Turnus."
msgstr "トゥルヌスの兵士"

#. TRANSLATORS: (Dione); A Rutulian, member of Turnus’ army, son of Daucus,
#. twin brother of Thymber.
#: data/nomenclature.fab:862
msgctxt "crater"
msgid "Larides"
msgstr "ラリデス"

#: data/nomenclature.fab:862
msgctxt "origin"
msgid ""
"A Rutulian, member of Turnus’ army, son of Daucus, twin brother of Thymber."
msgstr "ルトゥリア人、トゥルヌス軍の一員、ダウクスの息子、ティンベルの双子の兄弟。"

#. TRANSLATORS: (Dione); King of Latium, husband of Amata.
#: data/nomenclature.fab:864
msgctxt "crater"
msgid "Latinus"
msgstr "ラティヌス"

#: data/nomenclature.fab:864
msgctxt "origin"
msgid "King of Latium, husband of Amata."
msgstr "ラティウムの王、アマタの夫。"

#. TRANSLATORS: (Dione); A Rutulian of those besieging the men of Aeneas in
#. their leader’s absence.
#: data/nomenclature.fab:866
msgctxt "crater"
msgid "Fadus"
msgstr "ファドゥス"

#: data/nomenclature.fab:866
msgctxt "origin"
msgid ""
"A Rutulian of those besieging the men of Aeneas in their leader’s absence."
msgstr "ルトゥルリア人、リーダー不在中にアエネアスの人々を包囲する人達のうちの一人。"

#. TRANSLATORS: (Dione); King of Sicily.
#: data/nomenclature.fab:868
msgctxt "crater"
msgid "Acestes"
msgstr "アケステス"

#: data/nomenclature.fab:868
msgctxt "origin"
msgid "King of Sicily."
msgstr "シチリア王国の王。"

#. TRANSLATORS: (Dione); One of the Furies.
#: data/nomenclature.fab:870
msgctxt "crater"
msgid "Allecto"
msgstr "アレクト"

#: data/nomenclature.fab:870
msgctxt "origin"
msgid "One of the Furies."
msgstr "フューリーズ (復讐の女神) の一人。"

#. TRANSLATORS: (Dione); A Trojan, victim of Camilla.
#: data/nomenclature.fab:872
msgctxt "crater"
msgid "Amastrus"
msgstr "アマストルス"

#: data/nomenclature.fab:872
msgctxt "origin"
msgid "A Trojan, victim of Camilla."
msgstr "トロイ人、カミラの犠牲者。"

#. TRANSLATORS: (Dione); Sister and confidante of Dido.
#: data/nomenclature.fab:874
msgctxt "crater"
msgid "Anna"
msgstr "アンナ"

#: data/nomenclature.fab:874
msgctxt "origin"
msgid "Sister and confidante of Dido."
msgstr "ディドの妹で親友。"

#. TRANSLATORS: (Dione); Son of Aeneas by Creusa.
#: data/nomenclature.fab:876
msgctxt "crater"
msgid "Ascanius"
msgstr "アスカニウス"

#: data/nomenclature.fab:876
msgctxt "origin"
msgid "Son of Aeneas by Creusa."
msgstr "アエネアスとクレウサの息子。"

#. TRANSLATORS: (Dione); Etruscan chief, ally of Aeneas.
#: data/nomenclature.fab:878
msgctxt "crater"
msgid "Aulestes"
msgstr "アウレステス"

#: data/nomenclature.fab:878
msgctxt "origin"
msgid "Etruscan chief, ally of Aeneas."
msgstr "エトルリアの長、アエネアスの同盟者。"

#. TRANSLATORS: (Dione); A Trojan warrior who took part in the defense of
#. Aeneas’ camp against the Rutulians.
#: data/nomenclature.fab:880
msgctxt "crater"
msgid "Cretheus"
msgstr "クレテウス"

#: data/nomenclature.fab:880
msgctxt "origin"
msgid ""
"A Trojan warrior who took part in the defense of Aeneas’ camp against the "
"Rutulians."
msgstr "ルトゥルリア人に対するアエネアス陣営の防衛に参加したトロイの戦士。"

#. TRANSLATORS: (Dione); A Rutulian, father of the twins Thymber and Larides.
#: data/nomenclature.fab:882
msgctxt "crater"
msgid "Daucus"
msgstr "ダウクス"

#: data/nomenclature.fab:882
msgctxt "origin"
msgid "A Rutulian, father of the twins Thymber and Larides."
msgstr "ルトゥリア人、双子の兄弟ティンベルとラリデスの父親。"

#. TRANSLATORS: (Dione); Ancient king of the Laurentians.
#: data/nomenclature.fab:884
msgctxt "crater"
msgid "Dercennus"
msgstr "デルケンヌス"

#: data/nomenclature.fab:884
msgctxt "origin"
msgid "Ancient king of the Laurentians."
msgstr "ローレンシア人の古代の王。"

#. TRANSLATORS: (Dione); Sicilian boxing champion.
#: data/nomenclature.fab:886
msgctxt "crater"
msgid "Entellus"
msgstr "エンテルス"

#: data/nomenclature.fab:886
msgctxt "origin"
msgid "Sicilian boxing champion."
msgstr "シチリアのボクシングのチャンピオン。"

#. TRANSLATORS: (Dione); A Trojan companion of Aeneas, friend of Nisus.
#: data/nomenclature.fab:888
msgctxt "crater"
msgid "Euryalus"
msgstr "エウリアロス"

#: data/nomenclature.fab:888
msgctxt "origin"
msgid "A Trojan companion of Aeneas, friend of Nisus."
msgstr "アエネアスの仲間のトロイ人、ニススの友。"

#. TRANSLATORS: (Dione); A Trojan companion of Aeneas.
#: data/nomenclature.fab:890
msgctxt "crater"
msgid "Eumelus"
msgstr "エウメロス"

#: data/nomenclature.fab:890
msgctxt "origin"
msgid "A Trojan companion of Aeneas."
msgstr "アエネアスの仲間のトロイ人。"

#. TRANSLATORS: (Dione); Son of Mercury by Carmentis, ally of Aeneas against
#. the Latins, mythical king of Arcadia, founded and ruled Pallanteum, built
#. on the future site of Rome.
#: data/nomenclature.fab:892
msgctxt "crater"
msgid "Evander"
msgstr "エワンデル"

#: data/nomenclature.fab:892
msgctxt "origin"
msgid ""
"Son of Mercury by Carmentis, ally of Aeneas against the Latins, mythical "
"king of Arcadia, founded and ruled Pallanteum, built on the future site of "
"Rome."
msgstr ""
"マーキュリーとカルメンティスの息子。ラテン人に対するアエネアスの同盟者、神話ではアルカディアの王で、将来ローマとなる場所に建設されたパランテウムを建設し統治した。"

#. TRANSLATORS: (Dione); A Rutulian who besieged Aeneas' camp.
#: data/nomenclature.fab:894
msgctxt "crater"
msgid "Herbesus"
msgstr "ヘルベスス"

#: data/nomenclature.fab:894
msgctxt "origin"
msgid "A Rutulian who besieged Aeneas' camp."
msgstr "アエネアスの野営地を包囲したルトゥリア人。"

#. TRANSLATORS: (Dione); Superhuman son of the goddess Feronia.
#: data/nomenclature.fab:896
msgctxt "crater"
msgid "Erulus"
msgstr "エルルス"

#: data/nomenclature.fab:896
msgctxt "origin"
msgid "Superhuman son of the goddess Feronia."
msgstr "女神フェロニアの超人息子。"

#. TRANSLATORS: (Dione); Servant of Aeneas.
#: data/nomenclature.fab:898
msgctxt "crater"
msgid "Sagaris"
msgstr "サガリス"

#: data/nomenclature.fab:898
msgctxt "origin"
msgid "Servant of Aeneas."
msgstr "アエネアスの従者。"

#. TRANSLATORS: (Dione); Son of Aeneas and Lavinia.
#: data/nomenclature.fab:900
msgctxt "crater"
msgid "Silvius"
msgstr "シルウィウス"

#: data/nomenclature.fab:900
msgctxt "origin"
msgid "Son of Aeneas and Lavinia."
msgstr "アエネアスとラウィニアの息子。"

#. TRANSLATORS: (Dione); A Trojan, killed by Camilla.
#: data/nomenclature.fab:902
msgctxt "crater"
msgid "Tereus"
msgstr "テレウス"

#: data/nomenclature.fab:902
msgctxt "origin"
msgid "A Trojan, killed by Camilla."
msgstr "トロイ人、カミラに殺された。"

#. TRANSLATORS: (Dione); A Rutulian, member of Turnus’ army, son of Daucus,
#. twin brother of Larides.
#: data/nomenclature.fab:904
msgctxt "crater"
msgid "Thymber"
msgstr "ティンベル"

#: data/nomenclature.fab:904
msgctxt "origin"
msgid ""
"A Rutulian, member of Turnus’ army, son of Daucus, twin brother of Larides."
msgstr "ルトゥリア人、トゥルヌス軍の一員、ダウクスの息子、ラリデスの双子の兄弟。"

#. TRANSLATORS: (Dione); Brother of the twins Catillus and Coras, founder of
#. Tibur to which he gave his name.
#: data/nomenclature.fab:906
msgctxt "crater"
msgid "Tiburtus"
msgstr "ティブルトス"

#: data/nomenclature.fab:906
msgctxt "origin"
msgid ""
"Brother of the twins Catillus and Coras, founder of Tibur to which he gave "
"his name."
msgstr "カルティルウスとコラスの双子の兄弟、彼の名前の由来となったティブルの創始者。"

#. TRANSLATORS: (Dione); Keeper of the herds for Latinus, father of Silvia.
#: data/nomenclature.fab:908
msgctxt "crater"
msgid "Tyrrhus"
msgstr "ティルース"

#: data/nomenclature.fab:908
msgctxt "origin"
msgid "Keeper of the herds for Latinus, father of Silvia."
msgstr "ラティヌスの群れの番人、シルビアの父。"

#. TRANSLATORS: (Dione); A warrior maiden; ally of Turnus.
#: data/nomenclature.fab:910
msgctxt "crater"
msgid "Camilla"
msgstr "カミラ"

#: data/nomenclature.fab:910
msgctxt "origin"
msgid "A warrior maiden; ally of Turnus."
msgstr "戦いの乙女; トゥルヌスの同盟者。"

#. TRANSLATORS: (Dione); Mother of Lavinia (wife of Aeneas).
#: data/nomenclature.fab:912
msgctxt "crater"
msgid "Amata"
msgstr "アマタ"

#: data/nomenclature.fab:912
msgctxt "origin"
msgid "Mother of Lavinia (wife of Aeneas)."
msgstr "ラウィニアの母 (アエネアスの妻) 。"

#. TRANSLATORS: (Dione); Aeneas' father.
#: data/nomenclature.fab:914
msgctxt "crater"
msgid "Anchises"
msgstr "アンキセス"

#: data/nomenclature.fab:914
msgctxt "origin"
msgid "Aeneas' father."
msgstr "アエネアスの父親。"

#. TRANSLATORS: (Dione); King of Argos, one of the seven against Thebes, and
#. the only one to return alive.
#: data/nomenclature.fab:916
msgctxt "crater"
msgid "Adrastus"
msgstr "アドラストス"

#: data/nomenclature.fab:916
msgctxt "origin"
msgid ""
"King of Argos, one of the seven against Thebes, and the only one to return "
"alive."
msgstr "アルゴの王、テーベと戦った7人のうちの1人で、ただ1人の生き残り。"

#. TRANSLATORS: (Dione); Hero of the Aeneid. The son of Anchises and Venus and
#. a member of the royal family of Troy.
#: data/nomenclature.fab:918
msgctxt "crater"
msgid "Aeneas"
msgstr "アエネアス"

#: data/nomenclature.fab:918
msgctxt "origin"
msgid ""
"Hero of the Aeneid. The son of Anchises and Venus and a member of the royal "
"family of Troy."
msgstr "アエネイスの英雄。アンキセスとヴィーナスの息子で、トロイ王家の一員。"

#. TRANSLATORS: (Dione); Nephew of Priam. He escaped the fall of Troy and
#. reached Italy before Aeneas, where he founded Padua.
#: data/nomenclature.fab:920
msgctxt "crater"
msgid "Antenor"
msgstr "アンテノル"

#: data/nomenclature.fab:920
msgctxt "origin"
msgid ""
"Nephew of Priam. He escaped the fall of Troy and reached Italy before "
"Aeneas, where he founded Padua."
msgstr "プリアモスの甥。トロイ陥落から逃れてアエネアスの前にイタリアに到着、その地にパドゥアを建国した。"

#. TRANSLATORS: (Dione); An ally of Turnus, son of Telon and Sebethis.
#: data/nomenclature.fab:922
msgctxt "crater"
msgid "Oebalus"
msgstr "オエバルス"

#: data/nomenclature.fab:922
msgctxt "origin"
msgid "An ally of Turnus, son of Telon and Sebethis."
msgstr "テロンとセベティスの息子トゥルヌスの同盟者。"

#. TRANSLATORS: (Dione); Brother of Tiburtus and twin brother of Catillus. He
#. was founder of Tibur and an ally of Turnus against Aeneas.
#: data/nomenclature.fab:924
msgctxt "crater"
msgid "Coras"
msgstr "コラス"

#: data/nomenclature.fab:924
msgctxt "origin"
msgid ""
"Brother of Tiburtus and twin brother of Catillus. He was founder of Tibur "
"and an ally of Turnus against Aeneas."
msgstr "ティブルトゥスの兄弟でカティルウスの双子の兄弟。彼はティブルの創設者で、アエネアスに対するトゥルヌスの同盟者だった。"

#. TRANSLATORS: (Dione); A Trojan defending Aeneas’ camp against the
#. Rutulians, killed by Turnus.
#: data/nomenclature.fab:926
msgctxt "crater"
msgid "Alcander"
msgstr "アルカンデル"

#: data/nomenclature.fab:926
msgctxt "origin"
msgid ""
"A Trojan defending Aeneas’ camp against the Rutulians, killed by Turnus."
msgstr "ルトゥリア人の攻撃からアエネアスの野営地を守るトロイ人。トゥルヌスによって殺された。"

#. TRANSLATORS: (Dione); Early king of Troy, son of Tros, brother of Ilus and
#. Ganymede.
#: data/nomenclature.fab:928
msgctxt "crater"
msgid "Assaracus"
msgstr "アッサラクス"

#: data/nomenclature.fab:928
msgctxt "origin"
msgid "Early king of Troy, son of Tros, brother of Ilus and Ganymede."
msgstr "トロイの初期の王、トロスの息子、イルスとガニメデの兄弟。"

#. TRANSLATORS: (Dione); A Rutulian with the troops besieging the camp of
#. Aeneas.
#: data/nomenclature.fab:930
msgctxt "crater"
msgid "Lamyrus"
msgstr "ラミルス"

#: data/nomenclature.fab:930
msgctxt "origin"
msgid "A Rutulian with the troops besieging the camp of Aeneas."
msgstr "アエネアスの野営地を包囲する軍隊を率いたルトゥリア人。"

#. TRANSLATORS: (Dione); A famous boxer who had been defeated by Dares.
#. TRANSLATORS: (Phoebe); Argonaut, son of Teleon, bee-master.
#: data/nomenclature.fab:932 data/nomenclature.fab:26602
msgctxt "crater"
msgid "Butes"
msgstr "ブテス"

#: data/nomenclature.fab:932
msgctxt "origin"
msgid "A famous boxer who had been defeated by Dares."
msgstr "ダレスに敗れた有名なボクサー。"

#. TRANSLATORS: (Dione); An old Italian killed in the first fighting between
#. Latins and Trojans while trying to make peace.
#: data/nomenclature.fab:934
msgctxt "crater"
msgid "Galaesus"
msgstr "ガラエスス"

#: data/nomenclature.fab:934
msgctxt "origin"
msgid ""
"An old Italian killed in the first fighting between Latins and Trojans while"
" trying to make peace."
msgstr "和平を結ぼうとしていた間にラテン人とトロイ人との最初の戦闘で死亡したイタリア人の老人。"

#. TRANSLATORS: (Dione); There are two persons in the Aeneid with this name:
#. (a) a Rutulian from a group attacking the Trojan’s camp in the absence of
#. Aeneas, and (b) an Italian whose son, priest of Apollo and Diana, was a
#. soldier of Turnus.
#: data/nomenclature.fab:936 data/nomenclature.fab:940
msgctxt "crater"
msgid "Haemon"
msgstr "ハエモン"

#: data/nomenclature.fab:936 data/nomenclature.fab:940
msgctxt "origin"
msgid ""
"There are two persons in the Aeneid with this name: (a) a Rutulian from a "
"group attacking the Trojan’s camp in the absence of Aeneas, and (b) an "
"Italian whose son, priest of Apollo and Diana, was a soldier of Turnus."
msgstr ""
"アエネアス側にはこの名前を持つ人物が2人いる。 (a) アエネアスの不在中にトロイ側の野営地を攻撃するグループにいるルトゥリア人。(b) "
"イタリア人で、その息子はアポロとディアナの司祭でトゥルヌスの兵士だった。"

#. TRANSLATORS: (Dione); Daughter of Priam; first wife of Aeneas.
#: data/nomenclature.fab:938
msgctxt "crater"
msgid "Creusa"
msgstr "クレウサ"

#: data/nomenclature.fab:938
msgctxt "origin"
msgid "Daughter of Priam; first wife of Aeneas."
msgstr "プリアスの娘; アエネアスの最初の妻。"

#. TRANSLATORS: (Dione); There are two persons in the Aeneid with this name:
#. (a) father of Palinurus, and (b) father of Iapyx.
#: data/nomenclature.fab:942
msgctxt "crater"
msgid "Iasus"
msgstr "イアスス"

#: data/nomenclature.fab:942
msgctxt "origin"
msgid ""
"There are two persons in the Aeneid with this name: (a) father of Palinurus,"
" and (b) father of Iapyx."
msgstr "アエネイスにはこの名前を持つ人物が二人登場する: (a) パリヌルスの父。(b) イアピクスの父。"

#. TRANSLATORS: (Dione); A Trojan, companion of Aeneas.
#: data/nomenclature.fab:944
msgctxt "crater"
msgid "Phorbas"
msgstr "フォルバス"

#: data/nomenclature.fab:944
msgctxt "origin"
msgid "A Trojan, companion of Aeneas."
msgstr "アエネアスの仲間のトロイ人。"

#. TRANSLATORS: (Dione); There are two persons in the Aeneid with this name:
#. (a) a companion of Aeneas and a contestant in the foot race, and (b) a
#. Rutulian.
#: data/nomenclature.fab:946
msgctxt "crater"
msgid "Salius"
msgstr "サリウス"

#: data/nomenclature.fab:946
msgctxt "origin"
msgid ""
"There are two persons in the Aeneid with this name: (a) a companion of "
"Aeneas and a contestant in the foot race, and (b) a Rutulian."
msgstr "アエネアス側にはこの名前を持つ人物が2人いる。(a) アエネアスの仲間で徒競走の出場者。(b) ルトゥリア人。"

#. TRANSLATORS: (Dione); A nurse of Aeneas.
#: data/nomenclature.fab:948
msgctxt "crater"
msgid "Caieta"
msgstr "カイエタ"

#: data/nomenclature.fab:948
msgctxt "origin"
msgid "A nurse of Aeneas."
msgstr "アエネアスの乳母。"

#. TRANSLATORS: (Dione); Daughter of Priam; she could foretell the future.
#: data/nomenclature.fab:950
msgctxt "crater"
msgid "Cassandra"
msgstr "カッサンドラ"

#: data/nomenclature.fab:950
msgctxt "origin"
msgid "Daughter of Priam; she could foretell the future."
msgstr "プリアモスの娘; 未来を予言することができた。"

#. TRANSLATORS: (Dione); There are two persons in the Aeneid with this name:
#. (a) a Rutulian in the troop of Volcens, and (b) an Italian whose sons
#. fought for Turnus.
#: data/nomenclature.fab:952
msgctxt "crater"
msgid "Sulmo"
msgstr "スルモ"

#: data/nomenclature.fab:952
msgctxt "origin"
msgid ""
"There are two persons in the Aeneid with this name: (a) a Rutulian in the "
"troop of Volcens, and (b) an Italian whose sons fought for Turnus."
msgstr ""
"アエネアス側にはこの名前を持つ人物が2人いる。(a) ヴォルセン軍のルトゥリア人。(b) トゥルヌスのために戦った息子たちがいるイタリア人。"

#. TRANSLATORS: (Dione); Brother of Tiburtus and twin brother of Coras.
#: data/nomenclature.fab:954
msgctxt "crater"
msgid "Catillus"
msgstr "カティルウス"

#: data/nomenclature.fab:954
msgctxt "origin"
msgid "Brother of Tiburtus and twin brother of Coras."
msgstr "ティブルトゥスの弟で、コラスの双子の弟。"

#. TRANSLATORS: (Dione); Ruler of the Teleboans on Capri; father of Oebalus.
#: data/nomenclature.fab:956
msgctxt "crater"
msgid "Telon"
msgstr "テロン"

#: data/nomenclature.fab:956
msgctxt "origin"
msgid "Ruler of the Teleboans on Capri; father of Oebalus."
msgstr "カプリ島のテレボア人の支配者; オエバルスの父親。"

#. TRANSLATORS: (Dione); A Latin, leader of cavalry sent as reinforcements to
#. Turnus.
#: data/nomenclature.fab:958
msgctxt "crater"
msgid "Volcens"
msgstr "ウォルケンス"

#: data/nomenclature.fab:958
msgctxt "origin"
msgid "A Latin, leader of cavalry sent as reinforcements to Turnus."
msgstr "トゥルヌスへの援軍として派遣されたラテン人の騎兵隊長。"

#. TRANSLATORS: (Dione); Son of Mezentius, killed by Aeneas.
#: data/nomenclature.fab:960
msgctxt "crater"
msgid "Lausus"
msgstr "ラウスス"

#: data/nomenclature.fab:960
msgctxt "origin"
msgid "Son of Mezentius, killed by Aeneas."
msgstr "メゼニティウスの息子、アエネアスに殺された。"

#. TRANSLATORS: (Dione); Tyrian princess who founded Carthage.
#: data/nomenclature.fab:962
msgctxt "crater"
msgid "Dido"
msgstr "ディド"

#: data/nomenclature.fab:962
msgctxt "origin"
msgid "Tyrian princess who founded Carthage."
msgstr "カルタゴを建国したティルスの王女。"

#. TRANSLATORS: (Dione); Also known as Rhea Silvia; Mother by Mars of Romulus
#. and Remus, the founders of Rome.
#: data/nomenclature.fab:964
msgctxt "crater"
msgid "Ilia"
msgstr "イリア"

#: data/nomenclature.fab:964
msgctxt "origin"
msgid ""
"Also known as Rhea Silvia; Mother by Mars of Romulus and Remus, the founders"
" of Rome."
msgstr "レア・シルウィアとも知られる; ロムルスとローマの建国者であるレムスの母 (父はマルス)。"

#. TRANSLATORS: (Dione); A Trojan defending Aeneas' camp against the Rutulian
#. attack. He was killed by Turnus.
#: data/nomenclature.fab:966
msgctxt "crater"
msgid "Halys"
msgstr "ハリス"

#: data/nomenclature.fab:966
msgctxt "origin"
msgid ""
"A Trojan defending Aeneas' camp against the Rutulian attack. He was killed "
"by Turnus."
msgstr "ルトゥリア人の攻撃からアエネアスの野営地を守るトロイ人。トゥルヌスによって殺された。"

#. TRANSLATORS: (Dione); Ancient hero, eponymous ancestor of the Italians.
#: data/nomenclature.fab:968
msgctxt "crater"
msgid "Italus"
msgstr "イタルス"

#: data/nomenclature.fab:968
msgctxt "origin"
msgid "Ancient hero, eponymous ancestor of the Italians."
msgstr "古代の英雄、イタリア人の祖先の名を冠した人物。"

#. TRANSLATORS: (Dione); Soldier of Aeneas.
#: data/nomenclature.fab:970
msgctxt "crater"
msgid "Latagus"
msgstr "ラタグス"

#: data/nomenclature.fab:970
msgctxt "origin"
msgid "Soldier of Aeneas."
msgstr "アエネアスの兵士。"

#. TRANSLATORS: (Dione); A soldier of Turnus, killed by Aeneas.
#: data/nomenclature.fab:972
msgctxt "crater"
msgid "Magus"
msgstr "マグス"

#: data/nomenclature.fab:972
msgctxt "origin"
msgid "A soldier of Turnus, killed by Aeneas."
msgstr "トゥルヌスの一兵士、アエネアスに殺された。"

#. TRANSLATORS: (Dione); An Etruscan ally of Aeneas.
#: data/nomenclature.fab:974
msgctxt "crater"
msgid "Massicus"
msgstr "マッシグス"

#: data/nomenclature.fab:974
msgctxt "origin"
msgid "An Etruscan ally of Aeneas."
msgstr "アエネアスと同盟するエトルリア人。"

#. TRANSLATORS: (Dione); Pilot of Aeneas' fleet.
#: data/nomenclature.fab:976
msgctxt "crater"
msgid "Palinurus"
msgstr "パリヌルス"

#: data/nomenclature.fab:976
msgctxt "origin"
msgid "Pilot of Aeneas' fleet."
msgstr "アエネアスの艦隊の水先案内人。"

#. TRANSLATORS: (Dione); Mythical founder of Rome in 754 or 753 B.C., son of
#. Mars by Ilia (Rhea Silvia).
#: data/nomenclature.fab:978
msgctxt "crater"
msgid "Romulus"
msgstr "ロムルス"

#: data/nomenclature.fab:978
msgctxt "origin"
msgid ""
"Mythical founder of Rome in 754 or 753 B.C., son of Mars by Ilia (Rhea "
"Silvia)."
msgstr "紀元前754年または753年にローマを建国した神話上の人物、イリア (レア・シルウィア) とマルスの息子。"

#. TRANSLATORS: (Dione); He and his brother Romulus founded Rome.
#: data/nomenclature.fab:980
msgctxt "crater"
msgid "Remus"
msgstr "レムス"

#: data/nomenclature.fab:980
msgctxt "origin"
msgid "He and his brother Romulus founded Rome."
msgstr "彼は弟のロムルスとともにローマを建国した。"

#. TRANSLATORS: (Dione); A Trojan. He fought at the side of Aeneas during
#. Troy's last night.
#: data/nomenclature.fab:982
msgctxt "crater"
msgid "Ripheus"
msgstr "リフェウス"

#: data/nomenclature.fab:982
msgctxt "origin"
msgid "A Trojan. He fought at the side of Aeneas during Troy's last night."
msgstr "トロイ人、トロイ最後の夜にはアエネアス側で戦った。"

#. TRANSLATORS: (Dione); Fabled ancestor of the Sabines.
#: data/nomenclature.fab:984
msgctxt "crater"
msgid "Sabinus"
msgstr "サビヌス"

#: data/nomenclature.fab:984
msgctxt "origin"
msgid "Fabled ancestor of the Sabines."
msgstr "伝説的なサビニ人の祖先。"

#. TRANSLATORS: (Dione); Rutililan king; Aeneas' rival for hand of Lavinia.
#: data/nomenclature.fab:986
msgctxt "crater"
msgid "Turnus"
msgstr "トゥルヌス"

#: data/nomenclature.fab:986
msgctxt "origin"
msgid "Rutililan king; Aeneas' rival for hand of Lavinia."
msgstr "ルティリアの王; ラウィニアの婚約を巡るアエネアスのライバル。"

#. TRANSLATORS: (Dione); A Lydian river said to carry gold dust after King
#. Midas washed off his golden touch in its waters.
#: data/nomenclature.fab:988
msgctxt "catena"
msgid "Pactolus Catena"
msgstr "パクトルス連鎖クレーター"

#: data/nomenclature.fab:988
msgctxt "origin"
msgid ""
"A Lydian river said to carry gold dust after King Midas washed off his "
"golden touch in its waters."
msgstr "ミダス王がその水で黄金の感触を洗い流した後、砂金が流れ込んだと言われているリディアの川。"

#. TRANSLATORS: (Dione); River of Sicily.
#: data/nomenclature.fab:990
msgctxt "catena"
msgid "Pantagias Catenae"
msgstr "パンタギアス連鎖クレーター"

#: data/nomenclature.fab:990
msgctxt "origin"
msgid "River of Sicily."
msgstr "シシリアを流れる川。"

#. TRANSLATORS: (Dione); River in the Apulian territory of Diomedes, now
#. called the Ofanto.
#: data/nomenclature.fab:992
msgctxt "catena"
msgid "Aufidus Catena"
msgstr "アウフィドゥス連鎖クレーター"

#: data/nomenclature.fab:992
msgctxt "origin"
msgid "River in the Apulian territory of Diomedes, now called the Ofanto."
msgstr "プーリア州ディオメデス地域にある川、現在はオファント川と呼ばれる。"

#. TRANSLATORS: (Dione); City in northern Italy founded by Antenor.
#: data/nomenclature.fab:994
msgctxt "chasma"
msgid "Padua Chasmata"
msgstr "パドゥア・カズマ地形"

#: data/nomenclature.fab:994
msgctxt "origin"
msgid "City in northern Italy founded by Antenor."
msgstr "アンテノルが建設した北イタリアの都市。"

#. TRANSLATORS: (Dione); An old town in Campania.
#: data/nomenclature.fab:996
msgctxt "chasma"
msgid "Aurunca Chasmata"
msgstr "アウルンカ・カズマ地形"

#: data/nomenclature.fab:996
msgctxt "origin"
msgid "An old town in Campania."
msgstr "カンパニアの古い町。"

#. TRANSLATORS: (Dione); Coastal town of Sicily where Aeneas found a safe
#. harbor during a raging storm, and where Anchises died.
#: data/nomenclature.fab:998
msgctxt "chasma"
msgid "Drepanum Chasma"
msgstr "ドレパヌム・カズマ地形"

#: data/nomenclature.fab:998
msgctxt "origin"
msgid ""
"Coastal town of Sicily where Aeneas found a safe harbor during a raging "
"storm, and where Anchises died."
msgstr "シシリー沿岸沿いの町。アエネアスが激しい嵐の中で安全な港を見つけ、アンキセスが亡くなった地。"

#. TRANSLATORS: (Dione); The river on which Sparta stood.
#: data/nomenclature.fab:1000 data/nomenclature.fab:1002
msgctxt "chasma"
msgid "Eurotas Chasmata"
msgstr "エウロタス・カズマ地形"

#: data/nomenclature.fab:1000 data/nomenclature.fab:1002
msgctxt "origin"
msgid "The river on which Sparta stood."
msgstr "スパルタが立地していた川。"

#. TRANSLATORS: (Dione); A town in Thessaly, Achilles' native region.
#: data/nomenclature.fab:1004
msgctxt "chasma"
msgid "Larissa Chasma"
msgstr "ラリッサ・カズマ地形"

#: data/nomenclature.fab:1004
msgctxt "origin"
msgid "A town in Thessaly, Achilles' native region."
msgstr "アキレスの故郷であるテッサリア地方の町。"

#. TRANSLATORS: (Dione); The Trojans' promised land in Italy.
#: data/nomenclature.fab:1006
msgctxt "chasma"
msgid "Latium Chasma"
msgstr "ラティウム・カズマ地形"

#: data/nomenclature.fab:1006
msgctxt "origin"
msgid "The Trojans' promised land in Italy."
msgstr "イタリア内でトロイに約束された土地。"

#. TRANSLATORS: (Dione); One of the Seven Hills of Rome.
#: data/nomenclature.fab:1008
msgctxt "chasma"
msgid "Palatine Chasmata"
msgstr "パラティネ・カズマ地形"

#: data/nomenclature.fab:1008
msgctxt "origin"
msgid "One of the Seven Hills of Rome."
msgstr "ローマの七丘のうちのひとつ。"

#. TRANSLATORS: (Dione); Ancient town of Italy (modern name Tivoli) not far
#. from Rome on the river Anio.
#: data/nomenclature.fab:1010
msgctxt "chasma"
msgid "Tibur Chasmata"
msgstr "ティブル・カズマ地形"

#: data/nomenclature.fab:1010
msgctxt "origin"
msgid ""
"Ancient town of Italy (modern name Tivoli) not far from Rome on the river "
"Anio."
msgstr "ローマから遠くないアニオ川沿いにあるイタリアの古代都市 (現在の名称はティヴォリ) 。"

#. TRANSLATORS: (Dione); Hill across the Tiber river from Rome.
#: data/nomenclature.fab:1012
msgctxt "dorsum"
msgid "Janiculum Dorsa"
msgstr "ヤニクルム尾根"

#: data/nomenclature.fab:1012
msgctxt "origin"
msgid "Hill across the Tiber river from Rome."
msgstr "ローマからティベル川を渡った丘。"

#. TRANSLATORS: (Dione); Town in Apulia (now Puglia, southern Italy) founded
#. after the Trojan war by Diomedes.
#: data/nomenclature.fab:1014 data/nomenclature.fab:1028
msgctxt "fossa"
msgid "Arpi Fossae"
msgstr "アルピ地溝帯"

#: data/nomenclature.fab:1014 data/nomenclature.fab:1028
msgctxt "origin"
msgid ""
"Town in Apulia (now Puglia, southern Italy) founded after the Trojan war by "
"Diomedes."
msgstr "アプリア (現在のイタリア南部プーリア州) の町。トロイ戦争後にディオメデスによって設立された。"

#. TRANSLATORS: (Dione); One of the twelve chief cities of Etruria, situated
#. on the river Clanis.
#: data/nomenclature.fab:1016
msgctxt "fossa"
msgid "Clusium Fossae"
msgstr "クルシウム地溝帯"

#: data/nomenclature.fab:1016
msgctxt "origin"
msgid ""
"One of the twelve chief cities of Etruria, situated on the river Clanis."
msgstr "クラニス川沿いに位置するエトルリアの12の主要都市の1つ。"

#. TRANSLATORS: (Dione); Town in Latium near Rome.
#: data/nomenclature.fab:1018
msgctxt "fossa"
msgid "Fidena Fossae"
msgstr "フィデナ地溝帯"

#: data/nomenclature.fab:1018
msgctxt "origin"
msgid "Town in Latium near Rome."
msgstr "ローマ近郊ラティウムの町。"

#. TRANSLATORS: (Dione); Town of Lucania in southern Italy, founded by
#. Philoctetes.
#: data/nomenclature.fab:1020
msgctxt "fossa"
msgid "Petelia Fossae"
msgstr "ペテリア地溝帯"

#: data/nomenclature.fab:1020
msgctxt "origin"
msgid "Town of Lucania in southern Italy, founded by Philoctetes."
msgstr "イタリア南部ルカニア地方の町、フィロクテテスが創設した。"

#. TRANSLATORS: (Dione); A river in southeastern Sicily with wide marshes near
#. its mouth.
#: data/nomenclature.fab:1022
msgctxt "fossa"
msgid "Helorus Fossa"
msgstr "ヘロルス地溝帯"

#: data/nomenclature.fab:1022
msgctxt "origin"
msgid "A river in southeastern Sicily with wide marshes near its mouth."
msgstr "シチリア島南東部の川、河口近くに広い沼地がある。"

#. TRANSLATORS: (Dione); A river of the Sabines, affluent of the Tiber.
#: data/nomenclature.fab:1024
msgctxt "fossa"
msgid "Himella Fossa"
msgstr "ヒメッラ地溝帯"

#: data/nomenclature.fab:1024
msgctxt "origin"
msgid "A river of the Sabines, affluent of the Tiber."
msgstr "サビニ人の川、テヴェレ川の支流。"

#. TRANSLATORS: (Dione); A district of Rome near the Forum.
#: data/nomenclature.fab:1026
msgctxt "fossa"
msgid "Argiletum Fossae"
msgstr "アルギレトゥム地溝帯"

#: data/nomenclature.fab:1026
msgctxt "origin"
msgid "A district of Rome near the Forum."
msgstr "フォルム (公共広場) に近いローマの一地区。"

#. TRANSLATORS: (Dione); A Punic (Phoenician) city in North Africa.
#: data/nomenclature.fab:1030
msgctxt "fossa"
msgid "Carthage Fossae"
msgstr "カルタゴ地溝帯"

#: data/nomenclature.fab:1030
msgctxt "origin"
msgid "A Punic (Phoenician) city in North Africa."
msgstr "北アフリカ、プニック (フェニキア人) の都市。"

#. TRANSLATORS: (Donaldjohanson); Narmada River Valley (India), site of
#. Narmada Human, fossil remains of an indeterminate hominin species, the
#. oldest found in India (50,000 – 150,000 BCE).
#: data/nomenclature.fab:1032
msgctxt "crater"
msgid "Narmada"
msgstr "ナルマダ"

#: data/nomenclature.fab:1032
msgctxt "origin"
msgid ""
"Narmada River Valley (India), site of Narmada Human, fossil remains of an "
"indeterminate hominin species, the oldest found in India (50,000 – 150,000 "
"BCE)."
msgstr ""
"ナルマダ川峡谷 (インド) 。インドで最古の、未確定な人類種のナルマダ人 (紀元前 50,000 - 150,000 年) の化石が同所で見つかった。"

#. TRANSLATORS: (Donaldjohanson); Lake Mungo (New South Wales, Australia) is
#. the site of three significant finds of human including Mungo woman, one of
#. the earliest known cremations.
#: data/nomenclature.fab:1034
msgctxt "crater"
msgid "Mungo"
msgstr "マンゴ"

#: data/nomenclature.fab:1034
msgctxt "origin"
msgid ""
"Lake Mungo (New South Wales, Australia) is the site of three significant "
"finds of human including Mungo woman, one of the earliest known cremations."
msgstr ""
"マンゴ湖 (オーストラリア、ニューサウスウェールズ州) は、知られている最も古い火葬の 1 つであるマンゴ女性を含む 3 "
"つの重要な人類の骨が発見された場所です。"

#. TRANSLATORS: (Donaldjohanson); Windover Pond, a site in Florida, USA,
#. yielding remains of 168 individuals (including soft tissue) dating from
#. ~7300 years BP.
#: data/nomenclature.fab:1036
msgctxt "collum"
msgid "Windover Collum"
msgstr ""

#: data/nomenclature.fab:1036
msgctxt "origin"
msgid ""
"Windover Pond, a site in Florida, USA, yielding remains of 168 individuals "
"(including soft tissue) dating from ~7300 years BP."
msgstr "アメリカ合衆国フロリダ州のウィンドオーバー・ポンド遺跡から、約7300年前のものと思われる168体の遺骨 (軟組織を含む) が発見された。"

#. TRANSLATORS: (Donaldjohanson); Luzia Woman, a 11,500 year-old female
#. skeleton found at Lapa Vermelha in Brazil; named as an homage to the Lucy
#. fossil.
#: data/nomenclature.fab:1038
msgctxt "dorsum"
msgid "Luzia Dorsum"
msgstr "ルジア尾根"

#: data/nomenclature.fab:1038
msgctxt "origin"
msgid ""
"Luzia Woman, a 11,500 year-old female skeleton found at Lapa Vermelha in "
"Brazil; named as an homage to the Lucy fossil."
msgstr "ルジアは、ブラジルのラパ・ヴェルメーリャで発見された11,500年前の女性の骨。化石ルーシーに敬意を表して名付けられた。"

#. TRANSLATORS: (Donaldjohanson); Afar Triangle (Ethiopia), site of many
#. important fossil finds.
#: data/nomenclature.fab:1040
msgctxt "lobus"
msgid "Afar Lobus"
msgstr "アファール葉状地形"

#: data/nomenclature.fab:1040
msgctxt "origin"
msgid "Afar Triangle (Ethiopia), site of many important fossil finds."
msgstr "アファール三角地帯 (エチオピア) は多くの重要な化石が発見された場所。"

#. TRANSLATORS: (Donaldjohanson); Olduvai Gorge (Tanzania), a major
#. paleoanthropological site.
#: data/nomenclature.fab:1042
msgctxt "lobus"
msgid "Olduvai Lobus"
msgstr "オルドヴァイ葉状地形"

#: data/nomenclature.fab:1042
msgctxt "origin"
msgid "Olduvai Gorge (Tanzania), a major paleoanthropological site."
msgstr "オルドヴァイ渓谷 (タンザニア) は古人類学上重要な場所。"

#. TRANSLATORS: (Donaldjohanson); Hadar (Ethiopia), the paleontological fossil
#. site within the Afar Triangle where the Lucy fossil was discovered in 1974.
#: data/nomenclature.fab:1044
msgctxt "regio"
msgid "Hadar Regio"
msgstr "ハダル地域"

#: data/nomenclature.fab:1044
msgctxt "origin"
msgid ""
"Hadar (Ethiopia), the paleontological fossil site within the Afar Triangle "
"where the Lucy fossil was discovered in 1974."
msgstr "ハダル (エチオピア) はアファール三角地帯内の古生物学的化石の発掘現場で、1974 年にルーシーの化石が発見された。"

#. TRANSLATORS: (Donaldjohanson); Minatogawa limestone quarry (Okinawa, Japan)
#. where four skeletons of early Homo sapiens (20,000-22,000 BCE) were
#. excavated in 1968, 1970, and 1974.
#: data/nomenclature.fab:1046
msgctxt "regio"
msgid "Minatogawa Regio"
msgstr "ミナトガワ地域"

#: data/nomenclature.fab:1046
msgctxt "origin"
msgid ""
"Minatogawa limestone quarry (Okinawa, Japan) where four skeletons of early "
"Homo sapiens (20,000-22,000 BCE) were excavated in 1968, 1970, and 1974."
msgstr ""
"港川石灰岩採石場 (日本国沖縄県) では、1968年、1970年、1974年に初期ホモ・サピエンス (紀元前20,000年 -22,000年) "
"の骨格4体が出土した。"

#. TRANSLATORS: (Donaldjohanson); Cashel, town in County Laois, Ireland, near
#. which the preserved body of a young adult male, Cashel Man, was found in a
#. bog; one of the oldest known “bog bodies” in Europe and dates to ~2000 BCE.
#: data/nomenclature.fab:1048
msgctxt "saxum"
msgid "Cashel Saxum"
msgstr "カシェル岩塊"

#: data/nomenclature.fab:1048
msgctxt "origin"
msgid ""
"Cashel, town in County Laois, Ireland, near which the preserved body of a "
"young adult male, Cashel Man, was found in a bog; one of the oldest known "
"“bog bodies” in Europe and dates to ~2000 BCE."
msgstr ""
"カシェルはアイルランド、リーシュ県にある町。町の近くの湿原で発見された若い成人男性の遺体、カシェル人はヨーロッパで知られる最も古い「湿原遺体」の一つで、紀元前2000年頃のものとされる。"

#. TRANSLATORS: (Donaldjohanson); Boxgrove, village in England and site of
#. discovery of Homo heidelbergensis fossils and direct evidence of hunting
#. and butchering by early humans.
#: data/nomenclature.fab:1050
msgctxt "saxum"
msgid "Boxgrove Saxum"
msgstr "ボックスグローヴ岩塊"

