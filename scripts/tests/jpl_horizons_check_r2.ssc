// Description: Create data against JPL HORIZONS reference, revision 2 (adds the topocentric observer fields).
//

// THERE ARE FEW PLACES IN THIS SCRIPT WHERE YOU HAVE TO SELECT BETWEEN JD(UT) AND JD(TT)
// ALSO YOU HAVE TO MANUALLY SET THE JD_START AND JD_END CONSTANT FURTHER DOWN IN THE CODE

// SELECT ONE OF THESE!
// For a run in UT
var myDeltaTAlgorithm="JPLHorizons";
// For a run in TT
//var myDeltaTAlgorithm="WithoutCorrection";

// SET THIS TO "p" OR "p2" OR "p3" OR "p4" DEPENDING ON WHICH VECTOR YOU'RE CAPTURING
var vectorTag = "p3";

// Number of independent samples to capture per object (for majority-vote
// cross-checking against staleness/render-lag artifacts)
var numSamples = 1;

// (SS) 2026-11-12 r2: SET THIS TO true FOR A TOPOCENTRIC OBSERVER (the location of Stellarium, e.g. Palomar Mountain, as the Horizons site) AND TO false FOR A
// GEOCENTRIC OBSERVER. With false the script does exactly what revision 1 did (same columns, same file names). With true the data lines get these columns
// after the ten columns of revision 1, taken from the information of the selected object:
//   LT(s)      light time in seconds (Horizons 1-way_down_LT is in minutes)
//   GMST       Greenwich mean sidereal time,     hh mm ss.ffffffff   (GMST 1982 with UT1 when the JPL Horizons site is active)
//   GAST       Greenwich apparent sidereal time, hh mm ss.ffffffff
//   LAST(pm)   local apparent sidereal time with polar motion, hh mm ss.ffffffff ("n.a." when the JPL Horizons site is not active)
//   HA         local apparent hour angle, west positive, -12h..+12h, sHH MM SS.ffffff
//   Az, El     airless (geometric) azimuth from North through East and elevation, degrees (no refraction, whatever the atmosphere flag says)
//   GalLon, GalLat, SGalLon, SGalLat   galactic and supergalactic longitude and latitude, degrees
//   Distance   AU (Horizons delta)
var topocentric = true;

// SELECT ONE OF THESE SOLAR BODY OBJECTS TO SET objNames
// Sun, Moon, Mercury, Venus, Mars, Jupiter, Saturn, Uranus, Neptune, Pluto
var objNames = ["Mercury"];

function format_D_HMS(num){
	num=num % 360;
	if (num<0) num+= 360;
	hrs=num/15;
	H=Math.floor(hrs);
	mins=(hrs-H) * 60;
	M=Math.floor(mins);
	secs=(mins-M) * 60;
	return ("00"+H).slice(-2) + " " + ("00"+M).slice(-2) + " " + ("00.000"+secs.toFixed(6)).slice(-9);
}

// (SS) 2026-11-12 r2: angle in degrees shown as hours, minutes and seconds of time with 'dec' decimals of the second (rounding carried properly)
function format_HMS_prec(deg, dec){
	deg = deg % 360;
	if (deg < 0) deg += 360;
	var scale = Math.pow(10, dec);
	var units = Math.round(deg / 15 * 3600 * scale);
	var perDay = 86400 * scale;
	if (units >= perDay) units -= perDay;
	var h = Math.floor(units / (3600 * scale));
	units -= h * 3600 * scale;
	var m = Math.floor(units / (60 * scale));
	units -= m * 60 * scale;
	var s = units / scale;
	return ("00" + h).slice(-2) + " " + ("00" + m).slice(-2) + " " + ("00" + s.toFixed(dec)).slice(-(3 + dec));
}

// (SS) 2026-11-12 r2: hour angle in degrees, any range, shown as sHH MM SS.fff between -12h and +12h
function format_HA_prec(deg, dec){
	deg = deg % 360;
	if (deg > 180) deg -= 360;
	if (deg < -180) deg += 360;
	return (deg < 0 ? "-" : "+") + format_HMS_prec(Math.abs(deg), dec);
}

// (SS) 2026-11-12 r2: number, or "n.a." when the key is missing from the object information
function num_or_na(x, dec){
	return (typeof x === "number") ? x.toFixed(dec) : "n.a.";
}

function hms_or_na(x, dec){
	return (typeof x === "number") ? format_HMS_prec(x, dec) : "n.a.";
}

function ha_or_na(x, dec){
	return (typeof x === "number") ? format_HA_prec(x, dec) : "n.a.";
}

function format_D_DMS(num){
	if (num<0) { S="-" } else {S="+"};
	num=Math.abs(num);
	D=Math.floor(num);
	mins=(num-D) * 60;
	M=Math.floor(mins);
	secs=(mins-M) * 60;
	return S + ("00"+D).slice(-2) + " " + ("00"+M).slice(-2) + " " + ("00.000"+secs.toFixed(5)).slice(-8);
}

function format_E_DMS(num){
	if (num<0) { S="-" } else {S="+"};
	num=Math.abs(num);
	D=Math.floor(num);
	mins=(num-D) * 60;
	M=Math.floor(mins);
	secs=(mins-M) * 60;
	return S + ("000"+D).slice(-3) + " " + ("00"+M).slice(-2) + " " + ("00.000"+secs.toFixed(5)).slice(-8);
}

function parseStelDate(s) {
    var m = s.match(/^([+-]?\d+)-(\d{2})-(\d{2})T(\d{2}):(\d{2}):(\d+(?:\.\d+)?)$/);
    if (!m) {
        core.output("parseStelDate: failed to parse \"" + s + "\"");
        return null;
    }
    return {
        y:  parseInt(m[1], 10),
        mo: parseInt(m[2], 10),
        d:  parseInt(m[3], 10),
        h:  parseInt(m[4], 10),
        mi: parseInt(m[5], 10),
        s:  parseFloat(m[6])
    };
}

function formatStelDate(dt) {
    return dt.y + "-" + pad2(dt.mo) + "-" + pad2(dt.d) + "T" +
           pad2(dt.h) + ":" + pad2(dt.mi) + ":" + pad2(dt.s.toFixed(0));
}

function pad2(n) { return (n < 10 ? "0" : "") + n; }

function getStableSelectedObjectInfo(jd, maxTries, requiredMatches) {
	var prev = null, matchCount = 0;
	for (var i = 0; i < maxTries; i++) {
		core.wait(0.1);
		var cur = core.getSelectedObjectInfo();
		if (prev !== null
		    && cur.raJ2000 === prev.raJ2000 && cur.decJ2000 === prev.decJ2000
		    && cur.ra === prev.ra && cur.dec === prev.dec) {
			matchCount++;
			if (matchCount >= requiredMatches - 1) return cur;
		} else {
			matchCount = 0;
		}
		prev = cur;
	}
	core.output("WARNING: object info did not stabilize after " + maxTries + " tries at jd=" + jd);
	return prev;
}

function onePlanetC(planet, jd){
	core.setJDay(jd);
	//core.wait(1.0);
	//map=core.getSelectedObjectInfo();
	map = getStableSelectedObjectInfo(jd, 15, 4);

    // SELECT ONE OF THESE!
	DeltaT = core.getDeltaTsec(); // Use DeltaT if JD(UT) is selected. Values in seconds, not a formatted string!
	//DeltaT = 0.0; // Force DeltaT to 0.0 if computing for JD(TT)

	var line = jd.toString()
			 + "  " + DeltaT.toFixed(6)
			 + "  " + format_D_HMS(map.raJ2000)
			 + "  " + format_D_DMS(map.decJ2000)
			 + "  " + format_D_HMS(map.ra)
			 + "  " + format_D_DMS(map.dec)
			 + "  " + format_E_DMS(map.elongJ2000)
			 + "  " + format_D_DMS(map.elatJ2000)
			 + "  " + format_E_DMS(map.elong)
			 + "  " + format_D_DMS(map.elat);
	if (topocentric) {
		// (SS) 2026-11-12 r2: fields of the topocentric observer (see the description of the switch 'topocentric' at the top of the script)
		line += "  " + num_or_na(map["light-time-s"], 9)
		      + "  " + hms_or_na(map["meanSidTm-dd"], 8)
		      + "  " + hms_or_na(map["appSidTm-dd"], 8)
		      + "  " + hms_or_na(map["lastSidTm-dd"], 8)
		      + "  " + ha_or_na(map["hourAngle-dd"], 6)
		      + "  " + num_or_na(map["azimuth-geometric"], 9)
		      + "  " + num_or_na(map["altitude-geometric"], 9)
		      + "  " + num_or_na(map.glong, 9) + "  " + num_or_na(map.glat, 9)
		      + "  " + num_or_na(map.sglong, 9) + "  " + num_or_na(map.sglat, 9)
		      + "  " + num_or_na(map.distance, 14);
	}
	core.output(line);
	return true; // needed for successful "every"
}

// RECONFIGURE
var keepPlanetocentric=core.isPlanetocentricCalculations();
var keepDeltaTAlgoName=core.getDeltaTAlgorithm();
var keepTimeRate=core.getTimeRate();

// (SS) 2026-11-12 r2: planetocentric calculations (no observer offset, geocentric) for revision 1, topocentric coordinates of the location for the topocentric observer
core.setPlanetocentricCalculations(!topocentric);
core.setDeltaTAlgorithm(myDeltaTAlgorithm);
core.setTimeRate(0.0); // Stop Time running

// LOOP THREE TIMES TO CREATE THREE (ALMOST) IDENTICAL DATA SETS OF DATA PER px-vectors
// THESE THREE DATA SET WILL BE PRE-ANALYZED/COMBINED TO OBTAIN A FINAL SET FREE OF STALE ENTRIES
for (var sample = 1; sample <= numSamples; sample++) {

	objNames.forEach(function(name) {

		core.resetOutput();
	    core.output("Now processing: " + name + " (sample " + sample + " of " + numSamples + ")");
			if (topocentric) {
				core.output("Topocentric observer: " + JSON.stringify(core.getObserverLocationInfo()) + "  (planetocentric calculations flag = " + core.isPlanetocentricCalculations() + ")");
			}

		// SELECT ONE OF THESE!
		var header = "  JD(UT)" + "      DeltaT(sec)" + "     RA(J2000)" + "        Dec(J2000)" + "     RA(on date)" + "        Dec(on date)" + "    Elong(J2000)" + "      Elat(J2000)" + "    Elong(on date)" + "    Elat(on date)";
			if (topocentric) {
				header += "    LT(s)" + "        GMST" + "        GAST" + "        LAST(pm)" + "      HA" + "      Az(deg)" + "     El(deg)" + "     GalLon" + "     GalLat" + "     SGalLon" + "    SGalLat" + "    Distance(AU)";
			}
			core.output(header);
		//core.output("  JD(TT)" + "   DeltaT(sec)" + "   RA(J2000)" + "        Dec(J2000)" + "     RA(on date)" + "        Dec(on date)" + "    Elong(J2000)" + "      Elat(J2000)" + "     Elong(on date)" + "    Elat(on date)");

		core.selectObjectByName(name, true);

		// SET YOUR INTERVAL IN YEARS, MONTHS OR DAYS TO MATCH YOUR JPL HORIZONS APP SETTINGS
		var yearStep  = 1;
		var monthStep = 3;
		var dayStep   = 1;

		// SET YOUR START AND END JD VALUES HERE !
		// LIMIT THE OVERALL INTERVAL IF YOU CAPTURE EVERY DAY !!!! 2298883.5
		var startJD = -1930633.5; // JD = -1930633.5 for b9999-Mar-20 00:00:00.000 (or -9998-03-20T00:00:00)
		var endJD   =  5373472.5; // JD =  5373472.5 for  9999-Dec-20 00:00:00.000 (or  9999-12-20T00:00:00)

		core.setTimeRate(0);
		core.setJDay(startJD);

		// SELECT THIS SECTION IF INCREMENTING YEARLY OR MONTHLY, COMMENT IT OUT IF INCREMENTING DAILY
		while (core.getJDay() <= endJD) {
	    	var jd = core.getJDay();
			var dt = parseStelDate(core.getDate("utc"));
	    	if (dt === null) break;

	    	onePlanetC(name, jd);

	    	// SELECT THIS LINE IF INCREMENTING YEARLY !
			dt.y += yearStep;

			// SELECT THESE THREE LINES OF CODE IF INCREMENTING MONTHLY !
			//dt.mo += monthStep;
	    	//while (dt.mo > 12) { dt.mo -= 12; ++dt.y; }
	    	//while (dt.mo < 1)  { dt.mo += 12; --dt.y; }

	    	core.setDate(formatStelDate(dt), "utc", false);
		}

		// SELECT THIS SECTION IF INCREMENTING DAYLY, COMMENT IT OUT IF INCREMENTING MONTHLY OF YEARLY
		//var JD = core.getJDay();
		//for (i = 0; i <= (endJD - startJD); i += dayStep)
		//{
			//onePlanetC(name, JD);
			//JD = JD + dayStep;
		//}

		core.saveOutputAs(name + "_" + vectorTag + (topocentric ? "_topo" : "") + "_s" + sample + ".txt");
	});

}

// RESTORE
core.setPlanetocentricCalculations(keepPlanetocentric);
core.setDeltaTAlgorithm(keepDeltaTAlgoName);
